<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <!-- Disables WebDAVModule so DELETE, PUT, and OPTIONS requests pass directly to ASP.NET Core -->
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <!-- Remove WebDAV handler so IIS does not intercept DELETE requests -->
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Use standard dotnet executable for IIS AspNetCoreModule -->
      <aspNetCore processPath="dotnet" arguments=".\GFI_Upgrated.ServiceApi.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <httpErrors errorMode="Detailed" />
    </system.webServer>
  </location>
</configuration>
