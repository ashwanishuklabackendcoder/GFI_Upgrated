@page "/store/bom"
@page "/admin/bom"
@page "/store/w_masterbomitemslist"
@page "/admin/w_masterbomitemslist"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppSessionState SessionState
@inject IJSRuntime JS

<PageTitle>Recipe (BOM)</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Recipes (BOM)</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OnAddNew" Disabled="!_canInsert">
            Create New Recipe
        </MudButton>
    </MudStack>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudTextField T="string" Value="@_search" ValueChanged="@OnSearchTextChanged" Placeholder="Search by Recipe name or Product..." Variant="Variant.Outlined" Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" OnClearButtonClick="OnSearch" />
        </MudItem>
        <MudItem xs="12" md="3">
            <SearchableSelect T="int?" Value="@_itemTypeId" ValueChanged="OnItemTypeFilterChanged" Label="Product Type" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Clearable="true" Items="_productTypes" />
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center">
            
        </MudItem>
    </MudGrid>

    <MudTable RowsPerPage="25" T="BomDto" @ref="_table" ServerData="LoadServerDataAsync" Hover="true" Dense="true" Striped="true" Bordered="true" Loading="_loading">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="BomName" T="BomDto">Recipe Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="ItemName" T="BomDto">Parent Product</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: right;"><MudTableSortLabel SortLabel="Quantity" T="BomDto">Yield Qty</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="UnitId" T="BomDto">Unit</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: right;"><MudTableSortLabel SortLabel="ExtraExpensesPerPiece" T="BomDto">Extra Expenses</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: center;"><MudTableSortLabel SortLabel="IsActive" T="BomDto">Status</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: center; width: 120px;">Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Recipe Name">@context.BomName</MudTd>
            <MudTd DataLabel="Parent">@context.ItemName</MudTd>
            <MudTd DataLabel="Yield" Style="text-align: right;">@context.Quantity</MudTd>
            <MudTd DataLabel="Unit">@context.UnitName</MudTd>
            <MudTd DataLabel="Expenses" Style="text-align: right;">@context.ExtraExpensesPerPiece.ToString("N2")</MudTd>
            <MudTd DataLabel="Status" Style="text-align: center;">
                <MudSwitch T="bool" Value="@context.IsActive" ValueChanged="@((bool val) => ToggleStatusAsync(context, val))" Color="Color.Success" UnCheckedColor="Color.Error" Disabled="!_canUpdate" />
            </MudTd>
            <MudTd DataLabel="Action" Style="text-align: center;">
                <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OnEdit(context.BomId))" Disabled="!_canUpdate" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnDelete(context))" Disabled="!_canDelete" />
                </MudStack>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
        <NoRecordsContent>
            <MudText Class="pa-4">No Recipes found matching your criteria.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private async Task OnSearchTextChanged(string text)
    {
        _search = text;
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task OnItemTypeFilterChanged(int? typeId)
    {
        _itemTypeId = typeId;
        if (_table is not null) await _table.ReloadServerData();
    }

    private MudTable<BomDto>? _table;
    private string _search = "";
    private static readonly List<SearchableSelect<int?>.SelectItemDto<int?>> _productTypes = new()
    {
        new() { Value = null, Text = "All Types" },
        new() { Value = 1, Text = "Finished Products" },
        new() { Value = 2, Text = "Semi-Finished" }
    };

    private int? _itemTypeId;
    private bool _loading;
    private bool _canInsert;
    private bool _canUpdate;
    private bool _canDelete;

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var path = "store/bom";
        var perms = SessionState.GetPermissions(path);
        
        if (SessionState.IsAdmin)
        {
            _canInsert = _canUpdate = _canDelete = true;
        }
        else
        {
            _canInsert = perms.IsInsert;
            _canUpdate = perms.IsUpdate;
            _canDelete = perms.IsDelete;
        }
    }

    private async Task<TableData<BomDto>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var result = await ApiClient.GetBomsAsync(new BomListRequest
            {
                SearchTerm = _search,
                ItemTypeId = _itemTypeId,
                PageNumber = state.Page + 1,
                PageSize = 100000,
                SortColumn = state.SortLabel,
                SortType = state.SortDirection == SortDirection.Descending ? "DESC" : "ASC"
            }, cancellationToken);


            var itemsList = result.Items.ToList();
            if (!string.IsNullOrWhiteSpace(_search))
            {
                itemsList = itemsList.FilterAllColumns(_search).ToList();
            }

            return new TableData<BomDto>
            {
                TotalItems = itemsList.Count,
                Items = itemsList.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray()
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading Recipes: {ex.Message}", Severity.Error);
            return new TableData<BomDto> { Items = Array.Empty<BomDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch()
    {
        if (_table != null) await _table.ReloadServerData();
    }

    private void OnAddNew() => Navigation.NavigateTo("/store/bom/new");

    private void OnEdit(long id) => Navigation.NavigateTo($"/store/bom/edit/{id}");

    private async Task OnDelete(BomDto item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete Recipe '{item.BomName}'?");
        if (!confirmed) return;

        try
        {
            var success = await ApiClient.DeleteBomAsync(item.BomId, SessionState.CurrentUserAuditName ?? "System");
            if (success)
            {
                Snackbar.Add("Recipe deleted successfully.", Severity.Success);
                await OnSearch();
            }
            else
            {
                Snackbar.Add("Cannot delete Recipe because it is currently linked to production entries or other records.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting Recipe: {ex.Message}", Severity.Error);
        }
    }

    private async Task ToggleStatusAsync(BomDto item, bool val)
    {
        try
        {
            var success = await ApiClient.ToggleBomStatusAsync(item.BomId, val, SessionState.CurrentUserAuditName ?? "System");
            if (success)
            {
                item.IsActive = val;
                Snackbar.Add("BOM status updated successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to update BOM status.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating BOM status: {ex.Message}", Severity.Error);
        }
    }
}

