@page "/store/production/view/{Id:long}"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject AdminSecurityApiClient AdminApiClient
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject IJSRuntime JS

<PageTitle>Finished Product Details - Run #@Id</PageTitle>

<MudPaper Class="pa-4 mb-4 d-print-none">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Finished Product Details</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Production Run #@Id</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="OnPrint">Print Report</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="@(() => NavigationManager.NavigateTo($"/store/production/items/{Id}"))">Manage Ingredients</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnBack">Back</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_header == null)
{
    <MudAlert Severity="Severity.Error">Production record not found.</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 pb-2 border-bottom">
            <MudStack Spacing="0">
                <MudText Typo="Typo.caption" Color="Color.Secondary">PRODUCT / SKU PRODUCED</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight: 600;">@_header.SkuName</MudText>
            </MudStack>
            <div>
                @if (_header.IsComplete == 1)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Medium" Icon="@Icons.Material.Filled.CheckCircle">Status: Complete</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Medium" Icon="@Icons.Material.Filled.HourglassEmpty">Status: Incomplete</MudChip>
                }
            </div>
        </MudStack>

        <MudGrid Class="mt-2">
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Recipe / BOM Name</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@_bomName (@SessionState.FormatNumber(_header.BomQty))</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Batch Number</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@(string.IsNullOrWhiteSpace(_header.BatchNo) ? "-" : _header.BatchNo)</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Cooking Date</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@(string.IsNullOrWhiteSpace(_header.CookingDate) ? "-" : SessionState.FormatDate(_header.CookingDate))</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Expiry Date</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@(string.IsNullOrWhiteSpace(_header.ExpiryDate) ? "-" : SessionState.FormatDate(_header.ExpiryDate))</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Filled Date</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@(string.IsNullOrWhiteSpace(_header.FilledDate) ? "-" : SessionState.FormatDate(_header.FilledDate))</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Packed Country</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@(string.IsNullOrWhiteSpace(_header.PackedCountryName) ? (string.IsNullOrWhiteSpace(_header.PackedCountry) ? "-" : _header.PackedCountry) : _header.PackedCountryName)</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Warehouse Location</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@(string.IsNullOrWhiteSpace(_warehouseName) ? "-" : _warehouseName)</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Kettle / Run</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@_kettleName @(_header.KettleRun > 0 ? $" (Run #{_header.KettleRun})" : "")</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Quantity Produced</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@_header.FillingBottles @_header.FillingUnitName @(_header.ExtraBottles > 0 ? $" (+{_header.ExtraBottles} extra)" : "")</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Colli / Pallet Number</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">Colli: @(string.IsNullOrWhiteSpace(_header.Colli) ? "-" : _header.Colli) | Pallet: @(string.IsNullOrWhiteSpace(_header.PalletNumber) ? "-" : _header.PalletNumber)</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Process Employees</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@(string.IsNullOrWhiteSpace(_employeeNames) ? "-" : _employeeNames)</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Total Ingredient Cost</MudText>
                <MudText Typo="Typo.body1" Color="Color.Success" Style="font-weight: 600;">@SessionState.FormatCurrency(_items.Sum(x => x.Amount))</MudText>
            </MudItem>

            @if (!string.IsNullOrWhiteSpace(_header.Remarks))
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Remarks / Notes</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight: 500;">@_header.Remarks</MudText>
                </MudItem>
            }

            @if (!string.IsNullOrWhiteSpace(_header.CreatedBy))
            {
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Created By</MudText>
                    <MudText Typo="Typo.body2">@_header.CreatedBy</MudText>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6" Color="Color.Primary">Ingredient Consumption & Stock Used</MudText>
            @if (_isDraftPreview)
            {
                <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Info">Draft / Auto-Allocated Recipe Ingredients</MudChip>
            }
        </MudStack>

        @if (_isDraftPreview)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Variant="Variant.Outlined" Dense="true">
                <b>Draft Preview:</b> These ingredients are calculated based on BOM recipe requirements and available batch stock because consumption has not been finalized yet.
            </MudAlert>
        }

        <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Ingredient Name</MudTh>
                <MudTh>Lot / Batch No</MudTh>
                <MudTh>Supplier / Stock Source</MudTh>
                <MudTh Style="text-align: right;">Quantity Used</MudTh>
                <MudTh Style="text-align: right;">Amount (SRD)</MudTh>
                <MudTh>Remarks / Description</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">@(context.TransactionDate?.ToString(SessionState.DatePickerFormat) ?? "N/A")</MudTd>
                <MudTd DataLabel="Ingredient Name"><b>@context.ItemName</b></MudTd>
                <MudTd DataLabel="Lot / Batch No">@context.BatchNo</MudTd>
                <MudTd DataLabel="Supplier / Stock Source">
                    @if (context.StockById == 3)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Opening Stock</MudChip>
                    }
                    else if (context.StockById == 2 || context.StockById == 4)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">PreProcessing</MudChip>
                    }
                    else if (!string.IsNullOrWhiteSpace(context.SupplierName))
                    {
                        @context.SupplierName
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </MudTd>
                <MudTd DataLabel="Quantity Used" Style="text-align: right;"><b>@SessionState.FormatNumber(context.Quantity)</b> @context.UnitName</MudTd>
                <MudTd DataLabel="Amount" Style="text-align: right;">@SessionState.FormatNumber(context.Amount)</MudTd>
                <MudTd DataLabel="Remarks / Description">@(string.IsNullOrWhiteSpace(context.Description) ? "-" : context.Description)</MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd ColumnSpan="4" Style="text-align: right; font-weight: bold;">Total:</MudTd>
                <MudTd Style="text-align: right; font-weight: bold;">@SessionState.FormatNumber(_items.Sum(x => x.Quantity))</MudTd>
                <MudTd Style="text-align: right; font-weight: bold; color: var(--mud-palette-success);">@SessionState.FormatCurrency(_items.Sum(x => x.Amount))</MudTd>
                <MudTd></MudTd>
            </FooterContent>
            <NoRecordsContent>
                <MudText Class="pa-4" Color="Color.Secondary">No ingredients recorded for this production run.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }
    
    private bool _loading = true;
    private bool _isDraftPreview = false;
    private ProductionDto? _header;
    private List<PreProcessingItemDto> _items = new();
    private string _bomName = string.Empty;
    private string _warehouseName = string.Empty;
    private string _kettleName = string.Empty;
    private string _employeeNames = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
            _header = await ApiClient.GetProductionByIdAsync(Id);
            if (_header != null)
            {
                var boms = await ApiClient.GetBomsLookupAsync();
                var whs = await ApiClient.GetWarehousesLookupAsync();
                
                _bomName = boms.FirstOrDefault(b => b.BomId == _header.BomId)?.BomName ?? "Unknown";
                _warehouseName = whs.FirstOrDefault(w => w.WarehouseId == _header.WarehouseId)?.WarehouseName ?? "Unknown";
                _kettleName = _header.KettleNumber ?? "Unknown";

                try
                {
                    var activeStaff = await AdminApiClient.GetActiveStaffAsync();
                    if (!string.IsNullOrWhiteSpace(_header.ProcessEmployees))
                    {
                        var ids = _header.ProcessEmployees.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim());
                        var names = activeStaff.Where(s => ids.Contains(s.StaffId.ToString())).Select(s => s.StaffName);
                        _employeeNames = names.Any() ? string.Join(", ", names) : _header.ProcessEmployees;
                    }
                }
                catch
                {
                    _employeeNames = _header.ProcessEmployees ?? string.Empty;
                }

                var itemsResult = await ApiClient.GetProductionItemsAsync(Id);
                _items = itemsResult.ToList();

                // If no saved items exist in DB, fallback to auto-suggesting draft BOM recipe ingredients
                if (!_items.Any() && _header.BomId > 0)
                {
                    _isDraftPreview = true;
                    try
                    {
                        var bomItems = await ApiClient.GetBomItemsAsync(_header.BomId);
                        var allRawMaterials = await ApiClient.GetItemsForBomLookupAsync(null);

                        foreach (var recipe in bomItems)
                        {
                            double neededQty = recipe.Quantity * _header.BomQty;
                            var batches = (await ApiClient.GetAvailableBatchesAsync(recipe.ItemID)).ToList();

                            double remainingNeeded = neededQty;
                            var raw = allRawMaterials.FirstOrDefault(x => x.ItemId == recipe.ItemID);
                            string defaultUnitName = raw?.UnitName ?? "";

                            if (batches.Any(b => b.FinalQuantityLeft > 0))
                            {
                                foreach (var batch in batches.Where(b => b.FinalQuantityLeft > 0))
                                {
                                    if (remainingNeeded <= 0) break;

                                    double allocated = Math.Min(remainingNeeded, batch.FinalQuantityLeft);
                                    if (allocated <= 0 && remainingNeeded > 0)
                                    {
                                        allocated = remainingNeeded;
                                    }

                                    _items.Add(new PreProcessingItemDto
                                    {
                                        ItemID = recipe.ItemID,
                                        ItemName = recipe.ItemName,
                                        ItemStockByBatchId = batch.ItemStockByBatchId,
                                        BatchNo = batch.BatchNo,
                                        Quantity = allocated,
                                        UnitName = !string.IsNullOrWhiteSpace(batch.UnitName) ? batch.UnitName : defaultUnitName,
                                        Amount = 0,
                                        Description = "Draft / Auto-suggested from BOM"
                                    });

                                    remainingNeeded -= allocated;
                                }

                                if (remainingNeeded > 0)
                                {
                                    _items.Add(new PreProcessingItemDto
                                    {
                                        ItemID = recipe.ItemID,
                                        ItemName = recipe.ItemName,
                                        BatchNo = "Unallocated",
                                        Quantity = remainingNeeded,
                                        UnitName = defaultUnitName,
                                        Amount = 0,
                                        Description = "Draft / Insufficient batch stock"
                                    });
                                }
                            }
                            else
                            {
                                _items.Add(new PreProcessingItemDto
                                {
                                    ItemID = recipe.ItemID,
                                    ItemName = recipe.ItemName,
                                    BatchNo = "No Stock Available",
                                    Quantity = neededQty,
                                    UnitName = defaultUnitName,
                                    Amount = 0,
                                    Description = "Draft / No stock available"
                                });
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Error loading draft BOM ingredients: {ex.Message}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading production data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPrint()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task OnBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
