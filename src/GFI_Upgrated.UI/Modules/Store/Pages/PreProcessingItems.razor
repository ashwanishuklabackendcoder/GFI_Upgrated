@page "/store/preprocessing/items/{HeaderId:long}"
@page "/admin/preprocessing/items/{HeaderId:long}"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppSessionState SessionState
@inject IJSRuntime JS

<PageTitle>Manage Ingredients</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Ingredient Consumption</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Record raw materials used for Production Run #@HeaderId</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => Navigation.NavigateTo($"/store/preprocessing/edit/{HeaderId}"))">
                Edit Header
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnBack">
                Back
            </MudButton>
        </MudStack>
    </MudStack>

    @if (_header != null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <b>Produced:</b> @_header.ItemName | <b>Qty Made:</b> @_header.QuantityMade.ToString("0.####") @_header.UnitName | <b>BOM:</b> @_header.BomName (@_header.BomQty.ToString("0.####"))
        </MudAlert>
    }

    @if (_hasMissingStock)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <b>Warning:</b> One or more required ingredients do not have sufficient stock. Please review the list and adjust quantities/batches manually.
        </MudAlert>
    }

    <MudTable Items="_rows" Hover="true" Dense="true" Bordered="true" Striped="true" Class="mb-4" Elevation="0">
        <HeaderContent>
            <MudTh style="width: 30%;">Ingredient</MudTh>
            <MudTh Style="width: 380px;">Lot / Batch Number</MudTh>
            <MudTh Style="width: 120px;">Recipe Qty</MudTh>
            <MudTh Style="width: 150px;">Qty Used</MudTh>
            <MudTh>Description / Remarks</MudTh>
            @if (_header?.IsComplete == 0)
            {
                <MudTh Style="width: 100px; text-align: center;">Action</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Ingredient">
                <SearchableSelect T="RawMaterialDto" Value="@(_allRawMaterials.FirstOrDefault(x => x.ItemId == context.ItemID))" ValueChanged="@(async (RawMaterialDto val) => await OnItemIdChanged(context, val?.ItemId ?? 0))" Variant="Variant.Outlined" Dense="true" Disabled="@(_header?.IsComplete != 0)" Items="@GetIngredientSelects()" />
            </MudTd>
            <MudTd DataLabel="Lot / Batch Number">
                @if (_header?.IsComplete != 0 || (context.ItemStockUsedID > 0 && !context.AvailableBatches.Any(x => x.ItemStockByBatchId == context.ItemStockByBatchId)))
                {
                    <MudText Typo="Typo.body2">@context.BatchNo</MudText>
                }
                else
                {
                    <SearchableSelect T="AvailableBatchDto" Value="@(context.AvailableBatches.FirstOrDefault(x => x.ItemStockByBatchId == context.ItemStockByBatchId))" ValueChanged="@((AvailableBatchDto val) => OnBatchChanged(context, val))" Variant="Variant.Outlined" Dense="true" Disabled="@(context.ItemID == 0 || _header?.IsComplete != 0)" Items="@GetBatchSelects(context)" />
                }
            </MudTd>
            <MudTd DataLabel="Recipe Qty">
                @if (context.RecipeQty > 0)
                {
                    <MudText Typo="Typo.body2">@context.RecipeQty.ToString("0.####")</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Manual</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Qty Used">
                <MudNumericField @bind-Value="context.Quantity" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Min="0.0001" Format="0.####" HideSpinButtons="true" Disabled="@(_header?.IsComplete != 0)" />
            </MudTd>
            <MudTd DataLabel="Description / Remarks">
                <MudTextField @bind-Value="context.Description" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Disabled="@(_header?.IsComplete != 0)" />
            </MudTd>
            @if (_header?.IsComplete == 0)
            {
                <MudTd Style="text-align: center;">
                    <MudStack Row="true" Spacing="1" Justify="Justify.Center">
                        <MudTooltip Text="Split Line">
                            <MudIconButton Icon="@Icons.Material.Filled.CallSplit" Color="Color.Info" Size="Size.Small" OnClick="@(() => OnSplitLine(context))" Disabled="@(context.ItemID == 0 || _saving)" />
                        </MudTooltip>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnDeleteRow(context))" Disabled="_saving" />
                        </MudTooltip>
                    </MudStack>
                </MudTd>
            }
        </RowTemplate>
    </MudTable>

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-4">
        @if (_header?.IsComplete == 0)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OnAddCustomLine" Disabled="_saving">
                Add Custom Ingredient
            </MudButton>
        }
        else
        {
            <div></div>
        }

        <MudStack Row="true" Spacing="2">
            @if (_header?.IsComplete == 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveConsumptionAsync" Disabled="_saving" StartIcon="@Icons.Material.Filled.Save">
                    @(_saving ? "Saving..." : "Save Consumption")
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="OnFinalizeAsync" Disabled="@(_rows.Count == 0 || _saving || _finalizing)" StartIcon="@Icons.Material.Filled.DoneAll">
                    @(_finalizing ? "Finalizing..." : "Finalize & Update Stock")
                </MudButton>
            }
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public long HeaderId { get; set; }

    private PreProcessingDto? _header;
    private List<PreProcessingItemDto> _savedItems = new();
    private List<BomItemDetailDto> _bomItems = new();
    private List<RawMaterialDto> _allRawMaterials = new();
    private List<ConsumptionRow> _rows = new();

    private bool _saving;
    private bool _finalizing;
    private bool _hasMissingStock;

    private sealed class ConsumptionRow
    {
        public long ItemStockUsedID { get; set; }
        public long ItemID { get; set; }
        public string? ItemName { get; set; }
        public long ItemStockByBatchId { get; set; }
        public string? BatchNo { get; set; }
        public double Quantity { get; set; }
        public double RecipeQty { get; set; }
        public string? Description { get; set; }
        public long UnitId { get; set; }
        public List<AvailableBatchDto> AvailableBatches { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var unitsResult = await ApiClient.GetUnitsAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _units = unitsResult.Items.Where(x => x.IsActive).ToList();

            _header = await ApiClient.GetPreProcessingByIdAsync(HeaderId);
            if (_header == null) { Snackbar.Add("Header not found.", Severity.Error); OnBack(); return; }

            _bomItems = (await ApiClient.GetBomItemsAsync(_header.BomId)).ToList();
            _savedItems = (await ApiClient.GetPreProcessingItemsAsync(HeaderId)).ToList();
            _allRawMaterials = (await ApiClient.GetItemsForBomLookupAsync(null)).Where(x => x.ItemTypeId == 2 || x.ItemTypeId == 3).ToList();

            _rows.Clear();
            _hasMissingStock = false;

            if (_savedItems.Any())
            {
                // Load previously saved items
                foreach (var saved in _savedItems)
                {
                    double qty = saved.Quantity;
                    long unitId = 0;
                    var raw = _allRawMaterials.FirstOrDefault(x => x.ItemId == saved.ItemID);
                    if (raw != null)
                    {
                        unitId = saved.UnitId > 0 ? saved.UnitId : raw.PurchaseUnit;
                        if (unitId != raw.PurchaseUnit)
                        {
                            var selectedUnit = _units.FirstOrDefault(u => u.UnitId == unitId);
                            if (selectedUnit != null && selectedUnit.ConversionValue.HasValue && selectedUnit.ConversionValue.Value > 0)
                            {
                                qty = saved.Quantity * selectedUnit.ConversionValue.Value;
                            }
                        }
                    }

                    var row = new ConsumptionRow
                    {
                        ItemStockUsedID = saved.ItemStockUsedID,
                        ItemID = saved.ItemID,
                        ItemName = saved.ItemName,
                        ItemStockByBatchId = saved.ItemStockByBatchId,
                        BatchNo = saved.BatchNo,
                        Quantity = qty,
                        UnitId = unitId,
                        Description = saved.Description
                    };

                    // Match matching recipe item if exists to show reference recipe qty
                    var matchRecipe = _bomItems.FirstOrDefault(b => b.ItemID == saved.ItemID);
                    if (matchRecipe != null)
                    {
                        row.RecipeQty = matchRecipe.Quantity * (_header.BomQty);
                    }

                    row.AvailableBatches = (await ApiClient.GetAvailableBatchesAsync(saved.ItemID)).ToList();
                    _rows.Add(row);
                }
            }
            else
            {
                // Auto-suggest and allocate recipe items
                foreach (var recipe in _bomItems)
                {
                    double neededQty = recipe.Quantity * (_header.BomQty);
                    var batches = (await ApiClient.GetAvailableBatchesAsync(recipe.ItemID)).ToList();

                    double remainingNeeded = neededQty;

                    if (batches.Any(b => b.FinalQuantityLeft > 0))
                    {
                        foreach (var batch in batches.Where(b => b.FinalQuantityLeft > 0))
                        {
                            if (remainingNeeded <= 0 && _rows.Any(r => r.ItemID == recipe.ItemID))
                            {
                                break;
                            }

                            double allocated = Math.Min(remainingNeeded, batch.FinalQuantityLeft);
                            if (allocated <= 0 && remainingNeeded > 0)
                            {
                                // Fallback to allocate the remaining needed amount even if no stock left
                                allocated = remainingNeeded;
                            }

                            var row = new ConsumptionRow
                            {
                                ItemID = recipe.ItemID,
                                ItemName = recipe.ItemName,
                                ItemStockByBatchId = batch.ItemStockByBatchId,
                                BatchNo = batch.BatchNo,
                                Quantity = allocated,
                                RecipeQty = neededQty,
                                AvailableBatches = batches
                            };
                            var raw = _allRawMaterials.FirstOrDefault(x => x.ItemId == recipe.ItemID);
                            if (raw != null)
                            {
                                row.UnitId = raw.PurchaseUnit;
                            }
                            _rows.Add(row);

                            remainingNeeded -= allocated;
                            if (remainingNeeded <= 0) break;
                        }

                        // If there is still remainder needed, add an extra row with the remainder
                        if (remainingNeeded > 0)
                        {
                            _hasMissingStock = true;
                            var row = new ConsumptionRow
                            {
                                ItemID = recipe.ItemID,
                                ItemName = recipe.ItemName,
                                Quantity = 0,
                                RecipeQty = neededQty,
                                AvailableBatches = batches
                            };
                            var raw = _allRawMaterials.FirstOrDefault(x => x.ItemId == recipe.ItemID);
                            if (raw != null)
                            {
                                row.UnitId = raw.PurchaseUnit;
                            }
                            _rows.Add(row);
                        }
                    }
                    else
                    {
                        _hasMissingStock = true;
                        // No batches available, add a single row with needed qty and empty batch selection
                        var row = new ConsumptionRow
                        {
                            ItemID = recipe.ItemID,
                            ItemName = recipe.ItemName,
                            Quantity = 0,
                            RecipeQty = neededQty,
                            AvailableBatches = batches
                        };
                        var raw = _allRawMaterials.FirstOrDefault(x => x.ItemId == recipe.ItemID);
                        if (raw != null)
                        {
                            row.UnitId = raw.PurchaseUnit;
                        }
                        _rows.Add(row);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OnItemChanged(ConsumptionRow row, RawMaterialDto? item)
    {
        if (item == null)
        {
            row.ItemID = 0;
            row.ItemName = null;
            row.ItemStockByBatchId = 0;
            row.BatchNo = null;
            row.UnitId = 0;
            row.AvailableBatches.Clear();
            return;
        }

        row.ItemID = item.ItemId;
        row.ItemName = item.ItemName;
        row.ItemStockByBatchId = 0;
        row.BatchNo = null;
        row.UnitId = item.PurchaseUnit;
        row.AvailableBatches.Clear();

        try
        {
            row.AvailableBatches = (await ApiClient.GetAvailableBatchesAsync(item.ItemId)).ToList();
            if (!row.AvailableBatches.Any())
            {
                Snackbar.Add($"No stock found for ingredient '{item.ItemName}'. Please select another ingredient.", Severity.Warning);
            }
            var firstBatch = row.AvailableBatches.FirstOrDefault(b => b.FinalQuantityLeft > 0) 
                             ?? row.AvailableBatches.FirstOrDefault();

            if (firstBatch != null)
            {
                row.ItemStockByBatchId = firstBatch.ItemStockByBatchId;
                row.BatchNo = firstBatch.BatchNo;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading batches: {ex.Message}", Severity.Error);
        }
    }

    private void OnBatchChanged(ConsumptionRow row, AvailableBatchDto? batch)
    {
        if (batch == null)
        {
            row.ItemStockByBatchId = 0;
            row.BatchNo = null;
            return;
        }
        row.ItemStockByBatchId = batch.ItemStockByBatchId;
        row.BatchNo = batch.BatchNo;

        var item = _allRawMaterials.FirstOrDefault(x => x.ItemId == row.ItemID);
        if (item != null)
        {
            row.UnitId = batch.UnitId > 0 ? batch.UnitId : item.PurchaseUnit;
        }
    }

    private void OnSplitLine(ConsumptionRow row)
    {
        var newRow = new ConsumptionRow
        {
            ItemID = row.ItemID,
            ItemName = row.ItemName,
            RecipeQty = row.RecipeQty,
            UnitId = row.UnitId,
            AvailableBatches = row.AvailableBatches
        };

        // Insert new row immediately after the split row
        var index = _rows.IndexOf(row);
        if (index >= 0)
        {
            _rows.Insert(index + 1, newRow);
        }
        else
        {
            _rows.Add(newRow);
        }
    }

    private void OnDeleteRow(ConsumptionRow row)
    {
        _rows.Remove(row);
    }

    private void OnAddCustomLine()
    {
        _rows.Add(new ConsumptionRow());
    }

    private async Task<bool> SaveConsumptionAsync()
    {
        if (!_rows.Any())
        {
            Snackbar.Add("Please add at least one material consumption row.", Severity.Warning);
            return false;
        }

        foreach (var row in _rows)
        {
            if (row.ItemID == 0)
            {
                Snackbar.Add("One or more rows do not have an ingredient selected.", Severity.Warning);
                return false;
            }
            if (row.ItemStockByBatchId == 0)
            {
                Snackbar.Add($"Please select a lot/batch number for '{row.ItemName}'.", Severity.Warning);
                return false;
            }
            if (row.Quantity <= 0)
            {
                Snackbar.Add($"Quantity for '{row.ItemName}' must be greater than 0.", Severity.Warning);
                return false;
            }

            var batch = row.AvailableBatches.FirstOrDefault(b => b.ItemStockByBatchId == row.ItemStockByBatchId);
            if (batch != null && row.Quantity > batch.FinalQuantityLeft)
            {
                Snackbar.Add($"Warning: Quantity for '{row.ItemName}' exceeds available batch stock ({batch.FinalQuantityLeft}).", Severity.Warning);
            }
        }

        _saving = true;
        try
        {
            // Clear existing saved items first to prevent duplicate entries
            foreach (var saved in _savedItems)
            {
                await ApiClient.DeletePreProcessingItemAsync(saved.ItemStockUsedID);
            }

            // Save all current rows
            foreach (var row in _rows)
            {
                double qty = row.Quantity;
                var rawMaterial = _allRawMaterials.FirstOrDefault(x => x.ItemId == row.ItemID);
                if (rawMaterial != null && row.UnitId > 0 && row.UnitId != rawMaterial.PurchaseUnit)
                {
                    var selectedUnit = _units.FirstOrDefault(u => u.UnitId == row.UnitId);
                    if (selectedUnit != null && selectedUnit.ConversionValue.HasValue && selectedUnit.ConversionValue.Value > 0)
                    {
                        qty = row.Quantity / selectedUnit.ConversionValue.Value;
                    }
                }

                var request = new SavePreProcessingItemRequest
                {
                    ItemStockUsedID = 0, // Always insert new rows to overwrite
                    UsedForId = HeaderId,
                    ItemID = row.ItemID,
                    ItemStockByBatchId = row.ItemStockByBatchId,
                    Quantity = qty,
                    Description = row.Description,
                    UsedFor = 2, // 2 = Pre-Processing
                    UpdatedBy = SessionState.CurrentUserAuditName ?? "System",
                    UnitId = row.UnitId
                };

                var result = await ApiClient.SavePreProcessingItemAsync(request);
                if (result <= 0)
                {
                    Snackbar.Add($"Failed to save consumption line for '{row.ItemName}'.", Severity.Error);
                    return false;
                }
            }

            Snackbar.Add("Material consumption saved successfully.", Severity.Success);
            await LoadDataAsync();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving consumption: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OnFinalizeAsync()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to finalize stock? If you finalize stock then you cannot edit and modify stock again.");

        if (!confirm) return;

        var saved = await SaveConsumptionAsync();
        if (!saved) return;

        _finalizing = true;
        try
        {
            var result = await ApiClient.FinalizePreProcessingStockAsync(HeaderId, SessionState.CurrentUserAuditName ?? "System");
            if (result > 0)
            {
                Snackbar.Add("Stock updated and production run finalized successfully.", Severity.Success);
                Navigation.NavigateTo("/store/preprocessing");
            }
            else
            {
                Snackbar.Add("Failed to finalize stock.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _finalizing = false;
        }
    }

    private void OnBack() => Navigation.NavigateTo("/store/preprocessing");

    private List<UnitDto> _units = new();

    private async Task OnItemIdChanged(ConsumptionRow row, long itemId)
    {
        var item = _allRawMaterials.FirstOrDefault(x => x.ItemId == itemId);
        await OnItemChanged(row, item);
    }

    private IEnumerable<SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>> GetIngredientSelects()
    {
        return _allRawMaterials.Select(x => new SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>
        {
            Value = x,
            Text = x.ItemName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<AvailableBatchDto>.SelectItemDto<AvailableBatchDto>> GetBatchSelects(ConsumptionRow row)
    {
        return row.AvailableBatches.Select(x => new SearchableSelect<AvailableBatchDto>.SelectItemDto<AvailableBatchDto>
        {
            Value = x,
            Text = $"{x.BatchNo} (Stock: {x.FinalQuantityLeft} {x.UnitName})"
        });
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetUnitsForIngredient(long itemId)
    {
        var item = _allRawMaterials.FirstOrDefault(x => x.ItemId == itemId);
        if (item == null) return _units.Select(x => new SearchableSelect<long>.SelectItemDto<long> { Value = x.UnitId, Text = x.UnitName ?? "" });
        var purchaseUnit = item.PurchaseUnit;
        var filtered = _units.Where(x => x.UnitId == purchaseUnit || x.BaseUnit == purchaseUnit);
        return filtered.Select(x => new SearchableSelect<long>.SelectItemDto<long> { Value = x.UnitId, Text = x.UnitName ?? "" });
    }
}
