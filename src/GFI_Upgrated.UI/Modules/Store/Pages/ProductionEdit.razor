@page "/store/production/new"
@page "/store/production/edit/{Id:long}"
@page "/admin/production/new"
@page "/admin/production/edit/{Id:long}"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.SharedDto.AdminSecurity
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject AdminSecurityApiClient SecurityApiClient
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject GFI_Upgrated.UI.State.AppSessionState SessionState

<PageTitle>@(_isEdit ? "Edit Production" : "New Production")</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@(_isEdit ? "Edit Finished Product Run" : "New Finished Product Run")</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            @if (_isEdit)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.ListAlt" OnClick="@(() => NavigationManager.NavigateTo($"/store/production/items/{Id}"))">Manage Ingredients</MudButton>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnCancel">Back</MudButton>
        </MudStack>
    </MudStack>

    <EditForm Model="_editor" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <MudGrid>
            <!-- BOM Details -->
            <MudItem xs="12" md="4">
                <SearchableSelect T="long" Label="Select BOM" Value="@_editor.BomId" ValueChanged="OnBomIdChanged" Variant="Variant.Outlined" Required="true" Items="@GetBomSelects()" />
                <ValidationMessage For="@(() => _editor.BomId)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="double" Value="_editor.BomQty" ValueChanged="@((double val) => OnBomQtyChanged(val))" Label="BOM Quantity" Variant="Variant.Outlined" Min="0" For="@(() => _editor.BomQty)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_editor.BatchNo" Label="Batch Number" Variant="Variant.Outlined" HelperText="Leave blank for auto-generation" />
            </MudItem>
           

            <!-- Dates -->
            <MudItem xs="12" md="4">
                <MudDatePicker DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Editable="true" Date="_editor.CookingDate" DateChanged="OnCookingDateChanged" Label="@($"Cooking Date ({SessionState.DateFormat})*")" Variant="Variant.Outlined" Required="true" For="@(() => _editor.CookingDate)" />
            </MudItem>
          
            <MudItem xs="12" md="4">
                <MudDatePicker DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Editable="true"                         @bind-Date="_editor.FilledDate" Label="@($"Filled Date ({SessionState.DateFormat})")" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Editable="true" @bind-Date="_editor.ExpiryDate" Label="@($"Expiry Date ({SessionState.DateFormat})")" Variant="Variant.Outlined" />
            </MudItem>


            <!-- Filling and Batch Info -->
            <MudItem xs="12" md="4">
                <SearchableSelect T="long" Label="SKU" Value="@_editor.SkuId" ValueChanged="@((long val) => { _editor.SkuId = val; })" Variant="Variant.Outlined" Items="@GetSkuSelects()" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_editor.FillingBottles" Label="Filled Bottles" Variant="Variant.Outlined" Min="0" />
            </MudItem>
            
            <MudItem xs="12" md="4" Style="display:none;">
                <SearchableSelect T="long" Label="Filling Bottle Unit" Value="@_editor.FillingPerBottleUnit" ValueChanged="@((long val) => { _editor.FillingPerBottleUnit = val; })" Variant="Variant.Outlined" Items="@GetUnitSelects()" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_editor.ExtraBottles" Label="Extra Bottles" Variant="Variant.Outlined" Min="0.0" Step="0.1" />
            </MudItem>

            <MudItem xs="12" md="6">
                <SearchableSelect T="string" Label="Packed Country" Value="@_editor.PackedCountry" ValueChanged="@((string val) => { _editor.PackedCountry = val; })" Variant="Variant.Outlined" Items="@GetCountrySelects()" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SearchableSelect T="long" Label="Warehouse" Value="@_editor.WarehouseId" ValueChanged="@((long val) => { _editor.WarehouseId = val; })" Variant="Variant.Outlined" Required="true" Items="@GetWarehouseSelects()" />
                <ValidationMessage For="@(() => _editor.WarehouseId)" />
            </MudItem>

            <!-- Employees Multi-Select -->
            <MudItem xs="12" md="6">
                <SearchableSelect T="string" Label="Process Employees" MultiSelection="true" SelectedValues="@_selectedEmployees" SelectedValuesChanged="@((vals) => { _selectedEmployees = vals; })" MultiSelectionTextFunc="@(x => string.Join(", ", x.Select(idStr => _staffList.FirstOrDefault(s => s.StaffId.ToString() == idStr)?.StaffName ?? idStr)))" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Items="@GetEmployeeSelects()" />
            </MudItem>
          
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_editor.Remarks" Label="Remarks" Variant="Variant.Outlined" Lines="2" />
            </MudItem>

            <MudItem xs="12" Class="pt-4">
                <MudStack Row="true" Spacing="2">
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="_processing">
                        @(_processing ? "Saving..." : (_isEdit ? "Update Details" : "Create Production & Add Materials"))
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="OnCancel" Disabled="_processing">Cancel</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public long? Id { get; set; }
    [SupplyParameterFromQuery(Name = "copyFromId")] public long? CopyFromId { get; set; }
    private bool _isEdit => Id.HasValue && Id.Value > 0;
    private SaveProductionRequest _editor = new() { CookingDate = DateTime.Today, ExpiryDate = DateTime.Today.AddYears(1) };
    
    private List<BomLookupDto> _boms = new();
    private List<SkuLookupDto> _skus = new();
    private List<KettleLookupDto> _kettles = new();
    private List<UnitLookupDto> _units = new();
    private List<CountryLookupDto> _countries = new();
    private List<WarehouseLookupDto> _warehouses = new();
    private List<StaffLookupDto> _staffList = new();
    
    private IReadOnlyCollection<string> _selectedEmployees { get; set; } = new HashSet<string>();
    private IReadOnlyCollection<string> _selectedKettles { get; set; } = new HashSet<string>();
    private bool _processing;
    private long? _selectedBomUnitId;
    private double _selectedBomYield = 1.0;


    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadLookupsAsync();

        if (_isEdit)
        {
            var selected = await ApiClient.GetProductionByIdAsync(Id!.Value);
            if (selected is not null)
            {
                _editor.ProductionId = selected.ProductionId;
                _editor.BomId = selected.BomId;
                _editor.BomQty = selected.BomQty;
                _editor.CookingDate = DateTime.TryParse(selected.CookingDate, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var cd) ? cd : DateTime.Today;
                _editor.ExpiryDate = DateTime.TryParse(selected.ExpiryDate, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var ed) ? ed : DateTime.Today.AddYears(1);
                _editor.FilledDate = DateTime.TryParse(selected.FilledDate, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var fd) ? fd : null;
                _editor.PackedCountry = selected.PackedCountry;
                _editor.Colli = selected.Colli;
                _editor.PalletNumber = selected.PalletNumber;
                _editor.KettleId = selected.KettleId;
                if (!string.IsNullOrWhiteSpace(selected.KettleId))
                {
                    _selectedKettles = selected.KettleId.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
                }
                _editor.KettleRun = selected.KettleRun;
                _editor.BatchNo = selected.BatchNo;
                _editor.SkuId = selected.SkuId;
                _editor.DocumentUpload = selected.DocumentUpload;
                _editor.FillingBottles = selected.FillingBottles;
                _editor.FillingPerBottleUnit = selected.FillingPerBottleUnit;
                _editor.ExtraBottles = selected.ExtraBottles;
                _editor.WarehouseId = selected.WarehouseId;
                _editor.Remarks = selected.Remarks;
                _editor.ProcessEmployees = selected.ProcessEmployees;

                var bomDetails = await ApiClient.GetBomByIdAsync(selected.BomId);
                if (bomDetails != null)
                {
                    _selectedBomUnitId = bomDetails.UnitId;
                    _selectedBomYield = bomDetails.Quantity;
                }

                if (!string.IsNullOrWhiteSpace(selected.ProcessEmployees))
                {
                    _selectedEmployees = selected.ProcessEmployees.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
                }
            }
        }
        else if (CopyFromId.HasValue)
        {
            var selected = await ApiClient.GetProductionByIdAsync(CopyFromId.Value);
            if (selected is not null)
            {
                _editor.BomId = selected.BomId;
                _editor.BomQty = selected.BomQty;
                _editor.CookingDate = DateTime.Today;
                _editor.ExpiryDate = DateTime.TryParse(selected.ExpiryDate, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var ed) ? ed : DateTime.Today.AddYears(1);
                _editor.PackedCountry = selected.PackedCountry;
                _editor.Colli = selected.Colli;
                _editor.PalletNumber = selected.PalletNumber;
                _editor.KettleId = selected.KettleId;
                if (!string.IsNullOrWhiteSpace(selected.KettleId))
                {
                    _selectedKettles = selected.KettleId.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
                }
                _editor.KettleRun = selected.KettleRun;
                _editor.SkuId = selected.SkuId;
                _editor.DocumentUpload = selected.DocumentUpload;
                _editor.FillingBottles = selected.FillingBottles;
                _editor.FillingPerBottleUnit = selected.FillingPerBottleUnit;
                _editor.ExtraBottles = selected.ExtraBottles;
                _editor.WarehouseId = selected.WarehouseId;
                _editor.Remarks = selected.Remarks;
                _editor.ProcessEmployees = selected.ProcessEmployees;

                var bomDetails = await ApiClient.GetBomByIdAsync(selected.BomId);
                if (bomDetails != null)
                {
                    _selectedBomUnitId = bomDetails.UnitId;
                    _selectedBomYield = bomDetails.Quantity;
                }

                if (!string.IsNullOrWhiteSpace(selected.ProcessEmployees))
                {
                    _selectedEmployees = selected.ProcessEmployees.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
                }
            }
        }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var bomsTask = ApiClient.GetBomsLookupAsync();
            var skusTask = ApiClient.GetSkusLookupAsync();
            var kettlesTask = ApiClient.GetKettlesLookupAsync();
            var unitsTask = ApiClient.GetUnitsLookupAsync();
            var countriesTask = ApiClient.GetCountriesLookupAsync();
            var whTask = ApiClient.GetWarehousesLookupAsync();
            var staffTask = SecurityApiClient.GetActiveStaffAsync();

            await Task.WhenAll(bomsTask, skusTask, kettlesTask, unitsTask, countriesTask, whTask, staffTask);

            _boms = (await bomsTask).Where(b => b.ItemTypeId == (long)MasterItemType.FinishedProduct || b.ItemTypeId == (long)MasterItemType.SemiFinished).ToList();
            _skus = (await skusTask).ToList();
            _kettles = (await kettlesTask).ToList();
            _units = (await unitsTask).ToList();
            if (_editor.BomId > 0)
            {
                var bomDetails = await ApiClient.GetBomByIdAsync(_editor.BomId);
                if (bomDetails != null)
                {
                    _selectedBomUnitId = bomDetails.UnitId;
                }
            }
            _countries = (await countriesTask).ToList();
            _warehouses = (await whTask).ToList();
            _staffList = (await staffTask).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        if (_editor.BomId == 0) { Snackbar.Add("Please select a BOM.", Severity.Warning); return; }
        if (_editor.WarehouseId == 0) { Snackbar.Add("Please select an Output Warehouse.", Severity.Warning); return; }

        _processing = true;
        try
        {
            _editor.ProcessEmployees = string.Join(",", _selectedEmployees);
            _editor.KettleId = string.Join(",", _selectedKettles);
            _editor.UpdatedBy = SessionState.CurrentUserAuditName ?? "System";

            var result = await ApiClient.SaveProductionAsync(_editor);
            if (result > 0)
            {
                if (!_isEdit && CopyFromId.HasValue)
                {
                    // Copy ingredients from the source production run
                    var sourceItems = await ApiClient.GetProductionItemsAsync(CopyFromId.Value);
                    foreach (var item in sourceItems)
                    {
                        var request = new SavePreProcessingItemRequest
                        {
                            ItemStockUsedID = 0,
                            UsedForId = result,
                            ItemID = item.ItemID,
                            ItemStockByBatchId = item.ItemStockByBatchId,
                            Quantity = item.Quantity,
                            Description = item.Description,
                            UsedFor = 3, // 3 = Production
                            UpdatedBy = SessionState.CurrentUserAuditName ?? "System",
                            UnitId = item.UnitId
                        };
                        await ApiClient.SaveProductionItemAsync(request);
                    }
                }

                Snackbar.Add("Production record saved successfully.", Severity.Success);
                if (!_isEdit)
                {
                    // Navigate to Items management if new to fill materials consumed
                    NavigationManager.NavigateTo($"/store/production/items/{result}");
                }
                else
                {
                    NavigationManager.NavigateTo("/store/production");
                }
            }
            else
            {
                Snackbar.Add("Failed to save production run.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private void OnCancel() => NavigationManager.NavigateTo("/store/production");

    private async Task<IEnumerable<BomLookupDto>> SearchBoms(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _boms.Any(x => (x.BomName ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _boms;
        return _boms.Where(x => (x.BomName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    private async Task<IEnumerable<SkuLookupDto>> SearchSkus(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _skus.Any(x => (x.SkuName ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _skus;
        return _skus.Where(x => (x.SkuName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    private async Task OnBomChanged(BomLookupDto val)
    {
        _editor.BomId = val?.BomId ?? 0;
        if (val != null)
        {
            var bomDetails = await ApiClient.GetBomByIdAsync(val.BomId);
            if (bomDetails != null)
            {
                _selectedBomUnitId = bomDetails.UnitId;
                _editor.FillingPerBottleUnit = bomDetails.UnitId;
                _selectedBomYield = bomDetails.Quantity;
                RecalculateQtyMade();
                if (bomDetails.TentativeExpiryDays > 0)
                {
                    _editor.ExpiryDate = (_editor.CookingDate ?? DateTime.Today).AddDays(bomDetails.TentativeExpiryDays);
                }
                else
                {
                    _editor.ExpiryDate = null;
                }
            }
        }
        else
        {
            _selectedBomUnitId = null;
            _editor.FillingPerBottleUnit = 0;
            _editor.ExpiryDate = null;
            _selectedBomYield = 1.0;
        }
    }


    private async Task<IEnumerable<UnitLookupDto>> SearchUnits(string value, CancellationToken token)
    {
        if (_selectedBomUnitId == null || _selectedBomUnitId <= 0) return _units;
        var filtered = _units.Where(x => x.UnitId == _selectedBomUnitId || x.BaseUnit == _selectedBomUnitId);
        if (string.IsNullOrEmpty(value)) return filtered;
        return filtered.Where(x => (x.UnitName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    private async Task<IEnumerable<CountryLookupDto>> SearchCountries(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _countries.Any(x => (x.CountryName ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _countries;
        return _countries.Where(x => (x.CountryName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    private async Task<IEnumerable<WarehouseLookupDto>> SearchWarehouses(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _warehouses.Any(x => (x.WarehouseName ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _warehouses;
        return _warehouses.Where(x => (x.WarehouseName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    private async Task OnBomIdChanged(long bomId)
    {
        var val = _boms.FirstOrDefault(x => x.BomId == bomId);
        _editor.BomId = bomId;
        if (val != null)
        {
            var bomDetails = await ApiClient.GetBomByIdAsync(val.BomId);
            if (bomDetails != null)
            {
                _selectedBomUnitId = bomDetails.UnitId;
                _editor.FillingPerBottleUnit = bomDetails.UnitId;
                _selectedBomYield = bomDetails.Quantity;
                RecalculateQtyMade();
                if (bomDetails.TentativeExpiryDays > 0)
                {
                    _editor.ExpiryDate = (_editor.CookingDate ?? DateTime.Today).AddDays(bomDetails.TentativeExpiryDays);
                }
                else
                {
                    _editor.ExpiryDate = null;
                }
            }
        }
        else
        {
            _selectedBomUnitId = null;
            _editor.FillingPerBottleUnit = 0;
            _editor.ExpiryDate = null;
            _selectedBomYield = 1.0;
        }
    }

    private void OnBomQtyChanged(double val)
    {
        _editor.BomQty = val;
        RecalculateQtyMade();
    }

    private void RecalculateQtyMade()
    {
        _editor.FillingBottles = (int)(_editor.BomQty * _selectedBomYield);
    }


    private async Task OnCookingDateChanged(DateTime? newDate)
    {
        _editor.CookingDate = newDate;
        if (_editor.BomId > 0)
        {
            var bomDetails = await ApiClient.GetBomByIdAsync(_editor.BomId);
            if (bomDetails != null && bomDetails.TentativeExpiryDays > 0)
            {
                _editor.ExpiryDate = (newDate ?? DateTime.Today).AddDays(bomDetails.TentativeExpiryDays);
            }
        }
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetBomSelects()
    {
        return _boms.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.BomId,
            Text = x.BomName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetSkuSelects()
    {
        return _skus.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.SkuId,
            Text = x.SkuName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<string>.SelectItemDto<string>> GetKettleSelects()
    {
        return _kettles.Select(x => new SearchableSelect<string>.SelectItemDto<string>
        {
            Value = x.KettleId.ToString(),
            Text = x.KettleNumber ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetUnitSelects()
    {
        var baseList = _units.AsEnumerable();
        if (_selectedBomUnitId != null && _selectedBomUnitId > 0)
        {
            baseList = _units.Where(x => x.UnitId == _selectedBomUnitId || x.BaseUnit == _selectedBomUnitId);
        }
        return baseList.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.UnitId,
            Text = x.UnitName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<string>.SelectItemDto<string>> GetCountrySelects()
    {
        return _countries.Select(x => new SearchableSelect<string>.SelectItemDto<string>
        {
            Value = x.CountryId.ToString(),
            Text = x.CountryName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetWarehouseSelects()
    {
        return _warehouses.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.WarehouseId,
            Text = x.WarehouseName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<string>.SelectItemDto<string>> GetEmployeeSelects()
    {
        return _staffList.Select(x => new SearchableSelect<string>.SelectItemDto<string>
        {
            Value = x.StaffId.ToString(),
            Text = x.StaffName ?? ""
        });
    }
}



