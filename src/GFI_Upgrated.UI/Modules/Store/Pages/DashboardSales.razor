@page "/store/dashboardsales"

@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject GFI_Upgrated.UI.State.AppSessionState SessionState

<PageTitle>Sales Dashboard</PageTitle>

<div class="row">
    @if (_loading)
    {
        <div class="col-12 p-4 text-center"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else
    {
        <!-- Total Revenue -->
        <div class="col-sm-6 col-lg-4 mb-4">
            <div class="card card-border-shadow-primary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-primary"><i class="ti ti-currency-dollar ti-md"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@FormatCurrency(_totalRevenue)</h4>
                    </div>
                    <p class="mb-1 fw-medium">Total Revenue</p>
                </div>
            </div>
        </div>

        <!-- Total Items Sold -->
        <div class="col-sm-6 col-lg-4 mb-4">
            <div class="card card-border-shadow-success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-success"><i class="ti ti-chart-bar ti-md"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@SessionState.FormatNumber(_totalQtySold)</h4>
                    </div>
                    <p class="mb-1 fw-medium">Total Items Sold</p>
                </div>
            </div>
        </div>

        <!-- Top Customer Group -->
        <div class="col-sm-6 col-lg-4 mb-4">
            <div class="card card-border-shadow-warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-warning"><i class="ti ti-users ti-md"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0 text-truncate" style="max-width: 200px;">@_topCustomerGroup</h4>
                    </div>
                    <p class="mb-1 fw-medium">Top Customer Group</p>
                </div>
            </div>
        </div>
    }
</div>

<div class="row">
    @if (!_loading)
    {
        <!-- Recent Invoice Sales -->
        <div class="col-12 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-0">Recent Invoice Sales</h5>
                        <small class="text-muted">Summarized per item name per year</small>
                    </div>
                    <div style="width: 260px;">
                        <MudTextField @bind-Value="_itemSearchString" Placeholder="Search Item or Year..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" Clearable="true"></MudTextField>
                    </div>
                </div>
                <div class="card-body pa-0">
                    <MudTable Items="FilteredTotalSales" Hover="true" Dense="true" Striped="true" Elevation="0" Height="280px">
                        <HeaderContent>
                            <MudTh>Item Name</MudTh>
                            <MudTh Style="text-align: center;">Year</MudTh>
                            <MudTh Style="text-align: right;">Quantity</MudTh>
                            <MudTh Style="text-align: right;">Total Amount</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Item Name">@context.ItemName</MudTd>
                            <MudTd DataLabel="Year" Style="text-align: center;" Class="fw-bold">@context.Year</MudTd>
                            <MudTd DataLabel="Quantity" Style="text-align: right;">@SessionState.FormatNumber(context.Quantity)</MudTd>
                            <MudTd DataLabel="Total Amount" Style="text-align: right;" Class="fw-medium text-success">@FormatCurrency(context.TotalAmount)</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <p class="text-secondary text-center pa-4">No sales records found.</p>
                        </NoRecordsContent>
                    </MudTable>
                </div>
            </div>
        </div>

        <!-- Sales Totals (Annual Performance) -->
        <div class="col-12 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-0">Sales Totals (Annual Performance)</h5>
                        <small class="text-muted">Local (SRD) vs. Export (USD) annual breakdown</small>
                    </div>
                </div>
                <div class="card-body pa-0" style="overflow-x: auto;">
                    <table class="table table-bordered table-hover align-middle mb-0 text-nowrap" style="font-size: 0.88rem;">
                        <thead class="text-center">
                            <tr>
                                <th rowspan="2" class="align-middle fw-bold" style="background-color: #32344f !important; color: #ffffff !important; border: 1px solid #444564 !important; width: 80px;">Y</th>
                                <th colspan="3" class="fw-bold py-2" style="background-color: #696cff !important; color: #ffffff !important; border: 1px solid #5a5dc9 !important;">SRD (Local Sales)</th>
                                <th colspan="3" class="fw-bold py-2" style="background-color: #28c76f !important; color: #ffffff !important; border: 1px solid #20a35b !important;">USD (Export Sales)</th>
                                <th rowspan="2" class="align-middle fw-bold" style="background-color: #32344f !important; color: #ffffff !important; border: 1px solid #444564 !important;">Total Sales (SRD)</th>
                            </tr>
                            <tr style="font-size: 0.82rem;">
                                <th style="background-color: #5356d6 !important; color: #ffffff !important; border: 1px solid #484ab9 !important; width: 120px;">#Ltr</th>
                                <th style="background-color: #5356d6 !important; color: #ffffff !important; border: 1px solid #484ab9 !important; width: 120px;">#Fl</th>
                                <th style="background-color: #5356d6 !important; color: #ffffff !important; border: 1px solid #484ab9 !important;">SRD Value</th>
                                <th style="background-color: #1f9d55 !important; color: #ffffff !important; border: 1px solid #1a8347 !important; width: 120px;">#Ltr</th>
                                <th style="background-color: #1f9d55 !important; color: #ffffff !important; border: 1px solid #1a8347 !important; width: 120px;">#Fl</th>
                                <th style="background-color: #1f9d55 !important; color: #ffffff !important; border: 1px solid #1a8347 !important;">USD Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_dashboardData.AnnualPerformance != null && _dashboardData.AnnualPerformance.Any())
                            {
                                @foreach (var row in _dashboardData.AnnualPerformance)
                                {
                                    <tr>
                                        <td class="fw-bold text-center">@row.Year</td>
                                        <td class="text-end">@SessionState.FormatNumber(row.SrdLiters)</td>
                                        <td class="text-end">@SessionState.FormatNumber(row.SrdBottles)</td>
                                        <td class="text-end fw-medium" style="color: #696cff;">$@SessionState.FormatNumber(row.SrdValue)</td>
                                        <td class="text-end">@SessionState.FormatNumber(row.UsdLiters)</td>
                                        <td class="text-end">@SessionState.FormatNumber(row.UsdBottles)</td>
                                        <td class="text-end fw-medium text-success">$@SessionState.FormatNumber(row.UsdValue)</td>
                                        <td class="text-end fw-bold text-dark">$@SessionState.FormatNumber(row.TotalSalesSrd) SRD</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted pa-4">No performance records found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sales (Liters): per Taste per Year -->
        <div class="col-12 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-0">Sales (Liters): per Taste per Year</h5>
                        <small class="text-muted">Volume (L) broken down by marinade/taste code</small>
                    </div>
                </div>
                <div class="card-body pa-0" style="overflow-x: auto;">
                    <table class="table table-bordered table-striped table-hover align-middle mb-0 text-nowrap" style="font-size: 0.88rem;">
                        <thead class="text-center">
                            <tr>
                                <th class="fw-bold" style="background-color: #32344f !important; color: #ffffff !important; border: 1px solid #444564 !important; width: 80px;">Y</th>
                                <th class="fw-bold" style="background-color: #696cff !important; color: #ffffff !important; border: 1px solid #5a5dc9 !important; width: 140px;">Total Ltr</th>
                                @foreach (var tCode in _dashboardData.AllTasteCodes)
                                {
                                    <th class="fw-bold" style="background-color: #32344f !important; color: #ffffff !important; border: 1px solid #444564 !important;">@tCode</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (_dashboardData.SalesPerTastePerYear != null && _dashboardData.SalesPerTastePerYear.Any())
                            {
                                @foreach (var row in _dashboardData.SalesPerTastePerYear)
                                {
                                    <tr>
                                        <td class="fw-bold text-center">@row.Year</td>
                                        <td class="text-end fw-bold text-primary">@SessionState.FormatNumber(row.TotalLiters)</td>
                                        @foreach (var tCode in _dashboardData.AllTasteCodes)
                                        {
                                            var val = row.TasteLiters.GetValueOrDefault(tCode, 0m);
                                            <td class="text-end @(val > 0 ? "" : "text-muted opacity-50")">
                                                @(val > 0 ? SessionState.FormatNumber(val) : "-")
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="@(2 + (_dashboardData.AllTasteCodes?.Count ?? 0))" class="text-center text-muted pa-4">No taste volume records found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sales Per Customer Group -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Sales Per Customer Group</h5>
                    <small class="text-muted">Revenue by category</small>
                </div>
                <div class="card-body">
                    <MudTable Items="_dashboardData.SalesPerCustomerGroup" Hover="true" Dense="true" Striped="true" Elevation="0" Height="250px">
                        <HeaderContent>
                            <MudTh>Customer Group</MudTh>
                            <MudTh Style="text-align: right;">Total Sales</MudTh>
                            <MudTh Style="text-align: right;">Qty Sold</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Customer Group" Class="fw-medium">@context.CustomerGroup</MudTd>
                            <MudTd DataLabel="Total Sales" Style="text-align: right;" Class="fw-bold text-success">@FormatCurrency(context.TotalAmount)</MudTd>
                            <MudTd DataLabel="Qty Sold" Style="text-align: right;">@SessionState.FormatNumber(context.QuantitySold)</MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            </div>
        </div>

        <!-- Top Customers -->
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Top Customers</h5>
                    <small class="text-muted">Highest paying clients</small>
                </div>
                <div class="card-body">
                    <MudTable Items="_dashboardData.SalesPerCustomer" Hover="true" Dense="true" Striped="true" Elevation="0" Height="250px">
                        <HeaderContent>
                            <MudTh>Customer Name</MudTh>
                            <MudTh Style="text-align: right;">Total Amount</MudTh>
                            <MudTh Style="text-align: right;">Qty Sold</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Customer Name">@context.CustomerName</MudTd>
                            <MudTd DataLabel="Total Amount" Style="text-align: right;" Class="fw-bold text-info">@FormatCurrency(context.TotalAmount)</MudTd>
                            <MudTd DataLabel="Qty Sold" Style="text-align: right;">@SessionState.FormatNumber(context.QuantitySold)</MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            </div>
        </div>

        <!-- Finished Products Batch Stock -->
        <div class="col-12 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="card-title mb-0">Finished Products - Batch Stock</h5>
                        <small class="text-muted">Available stock per finished product batch</small>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <MudCheckBox T="bool" Value="_finishedInStockOnly" ValueChanged="OnFinishedInStockChanged" Color="Color.Primary" Label="In-Stock Only" Dense="true" Class="m-0" />
                        <a href="/store/reportbatchwiseitems" class="btn btn-sm btn-outline-primary">View Full Batch Report</a>
                    </div>
                </div>
                <div class="card-body pa-0">
                    <MudTable Items="_finishedBatchItems" Hover="true" Dense="true" Striped="true" Elevation="0" Height="280px" Loading="_finishedBatchLoading">
                        <HeaderContent>
                            <MudTh>Batch No.</MudTh>
                            <MudTh>Item Name</MudTh>
                            <MudTh Style="text-align: right;">Available Qty.</MudTh>
                            <MudTh>Processing Date</MudTh>
                            <MudTh>Expiry Date</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Batch No." Class="fw-medium">@context.BatchNo</MudTd>
                            <MudTd DataLabel="Item Name">@context.ItemName</MudTd>
                            <MudTd DataLabel="Available Qty." Style="text-align: right;" Class="fw-bold text-success">@SessionState.FormatNumber(context.AvailableQty) @context.UnitName</MudTd>
                            <MudTd DataLabel="Processing Date">@SessionState.FormatDate(context.ProcessingDate)</MudTd>
                            <MudTd DataLabel="Expiry Date">@SessionState.FormatDate(context.ExpiryDate)</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <p class="text-secondary text-center pa-4">No finished product batch items found.</p>
                        </NoRecordsContent>
                    </MudTable>
                </div>
            </div>
        </div>
    }
</div>
@code {
    private bool _loading = true;
    private SalesDashboardDto _dashboardData = new();
    
    private decimal _totalRevenue = 0;
    private decimal _totalQtySold = 0;
    private string _topCustomerGroup = "None";
    private string _itemSearchString = string.Empty;

    private bool _finishedBatchLoading = false;
    private bool _finishedInStockOnly = true;
    private List<BatchWiseItemDto> _finishedBatchItems = new();

    private IEnumerable<SalesSummaryDto> FilteredTotalSales
    {
        get
        {
            if (_dashboardData.TotalSales == null)
                return Enumerable.Empty<SalesSummaryDto>();

            if (string.IsNullOrWhiteSpace(_itemSearchString))
                return _dashboardData.TotalSales;

            return _dashboardData.TotalSales.Where(x =>
                x.ItemName.Contains(_itemSearchString, StringComparison.OrdinalIgnoreCase) ||
                x.Year.ToString().Contains(_itemSearchString, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadDashboardDataAsync();
        await LoadFinishedBatchItemsAsync();
    }

    private async Task LoadFinishedBatchItemsAsync()
    {
        _finishedBatchLoading = true;
        try
        {
            var res = await ApiClient.GetBatchWiseItemsPagedAsync(null, null, 1, _finishedInStockOnly, 1, 25, "DESC");
            _finishedBatchItems = res.Items.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading batch stock: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _finishedBatchLoading = false;
        }
    }

    private async Task OnFinishedInStockChanged(bool val)
    {
        _finishedInStockOnly = val;
        await LoadFinishedBatchItemsAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        _loading = true;
        try
        {
            _dashboardData = await ApiClient.GetSalesDashboardAsync();
            
            // Calculate KPIs
            if (_dashboardData.TotalSales != null)
            {
                _totalRevenue = _dashboardData.TotalSales.Sum(x => x.TotalAmount);
                _totalQtySold = _dashboardData.TotalSales.Sum(x => x.Quantity);
            }
            if (_dashboardData.SalesPerCustomerGroup != null && _dashboardData.SalesPerCustomerGroup.Any())
            {
                _topCustomerGroup = _dashboardData.SalesPerCustomerGroup.First().CustomerGroup;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading Sales Dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatCurrency(decimal val)
    {
        return $"${SessionState.FormatNumber(val)} SRD";
    }
}

