@page "/store/w_masterskuaddlist"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject IJSRuntime JS

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">SKU</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Manage product SKU and their configuration</MudText>
        </MudStack>
        @if (_canInsert)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OnAdd">
                Add New
            </MudButton>
        }
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4" Style="max-width: 500px;">
        
        <MudTextField T="string" Value="@_searchText" ValueChanged="@OnSearchTextChanged" Label="Search SKUs" Variant="Variant.Outlined" Immediate="true" Clearable="true" 
OnClearButtonClick="OnSearch" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        
    </MudStack>

    <MudTable RowsPerPage="25" T="SkuDto" @ref="_table" ServerData="LoadServerDataAsync" Hover="true" Dense="true" Striped="true" Bordered="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="SkuDto" SortLabel="SkuName">SKU Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="SkuDto" SortLabel="UnitId">Unit</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="SkuDto" SortLabel="Quantity">Content</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="SkuDto" SortLabel="QuantityPerColli">Qty. Per Colli</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: center;"><MudTableSortLabel T="SkuDto" SortLabel="IsActive">Status</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="SkuDto" SortLabel="Remarks">Remarks</MudTableSortLabel></MudTh>
            <MudTh Style="width: 120px; text-align: center;">Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="SKU Name">@context.SkuName</MudTd>
            <MudTd DataLabel="Unit">@context.UnitName</MudTd>
            <MudTd DataLabel="Quantity">@context.Quantity</MudTd>
            <MudTd DataLabel="Qty Per Colli">@context.QuantityPerColli</MudTd>
            <MudTd DataLabel="Status" Style="text-align: center;">
                <MudSwitch T="bool" Value="@context.IsActive" ValueChanged="@((bool val) => ToggleStatusAsync(context, val))" Color="Color.Success" UnCheckedColor="Color.Error" Disabled="!_canUpdate" />
            </MudTd>
            <MudTd DataLabel="Remarks">@context.Remarks</MudTd>
            <MudTd DataLabel="Action" Style="text-align: center;">
                <MudStack Row="true" Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.Center">
                    @if (_canUpdate)
                    {
                        <MudTooltip Text="Edit">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OnEdit(context))" />
                        </MudTooltip>
                    }
                    @if (_canDelete)
                    {
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnDelete(context))" />
                        </MudTooltip>
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="pa-4">No SKUs found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<SkuDto>? _cachedItems;

    private async Task OnSearchTextChanged(string text)
    {
        _searchText = text;
        if (_table is not null) await _table.ReloadServerData();
    }

    private MudTable<SkuDto> _table = null!;
    private string? _searchText;
    private bool _canInsert;
    private bool _canUpdate;
    private bool _canDelete;

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        var permissions = SessionState.GetPermissions("/store/w_masterskuaddlist");
        _canInsert = permissions.IsInsert;
        _canUpdate = permissions.IsUpdate;
        _canDelete = permissions.IsDelete;
    }

    private async Task<TableData<SkuDto>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var request = new PagedRequest
            {
                CurrentPage = state.Page + 1,
                RecordPerPage = state.PageSize,
                SortColumn = state.SortLabel ?? "SkuID",
                SortType = state.SortDirection == SortDirection.Ascending ? "ASC" : "DESC"
            };

            var result = await ApiClient.GetSkusAsync(request, _searchText, cancellationToken);
            return new TableData<SkuDto>
            {
                TotalItems = result.TotalRecord,
                Items = result.Items
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<SkuDto> { TotalItems = 0, Items = Array.Empty<SkuDto>() };
        }
    }

    private void OnSearch() => _table.ReloadServerData();

    private void OnAdd() => NavigationManager.NavigateTo("/store/w_masterskuaddlist/new");

    private void OnEdit(SkuDto sku) => NavigationManager.NavigateTo($"/store/w_masterskuaddlist/edit/{sku.SkuId}");

    private async Task ToggleStatusAsync(SkuDto sku, bool val)
    {
        try
        {
            var request = new SaveSkuRequest
            {
                SkuId = sku.SkuId,
                SkuName = sku.SkuName,
                UnitId = sku.UnitId,
                Quantity = sku.Quantity,
                QuantityPerColli = sku.QuantityPerColli,
                IsActive = val,
                Remarks = sku.Remarks,
                UpdatedBy = SessionState.CurrentUserAuditName ?? "System"
            };
            var result = await ApiClient.SaveSkuAsync(request);
            if (result > 0)
            {
                sku.IsActive = val;
                Snackbar.Add("SKU status updated successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to update SKU status.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating SKU status: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnDelete(SkuDto sku)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete SKU: {sku.SkuName}?");

        if (confirmed)
        {
            try
            {
                var success = await ApiClient.DeleteSkuAsync(sku.SkuId, SessionState.CurrentUserAuditName);
                if (success > 0)
                {
                    Snackbar.Add("SKU deleted successfully.", Severity.Success);
                    _cachedItems = null;
                    await _table.ReloadServerData();
                }
                else
                {
                    Snackbar.Add("Failed to delete SKU.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}

