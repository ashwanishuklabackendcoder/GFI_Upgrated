@page "/store/reports/batch-wise-items/traceability/{BatchNo}"
@page "/admin/reports/batch-wise-items/traceability/{BatchNo}"
@using System.Text
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@inject StoreApiClient ApiClient
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Batch Traceability - @BatchNo</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h5">Batch Traceability</MudText>
            <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>@BatchNo</strong></MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2" Class="no-print">
            <MudMenu Label="Export" StartIcon="@Icons.Material.Filled.SaveAlt" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Color="Color.Primary" Variant="Variant.Filled">
                <MudMenuItem OnClick="ExportToCopyAsync" Icon="@Icons.Material.Filled.ContentCopy">Copy to Clipboard</MudMenuItem>
                <MudMenuItem OnClick="ExportToCsvAsync" Icon="@Icons.Material.Filled.InsertDriveFile">Export to CSV</MudMenuItem>
                <MudMenuItem OnClick="ExportToPrintAsync" Icon="@Icons.Material.Filled.Print">Print Report</MudMenuItem>
                <MudMenuItem OnClick="ExportToPdfAsync" Icon="@Icons.Material.Filled.PictureAsPdf">Save as PDF</MudMenuItem>
            </MudMenu>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => JS.InvokeVoidAsync("history.back"))">
                Back
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-4">
    <MudTable Items="_traceabilityData" Hover="true" Dense="true" Striped="true" Bordered="true" Loading="_loading">
        <HeaderContent>
            <MudTh>Reference</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Item Name</MudTh>
            <MudTh>Transaction Type</MudTh>
            <MudTh Style="text-align: right;">In Qty</MudTh>
            <MudTh Style="text-align: right;">Out Qty</MudTh>
            <MudTh Style="text-align: right;">Value (SRD)</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Reference">
                @if (context.RefUsedFor == 2 && context.RefUsedForId > 0)
                {
                    <a href="@($"/store/preprocessing/view/{context.RefUsedForId}")" style="color:var(--mud-palette-primary); text-decoration:underline;">@context.Reference</a>
                }
                else if (context.RefUsedFor == 3 && context.RefUsedForId > 0)
                {
                    <a href="@($"/store/production/view/{context.RefUsedForId}")" style="color:var(--mud-palette-primary); text-decoration:underline;">@context.Reference</a>
                }
                else if (context.RefUsedFor == 1 && context.RefUsedForId > 0)
                {
                    <a href="@($"/admin/invoice/edit/{context.RefUsedForId}")" style="color:var(--mud-palette-primary); text-decoration:underline;">@context.Reference</a>
                }
                else if (context.RefUsedFor == -1 && context.RefUsedForId > 0)
                {
                    <a href="@($"/admin/purchase/view/{context.RefUsedForId}")" style="color:var(--mud-palette-primary); text-decoration:underline;">@context.Reference</a>
                }
                else
                {
                    @if (context.TransactionType.Contains("Opening Stock", StringComparison.OrdinalIgnoreCase))
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Opening Stock</MudChip>
                    }
                    else if (context.TransactionType.Contains("Produced", StringComparison.OrdinalIgnoreCase) || context.TransactionType.Contains("Production", StringComparison.OrdinalIgnoreCase))
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">Production</MudChip>
                    }
                    else
                    {
                        @context.Reference
                    }
                }
            </MudTd>
            <MudTd DataLabel="Date">@(context.TransactionDate?.ToString("MM/dd/yyyy") ?? "N/A")</MudTd>
            <MudTd DataLabel="Item Name">@context.ItemName</MudTd>
            <MudTd DataLabel="Transaction Type">
                @if (context.TransactionType.Contains("Opening Stock", StringComparison.OrdinalIgnoreCase))
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@context.TransactionType</MudChip>
                }
                else if (context.TransactionType.Contains("Pre-Processing", StringComparison.OrdinalIgnoreCase) || 
                         context.TransactionType.Contains("Production", StringComparison.OrdinalIgnoreCase) || 
                         context.TransactionType.Contains("Produced", StringComparison.OrdinalIgnoreCase))
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">@context.TransactionType</MudChip>
                }
                else if (context.TransactionType.Contains("Purchased", StringComparison.OrdinalIgnoreCase) || 
                         context.TransactionType.Contains("Sales", StringComparison.OrdinalIgnoreCase))
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">@context.TransactionType</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">@context.TransactionType</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="In Qty" Style="text-align: right;">@(context.InQty > 0 ? $"{context.InQty} {context.UnitName}" : "-")</MudTd>
            <MudTd DataLabel="Out Qty" Style="text-align: right;">@(context.OutQty > 0 ? $"{context.OutQty:F1} {context.UnitName}" : "-")</MudTd>
            <MudTd DataLabel="Value" Style="text-align: right; font-weight: bold;">@SessionState.FormatNumber(context.TotalValue)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">No traceability records found for this batch.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    [Parameter]
    public string BatchNo { get; set; } = string.Empty;

    private List<ItemStockTraceabilityDto> _traceabilityData = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(BatchNo))
        {
            _loading = false;
            return;
        }

        try
        {
            var data = await ApiClient.GetBatchTraceabilityAsync(Uri.UnescapeDataString(BatchNo));
            _traceabilityData = data.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading batch traceability: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportToCopyAsync()
    {
        if (!_traceabilityData.Any()) return;
        var sb = new StringBuilder();
        sb.AppendLine("Reference\tDate\tItem Name\tTransaction Type\tIn Qty\tOut Qty\tValue (SRD)");
        foreach (var item in _traceabilityData)
        {
            sb.AppendLine($"{item.Reference}\t{item.TransactionDate?.ToString("MM/dd/yyyy") ?? "N/A"}\t{item.ItemName}\t{item.TransactionType}\t{(item.InQty > 0 ? $"{SessionState.FormatNumber(item.InQty)} {item.UnitName}" : "-")}\t{(item.OutQty > 0 ? $"{SessionState.FormatNumber(item.OutQty)} {item.UnitName}" : "-")}\t{SessionState.FormatNumber(item.TotalValue)}");
        }
        var success = await JS.InvokeAsync<bool>("gfiCopyToClipboard", sb.ToString());
        if (success) Snackbar.Add("Data copied to clipboard.", Severity.Success);
        else Snackbar.Add("Failed to copy data.", Severity.Error);
    }

    private async Task ExportToCsvAsync()
    {
        if (!_traceabilityData.Any()) return;
        var sb = new StringBuilder();
        sb.AppendLine("Reference,Date,Item Name,Transaction Type,In Qty,Out Qty,Value (SRD)");
        foreach (var item in _traceabilityData)
        {
            var refName = (item.Reference ?? "").Replace("\"", "\"\"");
            var itemName = (item.ItemName ?? "").Replace("\"", "\"\"");
            var typeName = (item.TransactionType ?? "").Replace("\"", "\"\"");
            sb.AppendLine($"\"{refName}\",\"{item.TransactionDate?.ToString("MM/dd/yyyy") ?? "N/A"}\",\"{itemName}\",\"{typeName}\",\"{(item.InQty > 0 ? $"{SessionState.FormatNumber(item.InQty)} {item.UnitName}" : "-")}\",\"{(item.OutQty > 0 ? $"{SessionState.FormatNumber(item.OutQty)} {item.UnitName}" : "-")}\",\"{SessionState.FormatNumber(item.TotalValue)}\"");
        }
        await JS.InvokeVoidAsync("gfiDownloadTextFile", $"batch-traceability-{BatchNo.Replace(" ", "").Replace("|", "-")}-{DateTime.Now:yyyyMMddHHmmss}.csv", sb.ToString(), "text/csv;charset=utf-8");
        Snackbar.Add("Data exported as CSV.", Severity.Success);
    }

    private async Task ExportToPrintAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportToPdfAsync()
    {
        Snackbar.Add("Tip: Choose 'Save as PDF' as the destination in the print window.", Severity.Info);
        await JS.InvokeVoidAsync("window.print");
    }
}


