@page "/store/reports/batch-wise-items"
@page "/admin/reports/batch-wise-items"
@page "/store/reportbatchwiseitems"
@page "/admin/reportbatchwiseitems"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.SharedDto.Common
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@using System.Text
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject IJSRuntime JS

<PageTitle>Batch Number Wise Items</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 no-print">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (FromItemStock == true)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="BackToItemStock" Class="mr-2" />
            }
            <MudText Typo="Typo.h5">Batch Number Wise Items</MudText>
        </MudStack>
        <MudMenu Label="Export" StartIcon="@Icons.Material.Filled.SaveAlt" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Color="Color.Primary" Variant="Variant.Filled">
            <MudMenuItem OnClick="ExportToCopyAsync" Icon="@Icons.Material.Filled.ContentCopy">Copy to Clipboard</MudMenuItem>
            <MudMenuItem OnClick="ExportToCsvAsync" Icon="@Icons.Material.Filled.InsertDriveFile">Export to CSV</MudMenuItem>
            <MudMenuItem OnClick="ExportToPrintAsync" Icon="@Icons.Material.Filled.Print">Print Report</MudMenuItem>
            <MudMenuItem OnClick="ExportToPdfAsync" Icon="@Icons.Material.Filled.PictureAsPdf">Save as PDF</MudMenuItem>
        </MudMenu>
    </MudStack>
   
    <MudGrid Class="mb-4 no-print" Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="6" md="3">
            <MudTextField T="string" Label="Batch No." Value="_batchNumber" ValueChanged="OnBatchNumberChanged" 
                          Variant="Variant.Outlined" Placeholder="Search Batch No." Clearable="true" Immediate="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <SearchableSelect T="RawMaterialDto" Label="Item" Value="@_selectedItem" ValueChanged="OnItemChanged" Variant="Variant.Outlined" Items="@GetItemSelects()" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="long?" Label="Item Type" Value="_selectedItemTypeId" ValueChanged="OnItemTypeChanged" Variant="Variant.Outlined">
                <MudSelectItem Value="@((long?)0)">All Types</MudSelectItem>
                <MudSelectItem Value="@((long?)3)">Raw Material</MudSelectItem>
                <MudSelectItem Value="@((long?)2)">Semi-Finished</MudSelectItem>
                <MudSelectItem Value="@((long?)1)">Finished Product</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudCheckBox T="bool" Value="_inStockOnly" ValueChanged="OnInStockOnlyChanged" Color="Color.Primary" Label="In-Stock Only" Class="mt-2" />
        </MudItem>
        <MudItem xs="12" md="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnSearch" FullWidth="true" Class="py-3">
                Search
            </MudButton>
        </MudItem>
    </MudGrid>

    <div class="print-only mb-6">
        <div style="text-align: center; border-bottom: 2px solid #333; padding-bottom: 12px; margin-bottom: 16px;">
            <h2 style="margin: 0; font-size: 24px; font-weight: bold; color: #111;">GFI</h2>
            <h3 style="margin: 4px 0 0; font-size: 18px; color: #555;">Batch Number Wise Items</h3>
            <p style="margin: 4px 0 0; font-size: 12px; color: #777;">Generated on: @DateTime.Now.ToString("g")</p>
        </div>
        <div style="font-size: 14px; margin-bottom: 16px;">
            <strong>Filters Applied:</strong><br />
            Batch Number: @(string.IsNullOrWhiteSpace(_batchNumber) ? "Any" : _batchNumber) | 
            Item: @(_selectedItem?.ItemName ?? "Any Item") |
            In-Stock Only: @(_inStockOnly ? "Yes" : "No")
        </div>
    </div>

    <MudTable RowsPerPage="25" T="BatchWiseItemDto" @ref="_table" ServerData="LoadServerDataAsync" Hover="true" Dense="true" Striped="true" Bordered="true" Loading="_loading">
        <HeaderContent>
            <MudTh>Batch No.</MudTh>
            <MudTh>Item Name</MudTh>
            <MudTh>Item Type</MudTh>
            <MudTh>Entry From</MudTh>
            <MudTh Style="text-align: right;">Available Qty.</MudTh>
            <MudTh>Processing Date</MudTh>
            <MudTh>Expiry Date</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Batch No.">
                <a href="@($"/store/reports/batch-wise-items/traceability/{Uri.EscapeDataString(context.BatchNo ?? string.Empty)}")" style="color:var(--mud-palette-primary); text-decoration:none;">@context.BatchNo</a>
            </MudTd>
            <MudTd DataLabel="Item Name">@context.ItemName</MudTd>
            <MudTd DataLabel="Item Type">@(string.IsNullOrWhiteSpace(context.ItemTypeName) ? "-" : context.ItemTypeName)</MudTd>
            <MudTd DataLabel="Account Name">@context.AccountName</MudTd>
            <MudTd DataLabel="Available Qty." Style="text-align: right; font-weight: bold;">@FormatQty(context.AvailableQty, context.UnitName)</MudTd>
            <MudTd DataLabel="Processing Date">@SessionState.FormatDate(context.ProcessingDate)</MudTd>
            <MudTd DataLabel="Expiry Date">@SessionState.FormatDate(context.ExpiryDate)</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager Class="no-print" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Class="pa-4">No batch items found. Try changing filters or search criteria.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<BatchWiseItemDto>? _cachedItems;

    private string? _searchString;

    private string FormatQty(double qty, string? unitName)
    {
        if (qty == 0) return "0";
        string formattedVal = SessionState.FormatNumber(qty);
        return string.IsNullOrWhiteSpace(unitName) ? formattedVal : $"{formattedVal} {unitName}";
    }

    private MudTable<BatchWiseItemDto>? _table;
    private string _batchNumber = "";
    private RawMaterialDto? _selectedItem;
    private long? _selectedItemTypeId = 0;
    private bool _inStockOnly = false;

    [SupplyParameterFromQuery]
    public long? ItemId { get; set; }

    [SupplyParameterFromQuery]
    public bool? FromItemStock { get; set; }

    private void BackToItemStock()
    {
        Navigation.NavigateTo($"/store/reportitemstock?itemId={ItemId}");
    }

    private bool _loading;
    private string _currentSortDirection = "DESC";
    private List<RawMaterialDto> _items = new();

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var itemResult = await ApiClient.GetItemsForBomLookupAsync(null);
            _items = itemResult.OrderBy(x => x.ItemName).ToList();

            if (ItemId.HasValue && ItemId.Value > 0)
            {
                _selectedItem = _items.FirstOrDefault(x => x.ItemId == ItemId.Value);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading items: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnBatchNumberChanged(string val)
    {
        _batchNumber = val;
        if (_table != null) await _table.ReloadServerData();
    }

    private async Task OnItemChanged(RawMaterialDto? val)
    {
        _selectedItem = val;
        if (_table != null) await _table.ReloadServerData();
    }

    private async Task OnItemTypeChanged(long? val)
    {
        _selectedItemTypeId = val;
        if (_table != null) await _table.ReloadServerData();
    }

    private async Task OnInStockOnlyChanged(bool val)
    {
        _inStockOnly = val;
        if (_table != null) await _table.ReloadServerData();
    }

    private IEnumerable<SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>> GetItemSelects()
    {
        var list = new List<SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>>
        {
            new SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>
            {
                Value = null,
                Text = "-- All Items --"
            }
        };

        if (_items != null)
        {
            list.AddRange(_items.Select(x => new SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>
            {
                Value = x,
                Text = x.ItemName ?? ""
            }));
        }

        return list;
    }

    private async Task<TableData<BatchWiseItemDto>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            _currentSortDirection = state.SortDirection == SortDirection.Ascending ? "ASC" : "DESC";

            var result = await ApiClient.GetBatchWiseItemsPagedAsync(
                _batchNumber, 
                _selectedItem?.ItemId, 
                _selectedItemTypeId, 
                _inStockOnly, 
                state.Page + 1, 
                state.PageSize, 
                _currentSortDirection, 
                cancellationToken);

            return new TableData<BatchWiseItemDto>
            {
                TotalItems = result.TotalRecord,
                Items = result.Items
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading batch wise report: {ex.Message}", Severity.Error);
            return new TableData<BatchWiseItemDto> { Items = Array.Empty<BatchWiseItemDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch()
    {
        if (_table != null) await _table.ReloadServerData();
    }

    private async Task<List<BatchWiseItemDto>> GetAllDataAsync()
    {
        try
        {
            var result = await ApiClient.GetBatchWiseItemsPagedAsync(
                _batchNumber, 
                _selectedItem?.ItemId, 
                _selectedItemTypeId, 
                _inStockOnly, 
                1, 
                1000000, 
                _currentSortDirection);
            return result.Items.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading export data: {ex.Message}", Severity.Error);
            return new();
        }
    }

    private async Task ExportToCopyAsync()
    {
        var data = await GetAllDataAsync();
        var sb = new StringBuilder();
        sb.AppendLine("Batch No.\tItem Name\tAccount Name\tAvailable Qty.\tProcessing Date\tExpiry Date");
        foreach (var item in data)
        {
            sb.AppendLine($"{item.BatchNo}\t{item.ItemName}\t{item.AccountName}\t{FormatQty(item.AvailableQty, item.UnitName)}\t{item.ProcessingDate}\t{item.ExpiryDate}");
        }
        var success = await JS.InvokeAsync<bool>("gfiCopyToClipboard", sb.ToString());
        if (success)
        {
            Snackbar.Add("Report data copied to clipboard.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to copy data to clipboard.", Severity.Error);
        }
    }

    private async Task ExportToCsvAsync()
    {
        var data = await GetAllDataAsync();
        var sb = new StringBuilder();
        sb.AppendLine("Batch No.,Item Name,Account Name,Available Qty.,Processing Date,Expiry Date");
        foreach (var item in data)
        {
            var name = (item.ItemName ?? "").Replace("\"", "\"\"");
            var accName = (item.AccountName ?? "").Replace("\"", "\"\"");
            sb.AppendLine($"\"{item.BatchNo}\",\"{name}\",\"{accName}\",\"{FormatQty(item.AvailableQty, item.UnitName)}\",\"{item.ProcessingDate}\",\"{item.ExpiryDate}\"");
        }
        await JS.InvokeVoidAsync("gfiDownloadTextFile", $"batch-wise-items-report-{DateTime.Now:yyyyMMddHHmmss}.csv", sb.ToString(), "text/csv;charset=utf-8");
        Snackbar.Add("Report data exported as CSV.", Severity.Success);
    }

    private async Task ExportToPrintAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportToPdfAsync()
    {
        Snackbar.Add("Tip: Choose 'Save as PDF' as the destination in the print window.", Severity.Info);
        await JS.InvokeVoidAsync("window.print");
    }
}

