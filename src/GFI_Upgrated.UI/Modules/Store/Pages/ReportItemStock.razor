
@page "/store/reportitemstock"

@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.SharedDto.Common
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@using System.Text
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppSessionState SessionState
@inject IJSRuntime JS

<PageTitle>Item Stock Report</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 no-print">
        <MudText Typo="Typo.h5">Item Stock Report</MudText>
        <MudMenu Label="Export" StartIcon="@Icons.Material.Filled.SaveAlt" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Color="Color.Primary" Variant="Variant.Filled">
            <MudMenuItem OnClick="ExportToCopyAsync" Icon="@Icons.Material.Filled.ContentCopy">Copy to Clipboard</MudMenuItem>
            <MudMenuItem OnClick="ExportToCsvAsync" Icon="@Icons.Material.Filled.InsertDriveFile">Export to CSV</MudMenuItem>
            <MudMenuItem OnClick="ExportToPrintAsync" Icon="@Icons.Material.Filled.Print">Print Report</MudMenuItem>
            <MudMenuItem OnClick="ExportToPdfAsync" Icon="@Icons.Material.Filled.PictureAsPdf">Save as PDF</MudMenuItem>
        </MudMenu>
    </MudStack>

    <MudGrid Class="mb-4 no-print" Spacing="2">
        <MudItem xs="12" md="3">
            <SearchableSelect T="int?" Label="Item Type" Value="@_selectedItemTypeId" ValueChanged="@((int? val) => { _selectedItemTypeId = val; })" Variant="Variant.Outlined" Items="@GetItemTypeSelects()" />
        </MudItem>
        <MudItem xs="12" md="4">
            <SearchableSelect T="RawMaterialDto" Label="Select Item" Value="@_selectedItem" ValueChanged="@((RawMaterialDto val) => { _selectedItem = val; })" Variant="Variant.Outlined" Items="@GetItemSelects()" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="From Date" @bind-Date="_fromDate" Variant="Variant.Outlined" Clearable="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="To Date" @bind-Date="_toDate" Variant="Variant.Outlined" Clearable="true" />
        </MudItem>
      
        <MudItem xs="12" md="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnSearch" FullWidth="true" Class="py-3">
                Search
            </MudButton>
        </MudItem>
    </MudGrid>

    <div class="print-only mb-6">
        <div style="text-align: center; border-bottom: 2px solid #333; padding-bottom: 12px; margin-bottom: 16px;">
            <h2 style="margin: 0; font-size: 24px; font-weight: bold; color: #111;">GFI</h2>
            <h3 style="margin: 4px 0 0; font-size: 18px; color: #555;">Item Stock Report</h3>
            <p style="margin: 4px 0 0; font-size: 12px; color: #777;">Generated on: @DateTime.Now.ToString("g")</p>
        </div>
        <div style="font-size: 14px; margin-bottom: 16px;">
            <strong>Filters Applied:</strong><br />
            Item: @(_selectedItem?.ItemName ?? "All Items") | 
            From: @(_fromDate?.ToString("d") ?? "Start") | To: @(_toDate?.ToString("d") ?? "End") | 
            Item Type: @(_selectedItemTypeId == 3 ? "Raw Material" : _selectedItemTypeId == 2 ? "Semi-Finished" : _selectedItemTypeId == 1 ? "Finished Product" : "All Types")
        </div>
    </div>

    <MudTable RowsPerPage="25" T="ItemStockReportDto" @ref="_table" ServerData="LoadServerDataAsync" Hover="true" Dense="true" Striped="true" Bordered="true" Loading="_loading">
        <HeaderContent>
            <MudTh Style="display:none;"><MudTableSortLabel SortLabel="StockID" T="ItemStockReportDto">Stock ID</MudTableSortLabel></MudTh>
            <MudTh>Item Name</MudTh>
            <MudTh Style="text-align: right;">Opening Qty.</MudTh>
            <MudTh Style="text-align: right;">Purchased Qty.</MudTh>
            <MudTh Style="text-align: right;">Issued Qty.</MudTh>
            <MudTh Style="text-align: right;">Removed Qty.</MudTh>
            <MudTh Style="text-align: right;">Final Stock</MudTh>
            <MudTh Style="text-align: right;">SRD</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Stock ID" Style="display:none;">@context.StockID</MudTd>
            <MudTd DataLabel="Item">
                <a href="@($"/store/reportbatchwiseitems?itemId={context.ItemID}")" style="color:var(--mud-palette-primary); text-decoration:none;">@context.ItemName</a>
            </MudTd>
            <MudTd DataLabel="Opening Qty" Style="text-align: right;">@FormatQty(context.OpeningQuantity, context.UnitId)</MudTd>
            <MudTd DataLabel="Purchased Qty" Style="text-align: right;">@FormatQty(context.PurchasedQuantity, context.UnitId)</MudTd>
            <MudTd DataLabel="Issued Qty" Style="text-align: right;">@FormatQty(context.IssuedQuantity, context.UnitId)</MudTd>
            <MudTd DataLabel="Removed Qty" Style="text-align: right;">@FormatQty(context.RemovedQuantity, context.UnitId)</MudTd>
            <MudTd DataLabel="Final Stock" Style="text-align: right; font-weight: bold;">@FormatQty(context.FinalStock, context.UnitId)</MudTd>
            <MudTd DataLabel="Stock Value" Style="text-align: right; font-weight: bold;">@FormatAmount(context.TotalValue)</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager Class="no-print" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Class="pa-4">No stock records found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<ItemStockReportDto>? _cachedItems;

    private string? _searchString;

    private async Task OnSearchTextChanged(string text)
    {
        _searchString = text;
        if (_table is not null) await _table.ReloadServerData();
    }

    private string FormatQty(double qty, long unitId)
    {
        if (qty == 0) return "0";
        var unitName = _units.FirstOrDefault(u => u.UnitId == unitId)?.UnitName ?? "";
        string formattedVal = (qty % 1 == 0) ? qty.ToString("0") : qty.ToString("0.##");
        return string.IsNullOrWhiteSpace(unitName) ? formattedVal : $"{formattedVal} {unitName}";
    }

    private string FormatAmount(double val)
    {
        return (val % 1 == 0) ? val.ToString("0") : val.ToString("0.##");
    }

    private MudTable<ItemStockReportDto>? _table;
    private RawMaterialDto? _selectedItem;
    private int? _selectedItemTypeId;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private bool _loading;
    
    private string _currentSortLabel = "StockID";
    private string _currentSortDirection = "ASC";

    private List<RawMaterialDto> _items = new();
    private List<UnitDto> _units = new();

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadLookups();
    }

    private async Task LoadLookups()
    {
        try
        {
            var itemResult = await ApiClient.GetItemsForBomLookupAsync(null);
            _items = itemResult.OrderBy(x => x.ItemName).ToList();

            var unitResult = await ApiClient.GetUnitsAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _units = unitResult.Items.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading filters: {ex.Message}", Severity.Error);
        }
    }

    private IEnumerable<SearchableSelect<int?>.SelectItemDto<int?>> GetItemTypeSelects()
    {
        return new List<SearchableSelect<int?>.SelectItemDto<int?>>
        {
            new() { Value = (int)MasterItemType.RawMaterial, Text = "Raw Material" },
            new() { Value = (int)MasterItemType.SemiFinished, Text = "Semi-Finished Product" },
            new() { Value = (int)MasterItemType.FinishedProduct, Text = "Finished Product" }
        };
    }

    private IEnumerable<SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>> GetItemSelects()
    {
        return (_items ?? new List<RawMaterialDto>()).Select(x => new SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>
        {
            Value = x,
            Text = x.ItemName ?? ""
        });
    }

    private async Task<TableData<ItemStockReportDto>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            _currentSortLabel = state.SortLabel ?? "StockID";
            _currentSortDirection = state.SortDirection == SortDirection.Ascending ? "ASC" : "DESC";

            var request = new ItemStockReportRequest
            {
                ItemID = _selectedItem?.ItemId,
                ItemTypeId = _selectedItemTypeId,
                FromDate = _fromDate,
                ToDate = _toDate,
                CurrentPage = state.Page + 1,
                RecordPerPage = state.PageSize,
                SortColumn = _currentSortLabel,
                SortType = _currentSortDirection
            };

            var result = await ApiClient.GetItemStockReportAsync(request, cancellationToken);
            
            if (result.CurrentPage != state.Page + 1 && _table != null)
            {
                _table.NavigateTo(result.CurrentPage - 1);
            }

            return new TableData<ItemStockReportDto>
            {
                TotalItems = result.TotalRecord,
                Items = result.Items
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading stock report: {ex.Message}", Severity.Error);
            return new TableData<ItemStockReportDto> { Items = Array.Empty<ItemStockReportDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch()
    {
        if (_table != null) await _table.ReloadServerData();
    }

    private async Task<List<ItemStockReportDto>> GetAllDataAsync()
    {
        try
        {
            var request = new ItemStockReportRequest
            {
                ItemID = _selectedItem?.ItemId,
                ItemTypeId = _selectedItemTypeId,
                FromDate = _fromDate,
                ToDate = _toDate,
                CurrentPage = 1,
                RecordPerPage = 1000000,
                SortColumn = _currentSortLabel,
                SortType = _currentSortDirection
            };
            var result = await ApiClient.GetItemStockReportAsync(request);
            return result.Items.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading export data: {ex.Message}", Severity.Error);
            return new();
        }
    }

    private async Task ExportToCopyAsync()
    {
        var data = await GetAllDataAsync();
        var sb = new StringBuilder();
        sb.AppendLine("StockID\tItem Name\tOpening Qty\tPurchased Qty\tIssued Qty\tRemoved Qty\tFinal Stock\tStock Value");
        foreach (var item in data)
        {
            sb.AppendLine($"${item.StockID}\t${item.ItemName}\t${FormatQty(item.OpeningQuantity, item.UnitId)}\t${FormatQty(item.PurchasedQuantity, item.UnitId)}\t${FormatQty(item.IssuedQuantity, item.UnitId)}\t${FormatQty(item.RemovedQuantity, item.UnitId)}\t${FormatQty(item.FinalStock, item.UnitId)}\t${FormatAmount(item.TotalValue)} SRD");
        }
        var success = await JS.InvokeAsync<bool>("gfiCopyToClipboard", sb.ToString());
        if (success)
        {
            Snackbar.Add("Report data copied to clipboard.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Failed to copy data to clipboard.", Severity.Error);
        }
    }

    private async Task ExportToCsvAsync()
    {
        var data = await GetAllDataAsync();
        var sb = new StringBuilder();
        sb.AppendLine("StockID,Item Name,Opening Qty,Purchased Qty,Issued Qty,Removed Qty,Final Stock,Stock Value");
        foreach (var item in data)
        {
            var name = (item.ItemName ?? "").Replace("\"", "\"\"");
            sb.AppendLine($"{item.StockID},\"{name}\",{FormatQty(item.OpeningQuantity, item.UnitId)},{FormatQty(item.PurchasedQuantity, item.UnitId)},{FormatQty(item.IssuedQuantity, item.UnitId)},{FormatQty(item.RemovedQuantity, item.UnitId)},{FormatQty(item.FinalStock, item.UnitId)},{FormatAmount(item.TotalValue)} SRD");
        }
        await JS.InvokeVoidAsync("gfiDownloadTextFile", $"item-stock-report-{DateTime.Now:yyyyMMddHHmmss}.csv", sb.ToString(), "text/csv;charset=utf-8");
        Snackbar.Add("Report data exported as CSV.", Severity.Success);
    }

    private async Task ExportToPrintAsync()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportToPdfAsync()
    {
        Snackbar.Add("Tip: Choose 'Save as PDF' as the destination in the print window.", Severity.Info);
        await JS.InvokeVoidAsync("window.print");
    }

    // end of methods
}

