@page "/store/semi-finished-products/new"
@page "/store/semi-finished-products/edit/{Id:long}"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppSessionState SessionState
@inject IJSRuntime JS

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@(Id == 0 ? "New Semi-Finished Product" : "Edit Semi-Finished Product")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Manage master item details and inventory settings.</MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnBack">Back to List</MudButton>
    </MudStack>

    <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary" Outlined="true">
        <MudTabPanel Text="General Info" Icon="@Icons.Material.Filled.Info">
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <MudStack Spacing="4">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.ItemName" Label="Item Name" Required="true" Variant="Variant.Outlined" For="@(() => _model.ItemName)" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_model.ItemCode" Label="Item Code" Variant="Variant.Outlined" For="@(() => _model.ItemCode)" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_model.ShortName" Label="Short Name" Variant="Variant.Outlined" For="@(() => _model.ShortName)" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"        MaxItems="1000" T="ItemCategoryDto" Label="Category" Value="@(_categories.FirstOrDefault(x => x.ItemCatId == _model.ItemCatId))" ValueChanged="@((ItemCategoryDto val) => { _model.ItemCatId = val?.ItemCatId ?? 0; })" SearchFunc="@SearchCategories" ToStringFunc="@(x => x?.ItemCatName ?? "")" Variant="Variant.Outlined" Required="true" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"        MaxItems="1000" T="ItemTypeDto" Label="Item Type" Value="@(_types.FirstOrDefault(x => x.ItemTypeId == _model.MasterItemTypeId))" ValueChanged="@((ItemTypeDto val) => { _model.MasterItemTypeId = val?.ItemTypeId; })" SearchFunc="@SearchTypes" ToStringFunc="@(x => x?.ItemTypeName ?? "")" Variant="Variant.Outlined" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"        MaxItems="1000" T="UnitDto" Label="Base Unit" Value="@(_units.FirstOrDefault(x => x.UnitId == _model.PurchaseUnit))" ValueChanged="@((UnitDto val) => { _model.PurchaseUnit = val?.UnitId ?? 0; })" SearchFunc="@SearchBaseUnits" ToStringFunc="@(x => x?.UnitName ?? "")" Variant="Variant.Outlined" Required="true" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"        MaxItems="1000" T="BrandDto" Label="Brand" Value="@(_brands.FirstOrDefault(x => x.BrandId == _model.BrandId))" ValueChanged="@((BrandDto val) => { _model.BrandId = val?.BrandId ?? 0; })" SearchFunc="@SearchBrands" ToStringFunc="@(x => x?.BrandName ?? "")" Variant="Variant.Outlined" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"        MaxItems="1000" T="StatusDto" Label="Status" Value="@(_statuses.FirstOrDefault(x => x.StatusId == _model.StatusId))" ValueChanged="@((StatusDto val) => { _model.StatusId = (int)(val?.StatusId ?? 0); })" SearchFunc="@SearchStatuses" ToStringFunc="@(x => x?.StatusName ?? "")" Variant="Variant.Outlined" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_model.TentativeExpiryDays" Label="Tentative Expiry (Days)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Description" Label="Description" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
              @*       <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Tags" Label="Tags (Comma separated)" Variant="Variant.Outlined" />
                    </MudItem> *@
                </MudGrid>
                </MudPaper>
                </MudStack>
            </EditForm>
        </MudTabPanel>

        <MudTabPanel Text="Inventory Details" Icon="@Icons.Material.Filled.Inventory" Disabled="Id == 0">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.CurrentQuantity" Label="Current Quantity" Variant="Variant.Outlined" Disabled="true" Min="0" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.MaximumQuantity" Label="Maximum Quantity" Variant="Variant.Outlined" Min="0" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.CriticalLevelQuantity" Label="Critical Level Quantity" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.ReorderLevelQuantity" Label="Reorder Level Quantity" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.ReorderLevelDays" Label="Reorder Level (Days)" Variant="Variant.Outlined" Min="0" />
                </MudItem>

                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_details.CriticalLevelAlert" Label="Enable Critical Level Alert" Color="Color.Primary" />
                </MudItem>

            </MudGrid>
        </MudTabPanel>

        <MudTabPanel Text="Stock Batches" Icon="@Icons.Material.Filled.Layers" Disabled="Id == 0">
            <MudStack Spacing="4">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_batchModel.BatchNo" Label="Batch Number" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_batchModel.Quantity" Label="Quantity" Variant="Variant.Outlined" Min="0" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudAutocomplete Clearable="true"        MaxItems="1000" T="WarehouseLookupDto" @ref="_warehouseAutocomplete" Label="Warehouse" Value="@(_warehouses.FirstOrDefault(x => x.WarehouseId == _batchModel.WarehouseId))" ValueChanged="@((WarehouseLookupDto val) => { _batchModel.WarehouseId = (int)(val?.WarehouseId ?? 0); })" SearchFunc="@SearchWarehouses" ToStringFunc="@(x => x?.WarehouseName ?? "")" Variant="Variant.Outlined" Required="true" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker DateFormat="dd/MM/yyyy" Placeholder="dd/MM/yyyy" Editable="true"                @bind-Date="_batchModel.ExpiryDate" Label="Expiry Date (DD/MM/YYYY)" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudAutocomplete Clearable="true"        MaxItems="1000" T="UnitDto" @ref="_unitAutocomplete" Label="Unit" Value="@(_units.FirstOrDefault(x => x.UnitId == _batchModel.UnitId))" ValueChanged="@((UnitDto val) => { _batchModel.UnitId = (int)(val?.UnitId ?? 0); })" SearchFunc="@SearchBatchUnits" ToStringFunc="@(x => x?.UnitName ?? "")" Variant="Variant.Outlined" Required="true" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_batchModel.Amount" Label="Amount (SRD)" Variant="Variant.Outlined" Min="0" Adornment="Adornment.Start" AdornmentText="SRD" Format="N2" />
                        </MudItem>
                        <MudItem xs="12" md="4" Class="d-flex align-center justify-end gap-2">
                             <MudButton Variant="Variant.Outlined" OnClick="ResetBatchForm">Reset</MudButton>
                             <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveBatch" Loading="_savingBatch">@( _batchModel.ItemStockByBatchId == 0 ? "Add Batch" : "Update Batch")</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudTable Items="_batches" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Batch No</MudTh>
                        <MudTh>Quantity</MudTh>
                        <MudTh>Warehouse</MudTh>
                        <MudTh>Expiry</MudTh>
                        <MudTh>Amount (SRD)</MudTh>
                        <MudTh Style="text-align: center;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Batch">@context.BatchNo</MudTd>
                        <MudTd DataLabel="Qty">@context.Quantity @context.UnitName</MudTd>
                        <MudTd DataLabel="Warehouse">@context.WarehouseName</MudTd>
                        <MudTd DataLabel="Expiry">@context.ExpiryDate?.ToShortDateString()</MudTd>
                        <MudTd DataLabel="Amount">@context.Amount.ToString("N2") SRD</MudTd>
                        <MudTd Style="text-align: center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditBatch(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteBatch(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Recipe (BOM)" Icon="@Icons.Material.Filled.ReceiptLong" Disabled="Id == 0">
            <MudStack Spacing="4" Class="pt-6">
                <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudText Typo="Typo.h6">Product Recipes</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNewRecipe">
                        Create New Recipe
                    </MudButton>
                </MudStack>

                <MudTable Items="_recipes" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0" Loading="_loadingRecipes">
                    <HeaderContent>
                        <MudTh>Recipe Name</MudTh>
                        <MudTh Style="text-align: right;">Yield Qty</MudTh>
                        <MudTh>Unit</MudTh>
                        <MudTh Style="text-align: right;">Extra Expenses</MudTh>
                        <MudTh Style="text-align: center;">Status</MudTh>
                        <MudTh Style="text-align: center; width: 140px;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Recipe Name">@context.BomName</MudTd>
                        <MudTd DataLabel="Yield" Style="text-align: right;">@context.Quantity</MudTd>
                        <MudTd DataLabel="Unit">@context.UnitName</MudTd>
                        <MudTd DataLabel="Expenses" Style="text-align: right;">@context.ExtraExpensesPerPiece.ToString("N2")</MudTd>
                        <MudTd DataLabel="Status" Style="text-align: center;">
                            <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                                @(context.IsActive ? "Active" : "Inactive")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Action" Style="text-align: center;">
                            <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Title="Edit Recipe" OnClick="@(() => EditRecipe(context.BomId))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Info" Size="Size.Small" Title="Copy Recipe" OnClick="@(() => CopyRecipe(context.BomId))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="Delete Recipe" OnClick="@(() => DeleteRecipe(context))" />
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4">No Recipes defined for this semi-finished product yet.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudStack>
        </MudTabPanel>
    </MudTabs>

    <MudPaper Class="pa-4 mt-4" Outlined="true" Elevation="0">
        <div class="d-flex justify-end gap-2 flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => HandleSaveAction("stay"))" Loading="_savingGeneral || _savingDetails || _savingBatch">Save</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => HandleSaveAction("list"))" Loading="_savingGeneral || _savingDetails || _savingBatch">Save & Move to List</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@(() => HandleSaveAction("next"))" Loading="_savingGeneral || _savingDetails || _savingBatch">Save & Move to Next</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="@(() => HandleSaveAction("new"))" Loading="_savingGeneral || _savingDetails || _savingBatch">Save & Add New</MudButton>
        </div>
    </MudPaper>
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }
    [Parameter] [SupplyParameterFromQuery] public int? Tab { get; set; }

    private int _activeTabIndex;
    private EditContext? _editContext;
    private SaveSemiFinishedProductRequest _model = new();
    private SemiFinishedProductDetailDto _details = new();
    private SemiFinishedProductBatchDto _batchModel = new();
    private MudAutocomplete<WarehouseLookupDto> _warehouseAutocomplete;
    private MudAutocomplete<UnitDto> _unitAutocomplete;

    private List<ItemCategoryDto> _categories = new();
    private List<UnitDto> _units = new();
    private List<BrandDto> _brands = new();
    private List<StatusDto> _statuses = new();
    private List<WarehouseLookupDto> _warehouses = new();
    private List<SemiFinishedProductBatchDto> _batches = new();
    private List<BomDto> _recipes = new();
    private bool _loadingRecipes;
    private List<ItemTypeDto> _types = new();

    private bool _savingGeneral;
    private bool _savingDetails;
    private bool _savingBatch;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);

        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (Tab.HasValue)
        {
            _activeTabIndex = Tab.Value;
        }

        await LoadLookups();

        if (Id > 0)
        {
            await LoadData();
        }
        else
        {
            _model.StatusId = 0;
            _model.ItemTypeId = 2; // Pre-processed/Semi-finished
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
        }
    }

    private async Task LoadLookups()
    {
        try
        {
            var cats = await ApiClient.GetItemCategoriesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _categories = cats.Items.Where(x => x.IsActive).OrderBy(x => x.ItemCatName).ToList();

            var types = await ApiClient.GetItemTypesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _types = types.Items.Where(x => x.IsActive).OrderBy(x => x.ItemTypeName).ToList();

            var units = await ApiClient.GetUnitsAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _units = units.Items.Where(x => x.IsActive).OrderBy(x => x.UnitName).ToList();

            var brands = await ApiClient.GetBrandsAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _brands = brands.Items.Where(x => x.IsActive).OrderBy(x => x.BrandName).ToList();

            var statuses = await ApiClient.GetStatusesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _statuses = statuses.Items.Where(x => x.IsActive).OrderBy(x => x.StatusName).ToList();

            _warehouses = (await ApiClient.GetWarehousesLookupAsync()).OrderBy(x => x.WarehouseName).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadData()
    {
        try
        {
            var item = await ApiClient.GetSemiFinishedProductByIdAsync(Id);
            if (item != null)
            {
                _model = new SaveSemiFinishedProductRequest
                {
                    ItemId = item.ItemId,
                    ItemName = item.ItemName,
                    ItemCode = item.ItemCode,
                    ShortName = item.ShortName,
                    IsActive = item.IsActive,
                    ItemCatId = item.ItemCatId,
                    ItemTypeId = 2, // Force Type ID 2
                    StatusId = item.StatusId,
                    Description = item.Description,
                    StorageDetails = item.StorageDetails,
                    Tags = item.Tags,
                    TentativeExpiryDays = item.TentativeExpiryDays,
                    PurchaseUnit = item.PurchaseUnit,
                    BrandId = item.BrandId,
                    CreatedBy = item.CreatedBy,
                    MasterItemTypeId = item.MasterItemTypeId
                };
                _editContext = new EditContext(_model);
            }

            var details = await ApiClient.GetSemiFinishedProductDetailAsync(Id);
            if (details != null) _details = details;

            _batches = (await ApiClient.GetSemiFinishedProductBatchesAsync(Id)).ToList();
            await LoadRecipesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading item data: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadRecipesAsync()
    {
        if (Id <= 0) return;
        _loadingRecipes = true;
        try
        {
            var result = await ApiClient.GetBomsAsync(new BomListRequest
            {
                ItemId = Id,
                ItemTypeId = (int)MasterItemType.SemiFinished,
                PageNumber = 1,
                PageSize = 1000
            });
            _recipes = result.Items.Where(x => x.ItemId == Id && x.ItemTypeId == (long)MasterItemType.SemiFinished).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading Recipes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingRecipes = false;
        }
    }

    private void CreateNewRecipe() => Navigation.NavigateTo($"/store/bom/new?itemId={Id}&itemTypeId=2&returnUrl=/store/semi-finished-products/edit/{Id}");
    private void EditRecipe(long bomId) => Navigation.NavigateTo($"/store/bom/edit/{bomId}?returnUrl=/store/semi-finished-products/edit/{Id}");
    private void CopyRecipe(long bomId) => Navigation.NavigateTo($"/store/bom/new?copyFromId={bomId}&itemId={Id}&itemTypeId=2&returnUrl=/store/semi-finished-products/edit/{Id}");

    private async Task DeleteRecipe(BomDto recipe)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete Recipe '{recipe.BomName}'?");
        if (!confirmed) return;

        try
        {
            var success = await ApiClient.DeleteBomAsync(recipe.BomId, SessionState.CurrentUserAuditName ?? "System");
            if (success)
            {
                Snackbar.Add("Recipe deleted successfully.", Severity.Success);
                await LoadRecipesAsync();
            }
            else
            {
                Snackbar.Add("Cannot delete Recipe because it is currently linked to production entries or other records.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting Recipe: {ex.Message}", Severity.Error);
        }
    }

    private async Task<bool> SaveGeneralInfo()
    {
        if (_model.TentativeExpiryDays < 0)
        {
            Snackbar.Add("Tentative expiry days cannot be negative.", Severity.Warning);
            return false;
        }

        _savingGeneral = true;
        try
        {
            _model.ItemTypeId = 2; // Force Type ID 2
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            var newItemId = await ApiClient.SaveSemiFinishedProductAsync(_model);
            var wasNew = Id == 0;
            if (wasNew)
            {
                Id = newItemId;
            }
            Snackbar.Add(wasNew ? "Item created successfully." : "General info updated successfully.", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving item: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingGeneral = false;
        }
    }

    private async Task HandleSaveAction(string action)
    {
        bool saveSuccess = false;
        var wasNew = Id == 0;
        
        if (_activeTabIndex == 0)
        {
            if (_editContext != null && !_editContext.Validate())
            {
                Snackbar.Add("Please fix the validation errors on the form.", Severity.Warning);
                return;
            }
            saveSuccess = await SaveGeneralInfo();
        }
        else if (_activeTabIndex == 1)
        {
            saveSuccess = await SaveInventoryDetails();
        }
        else if (_activeTabIndex == 2)
        {
            if (_batchModel.WarehouseId != 0)
            {
                saveSuccess = await SaveBatch();
            }
            else
            {
                saveSuccess = true;
            }
        }

        if (saveSuccess)
        {
            if (action == "list")
            {
                Navigation.NavigateTo("/store/semi-finished-products");
            }
            else if (action == "new")
            {
                Navigation.NavigateTo("/store/semi-finished-products/new", forceLoad: true);
            }
            else if (action == "next")
            {
                if (_activeTabIndex < 2)
                {
                    if (wasNew)
                    {
                        Navigation.NavigateTo($"/store/semi-finished-products/edit/{Id}?tab={_activeTabIndex + 1}", forceLoad: true);
                    }
                    else
                    {
                        _activeTabIndex++;
                    }
                }
                else
                {
                    Snackbar.Add("All steps completed. Moving to list view.", Severity.Info);
                    Navigation.NavigateTo("/store/semi-finished-products");
                }
            }
            else if (wasNew)
            {
                Navigation.NavigateTo($"/store/semi-finished-products/edit/{Id}");
            }
        }
    }

    private async Task<bool> SaveInventoryDetails()
    {
        _details.OpeningQuantity = 0;
        if (_details.MaximumQuantity < 0 || _details.CriticalLevelQuantity < 0 || _details.ReorderLevelQuantity < 0 || _details.ReorderLevelDays < 0)
        {
            Snackbar.Add("Stock-related values cannot be negative.", Severity.Warning);
            return false;
        }

        _savingDetails = true;
        try
        {
            _details.ItemId = Id;
            await ApiClient.SaveSemiFinishedProductDetailAsync(_details);
            Snackbar.Add("Inventory details saved successfully.", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving details: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingDetails = false;
        }
    }

    private async Task<bool> SaveBatch()
    {
        if (_batchModel.WarehouseId == 0)
        {
            Snackbar.Add("Please select a warehouse.", Severity.Warning);
            return false;
        }

        if (_batchModel.Quantity < 0)
        {
            Snackbar.Add("Quantity cannot be negative.", Severity.Warning);
            return false;
        }

        if (_batchModel.ExpiryDate.HasValue && _batchModel.ExpiryDate.Value.Date < DateTime.Today)
        {
            Snackbar.Add("Expiry date cannot be from the past.", Severity.Warning);
            return false;
        }

        _savingBatch = true;
        try
        {
            _batchModel.ItemId = Id;
            _batchModel.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            if (_batchModel.UnitId <= 0)
            {
                _batchModel.UnitId = _model.PurchaseUnit > 0 ? (int)_model.PurchaseUnit : (int)(_units.FirstOrDefault()?.UnitId ?? 0);
            }

            await ApiClient.SaveSemiFinishedProductBatchAsync(_batchModel);
            Snackbar.Add("Batch saved successfully.", Severity.Success);
            _batches = (await ApiClient.GetSemiFinishedProductBatchesAsync(Id)).ToList();
            await ResetBatchForm();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving batch: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingBatch = false;
        }
    }

    private void EditBatch(SemiFinishedProductBatchDto batch)
    {
        _batchModel = new SemiFinishedProductBatchDto
        {
            ItemStockByBatchId = batch.ItemStockByBatchId,
            ItemId = batch.ItemId,
            WarehouseId = batch.WarehouseId,
            Quantity = batch.Quantity,
            UnitId = batch.UnitId,
            BatchNo = batch.BatchNo,
            Amount = batch.Amount,
            ExpiryDate = batch.ExpiryDate
        };
    }

    private async Task ResetBatchForm()
    {
        _batchModel = new SemiFinishedProductBatchDto
        {
            UnitId = _model.PurchaseUnit > 0 ? (int)_model.PurchaseUnit : (int)(_units.FirstOrDefault()?.UnitId ?? 0),
            Amount = 0
        };
    }

    private async Task DeleteBatch(SemiFinishedProductBatchDto batch)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete batch '{batch.BatchNo}' with quantity {batch.Quantity}?");
        if (!confirmed) return;

        _savingBatch = true;
        try
        {
            batch.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            var result = await ApiClient.SaveSemiFinishedProductBatchAsync(batch, batch.ItemStockByBatchId.ToString());
            if (result < 0)
            {
                throw new Exception("REFERENCE constraint conflict occurred during batch deletion.");
            }
            Snackbar.Add("Batch deleted successfully.", Severity.Success);
            _batches = (await ApiClient.GetSemiFinishedProductBatchesAsync(Id)).ToList();
        }
        catch (Exception ex)
        {
            var message = ex.Message;
            if (message.Contains("REFERENCE constraint") || message.Contains("conflict") || message.Contains("FK_Inv_PurchaseChildBatches_Inv_ItemStockByBatch") || message.Contains("Inv_ItemStockUsed"))
            {
                Snackbar.Add("Cannot delete this batch because it has already been used/linked in consumption or purchase transactions.", Severity.Error);
            }
            else
            {
                Snackbar.Add($"Error deleting batch: {ex.Message}", Severity.Error);
            }
        }
        finally
        {
            _savingBatch = false;
        }
    }

    private void OnBack() => Navigation.NavigateTo("/store/semi-finished-products");

    private async Task<IEnumerable<ItemCategoryDto>> SearchCategories(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _categories.Any(x => (x.ItemCatName ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _categories;
        return _categories.Where(x => (x.ItemCatName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }

