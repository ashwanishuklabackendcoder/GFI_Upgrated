@page "/store/finished-products/new"
@page "/store/finished-products/edit/{Id:long}"
@page "/admin/finished-products/new"
@page "/admin/finished-products/edit/{Id:long}"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppSessionState SessionState
@inject IJSRuntime JS

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@(Id == 0 ? "New Finished Product" : "Edit Finished Product")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Manage finished product details and inventory settings.</MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnBack">Back to List</MudButton>
    </MudStack>

    <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary" Outlined="true">
        <MudTabPanel Text="General Info" Icon="@Icons.Material.Filled.Info">
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <MudStack Spacing="4">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.ItemName" Label="Product Name" Required="true" Variant="Variant.Outlined" For="@(() => _model.ItemName)" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_model.ItemCode" Label="Product Code" Variant="Variant.Outlined" For="@(() => _model.ItemCode)" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_model.ShortName" Label="Short Name" Variant="Variant.Outlined" For="@(() => _model.ShortName)" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"          MaxItems="1000" T="ItemCategoryDto" Label="Category" Value="@(_categories.FirstOrDefault(x => x.ItemCatId == _model.ItemCatId))" ValueChanged="@((ItemCategoryDto val) => { _model.ItemCatId = val?.ItemCatId ?? 0; })" SearchFunc="@SearchCategories" ToStringFunc="@(x => x?.ItemCatName ?? "")" Variant="Variant.Outlined" Required="true" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"          MaxItems="1000" T="ItemTypeDto" Label="Item Type" 
                                         Value="@(_types.FirstOrDefault(x => x.ItemTypeId == _model.MasterItemTypeId))" 
                                         ValueChanged="@((ItemTypeDto val) => { _model.MasterItemTypeId = val?.ItemTypeId; })" 
                                         SearchFunc="@SearchTypes" ToStringFunc="@(x => x?.ItemTypeName ?? "")"
                                         Variant="Variant.Outlined" 
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"          MaxItems="1000" T="UnitDto" Label="Base Unit" 
                                         Value="@(_units.FirstOrDefault(x => x.UnitId == _model.PurchaseUnit))" 
                                         ValueChanged="@((UnitDto val) => { _model.PurchaseUnit = val?.UnitId ?? 0; })" 
                                         SearchFunc="@SearchBaseUnits" ToStringFunc="@(x => x?.UnitName ?? "")"
                                         Variant="Variant.Outlined" Required="true" 
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"          MaxItems="1000" T="BrandDto" Label="Brand" Value="@(_brands.FirstOrDefault(x => x.BrandId == _model.BrandId))" ValueChanged="@((BrandDto val) => { _model.BrandId = val?.BrandId ?? 0; })" SearchFunc="@SearchBrands" ToStringFunc="@(x => x?.BrandName ?? "")" Variant="Variant.Outlined" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudAutocomplete Clearable="true"          MaxItems="1000" T="StatusDto" Label="Status" 
                                         Value="@(_statuses.FirstOrDefault(x => x.StatusId == _model.StatusId))" 
                                         ValueChanged="@((StatusDto val) => { _model.StatusId = (int)(val?.StatusId ?? 0); })" 
                                         SearchFunc="@SearchStatuses" ToStringFunc="@(x => x?.StatusName ?? "")"
                                         Variant="Variant.Outlined" 
                                         ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_model.TentativeExpiryDays" Label="Tentative Expiry (Days)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Description" Label="Description" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
           @*          <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Tags" Label="Tags (Comma separated)" Variant="Variant.Outlined" />
                    </MudItem> *@
                </MudGrid>
             </MudPaper>
                </MudStack>
            </EditForm>
        </MudTabPanel>

        <MudTabPanel Text="Inventory Details" Icon="@Icons.Material.Filled.Inventory" Disabled="Id == 0">
            <MudStack Spacing="4">
<MudPaper Class="pa-4" Outlined="true" Elevation="0">
            <MudGrid>
                        <MudItem xs="12">
                            <MudCheckBox @bind-Value="_details.CriticalLevelAlert" Label="Enable Critical Level Alert" Color="Color.Primary" />
                        </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_details.CurrentQuantity" Label="Current Quantity" Variant="Variant.Outlined" Disabled="true" Min="0" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_details.MaximumQuantity" Label="Maximum Quantity" Variant="Variant.Outlined" Min="0" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.CriticalLevelQuantity" Label="Critical Level Quantity" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.ReorderLevelQuantity" Label="Reorder Level Quantity" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.ReorderLevelDays" Label="Reorder Level (Days)" Variant="Variant.Outlined" Min="0" />
                </MudItem>

              

            </MudGrid>
            </MudPaper></MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Pricing/Vendors" Icon="@Icons.Material.Filled.People" Disabled="Id == 0">
            <MudStack Spacing="4">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Add/Edit Product Price</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudAutocomplete Clearable="true"          MaxItems="1000" T="AccountLookupDto" Label="Account/Customer" Value="@(_accounts.FirstOrDefault(x => x.AccountId == _vendorModel.VendorAccountId))" ValueChanged="@((AccountLookupDto val) => { _vendorModel.VendorAccountId = (int)(val?.AccountId ?? 0); })" SearchFunc="@SearchAccounts" ToStringFunc="@(x => x?.AccountName ?? "")" Variant="Variant.Outlined" Required="true" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_vendorModel.PurchasePrice" Label="Price" Variant="Variant.Outlined" Format="N2" Min="0" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudAutocomplete Clearable="true"          MaxItems="1000" T="CurrencyLookupDto" Label="Currency" 
                                             Value="@(_currencies.FirstOrDefault(x => x.CurrencyId == _vendorModel.CurrencyId))" 
                                             ValueChanged="@((CurrencyLookupDto val) => { _vendorModel.CurrencyId = val?.CurrencyId ?? 0; })" 
                                             SearchFunc="@SearchCurrencies" ToStringFunc="@(x => x?.CurrencyName ?? "")"
                                             Variant="Variant.Outlined" 
                                             ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudDatePicker Editable="true" DateFormat="dd/MM/yyyy" Placeholder="dd/MM/yyyy"                      @bind-Date="_vendorModel.StartDate" Label="Start Date (DD/MM/YYYY)" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker Editable="true" DateFormat="dd/MM/yyyy" Placeholder="dd/MM/yyyy"                      @bind-Date="_vendorModel.EndDate" Label="End Date (DD/MM/YYYY)" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudAutocomplete Clearable="true"          MaxItems="1000" T="StatusDto" Label="Price Status" 
                                             Value="@(_statuses.FirstOrDefault(x => x.StatusId == _vendorModel.StatusId))" 
                                             ValueChanged="@((StatusDto val) => { _vendorModel.StatusId = (int)(val?.StatusId ?? 0); })" 
                                             SearchFunc="@SearchStatuses" ToStringFunc="@(x => x?.StatusName ?? "")"
                                             Variant="Variant.Outlined" 
                                             ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end gap-2">
                            <MudButton Variant="Variant.Outlined" OnClick="ResetVendorForm">Reset</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveVendor" Loading="_savingVendor">@( _vendorModel.ItemVendorId == 0 ? "Add Price" : "Update Price")</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudTable Items="_vendors" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Account Name</MudTh>
                        <MudTh>Price</MudTh>
                        <MudTh>Currency</MudTh>
                        <MudTh>Date Range</MudTh>
                        <MudTh Style="text-align: center;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Account">@context.VendorName</MudTd>
                        <MudTd DataLabel="Price">@context.PurchasePrice.ToString("N2")</MudTd>
                        <MudTd DataLabel="Currency">@(_currencies.FirstOrDefault(c => c.CurrencyId == context.CurrencyId)?.CurrencyName ?? "N/A")</MudTd>
                        <MudTd DataLabel="Dates">@(context.StartDate?.ToShortDateString() ?? "-") to @(context.EndDate?.ToShortDateString() ?? "-")</MudTd>
                        <MudTd Style="text-align: center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditVendor(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Stock Batches" Icon="@Icons.Material.Filled.Layers" Disabled="Id == 0">
            <MudStack Spacing="4">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_batchModel.BatchNo" Label="Batch Number" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_batchModel.Quantity" Label="Quantity" Variant="Variant.Outlined" Min="0" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudAutocomplete Clearable="true"          MaxItems="1000" T="WarehouseLookupDto" Label="Warehouse" 
                                             Value="@(_warehouses.FirstOrDefault(x => x.WarehouseId == _batchModel.WarehouseId))" 
                                             ValueChanged="@((WarehouseLookupDto val) => { _batchModel.WarehouseId = (int)(val?.WarehouseId ?? 0); })" 
                                             SearchFunc="@SearchWarehouses" ToStringFunc="@(x => x?.WarehouseName ?? "")"
                                             Variant="Variant.Outlined" Required="true" 
                                             ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker Editable="true" DateFormat="dd/MM/yyyy" Placeholder="dd/MM/yyyy"                      @bind-Date="_batchModel.ExpiryDate" Label="Expiry Date (DD/MM/YYYY)" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="8" Class="d-flex align-center justify-end gap-2">
                             <MudButton Variant="Variant.Outlined" OnClick="ResetBatchForm">Reset</MudButton>
                             <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveBatch" Loading="_savingBatch">@( _batchModel.ItemStockByBatchId == 0 ? "Add Batch" : "Update Batch")</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudTable Items="_batches" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Batch No</MudTh>
                        <MudTh>Quantity</MudTh>
                        <MudTh>Warehouse</MudTh>
                        <MudTh>Expiry</MudTh>
                        <MudTh Style="text-align: center;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Batch">@context.BatchNo</MudTd>
                        <MudTd DataLabel="Qty">@context.Quantity</MudTd>
                        <MudTd DataLabel="Warehouse">@context.WarehouseName</MudTd>
                        <MudTd DataLabel="Expiry">@context.ExpiryDate?.ToShortDateString()</MudTd>
                        <MudTd Style="text-align: center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditBatch(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteBatch(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Recipe (BOM)" Icon="@Icons.Material.Filled.ReceiptLong" Disabled="Id == 0">
            <MudStack Spacing="4" Class="pt-6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudText Typo="Typo.h6">Product Recipes</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNewRecipe">
                        Create New Recipe
                    </MudButton>
                </MudStack>

                <MudTable Items="_recipes" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0" Loading="_loadingRecipes">
                    <HeaderContent>
                        <MudTh>Recipe Name</MudTh>
                        <MudTh Style="text-align: right;">Yield Qty</MudTh>
                        <MudTh>Unit</MudTh>
                        <MudTh Style="text-align: right;">Extra Expenses</MudTh>
                        <MudTh Style="text-align: center;">Status</MudTh>
                        <MudTh Style="text-align: center; width: 140px;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Recipe Name">@context.BomName</MudTd>
                        <MudTd DataLabel="Yield" Style="text-align: right;">@context.Quantity</MudTd>
                        <MudTd DataLabel="Unit">@context.UnitName</MudTd>
                        <MudTd DataLabel="Expenses" Style="text-align: right;">@context.ExtraExpensesPerPiece.ToString("N2")</MudTd>
                        <MudTd DataLabel="Status" Style="text-align: center;">
                            <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                                @(context.IsActive ? "Active" : "Inactive")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Action" Style="text-align: center;">
                            <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Title="Edit Recipe" OnClick="@(() => EditRecipe(context.BomId))" />
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Info" Size="Size.Small" Title="Copy Recipe" OnClick="@(() => CopyRecipe(context.BomId))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="Delete Recipe" OnClick="@(() => DeleteRecipe(context))" />
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-4">No Recipes defined for this finished product yet.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudStack>
        </MudTabPanel>
    </MudTabs>

    <MudPaper Class="pa-4 mt-4" Outlined="true" Elevation="0">
        <div class="d-flex justify-end gap-2 flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => HandleSaveAction("stay"))" Loading="_savingGeneral || _savingDetails || _savingVendor || _savingBatch">Save</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => HandleSaveAction("list"))" Loading="_savingGeneral || _savingDetails || _savingVendor || _savingBatch">Save & Move to List</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@(() => HandleSaveAction("next"))" Loading="_savingGeneral || _savingDetails || _savingVendor || _savingBatch">Save & Move to Next</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="@(() => HandleSaveAction("new"))" Loading="_savingGeneral || _savingDetails || _savingVendor || _savingBatch">Save & Add New</MudButton>
        </div>
    </MudPaper>
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }
    [Parameter] [SupplyParameterFromQuery] public int? Tab { get; set; }

    private int _activeTabIndex;
    private EditContext? _editContext;
    private SaveFinishedProductRequest _model = new();
    private FinishedProductDetailDto _details = new();
    private FinishedProductVendorDto _vendorModel = new() { StatusId = 1, CurrencyId = 1 };
    private FinishedProductBatchDto _batchModel = new();
    private MudAutocomplete<WarehouseLookupDto> _warehouseAutocomplete;

    private List<ItemCategoryDto> _categories = new();
    private List<UnitDto> _units = new();
    private List<BrandDto> _brands = new();
    private List<StatusDto> _statuses = new();
    private List<AccountLookupDto> _accounts = new();
    private List<WarehouseLookupDto> _warehouses = new();
    private List<CurrencyLookupDto> _currencies = new();
    private List<FinishedProductVendorDto> _vendors = new();
    private List<FinishedProductBatchDto> _batches = new();
    private List<BomDto> _recipes = new();
    private bool _loadingRecipes;
    private List<ItemTypeDto> _types = new();

    private bool _savingGeneral;
    private bool _savingDetails;
    private bool _savingVendor;
    private bool _savingBatch;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);

        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (Tab.HasValue)
        {
            _activeTabIndex = Tab.Value;
        }

        await LoadLookups();

        if (Id > 0)
        {
            await LoadData();
        }
        else
        {
            _model.StatusId = 0;
            _model.ItemTypeId = 1; // Finished Product
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
        }
    }

    private async Task LoadLookups()
    {
        try
        {
            var cats = await ApiClient.GetItemCategoriesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _categories = cats.Items.Where(x => x.IsActive).OrderBy(x => x.ItemCatName).ToList();

            var types = await ApiClient.GetItemTypesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _types = types.Items.Where(x => x.IsActive).OrderBy(x => x.ItemTypeName).ToList();

            var units = await ApiClient.GetUnitsAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _units = units.Items.Where(x => x.IsActive).OrderBy(x => x.UnitName).ToList();

            var brands = await ApiClient.GetBrandsAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _brands = brands.Items.Where(x => x.IsActive).OrderBy(x => x.BrandName).ToList();

            var statuses = await ApiClient.GetStatusesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _statuses = statuses.Items.Where(x => x.IsActive).OrderBy(x => x.StatusName).ToList();

            _accounts = (await ApiClient.GetAccountsLookupAsync()).OrderBy(x => x.AccountName).ToList();
            _warehouses = (await ApiClient.GetWarehousesLookupAsync()).OrderBy(x => x.WarehouseName).ToList();
            _currencies = (await ApiClient.GetCurrenciesLookupAsync()).OrderBy(x => x.CurrencyName).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadData()
    {
        try
        {
            var item = await ApiClient.GetFinishedProductByIdAsync(Id);
            if (item != null)
            {
                _model = new SaveFinishedProductRequest
                {
                    ItemId = item.ItemId,
                    ItemName = item.ItemName,
                    ItemCode = item.ItemCode,
                    ShortName = item.ShortName,
                    IsActive = item.IsActive,
                    ItemCatId = item.ItemCatId,
                    ItemTypeId = item.ItemTypeId,
                    StatusId = item.StatusId,
                    Description = item.Description,
                    StorageDetails = item.StorageDetails,
                    Tags = item.Tags,
                    TentativeExpiryDays = item.TentativeExpiryDays,
                    PurchaseUnit = item.PurchaseUnit,
                    BrandId = item.BrandId,
                    CreatedBy = item.CreatedBy,
                    MasterItemTypeId = item.MasterItemTypeId
                };
                _editContext = new EditContext(_model);
            }

            var details = await ApiClient.GetFinishedProductDetailAsync(Id);
            if (details != null) _details = details;

            _vendors = (await ApiClient.GetFinishedProductVendorsAsync(Id)).ToList();
            _batches = (await ApiClient.GetFinishedProductBatchesAsync(Id)).ToList();
            await LoadRecipesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading product data: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadRecipesAsync()
    {
        if (Id <= 0) return;
        _loadingRecipes = true;
        try
        {
            var result = await ApiClient.GetBomsAsync(new BomListRequest
            {
                ItemId = Id,
                ItemTypeId = (int)MasterItemType.FinishedProduct,
                PageNumber = 1,
                PageSize = 1000
            });
            _recipes = result.Items.Where(x => x.ItemId == Id && x.ItemTypeId == (long)MasterItemType.FinishedProduct).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading Recipes: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingRecipes = false;
        }
    }

    private void CreateNewRecipe() => Navigation.NavigateTo($"/store/bom/new?itemId={Id}&itemTypeId=1&returnUrl=/store/finished-products/edit/{Id}");
    private void EditRecipe(long bomId) => Navigation.NavigateTo($"/store/bom/edit/{bomId}?returnUrl=/store/finished-products/edit/{Id}");
    private void CopyRecipe(long bomId) => Navigation.NavigateTo($"/store/bom/new?copyFromId={bomId}&itemId={Id}&itemTypeId=1&returnUrl=/store/finished-products/edit/{Id}");

    private async Task DeleteRecipe(BomDto recipe)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete Recipe '{recipe.BomName}'?");
        if (!confirmed) return;

        try
        {
            var success = await ApiClient.DeleteBomAsync(recipe.BomId, SessionState.CurrentUserAuditName ?? "System");
            if (success)
            {
                Snackbar.Add("Recipe deleted successfully.", Severity.Success);
                await LoadRecipesAsync();
            }
            else
            {
                Snackbar.Add("Cannot delete Recipe because it is currently linked to production entries or other records.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting Recipe: {ex.Message}", Severity.Error);
        }
    }

    private async Task<bool> SaveGeneralInfo()
    {
        _savingGeneral = true;
        try
        {
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            var newItemId = await ApiClient.SaveFinishedProductAsync(_model);
            var wasNew = Id == 0;
            if (wasNew)
            {
                Id = newItemId;
            }
            Snackbar.Add(wasNew ? "Product created successfully." : "General info updated successfully.", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving product: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingGeneral = false;
        }
    }

    private async Task HandleSaveAction(string action)
    {
        bool saveSuccess = false;
        var wasNew = Id == 0;
        
        if (_activeTabIndex == 0)
        {
            if (_editContext != null && !_editContext.Validate())
            {
                Snackbar.Add("Please fix the validation errors on the form.", Severity.Warning);
                return;
            }
            saveSuccess = await SaveGeneralInfo();
        }
        else if (_activeTabIndex == 1)
        {
            saveSuccess = await SaveInventoryDetails();
        }
        else if (_activeTabIndex == 2)
        {
            if (_vendorModel.VendorAccountId != 0)
            {
                saveSuccess = await SaveVendor();
            }
            else
            {
                saveSuccess = true;
            }
        }
        else if (_activeTabIndex == 3)
        {
            if (_batchModel.WarehouseId != 0)
            {
                saveSuccess = await SaveBatch();
            }
            else
            {
                saveSuccess = true;
            }
        }

        if (saveSuccess)
        {
            if (action == "list")
            {
                Navigation.NavigateTo("/store/finished-products");
            }
            else if (action == "new")
            {
                Navigation.NavigateTo("/store/finished-products/new", forceLoad: true);
            }
            else if (action == "next")
            {
                if (_activeTabIndex < 3)
                {
                    if (wasNew)
                    {
                        Navigation.NavigateTo($"/store/finished-products/edit/{Id}?tab={_activeTabIndex + 1}", forceLoad: true);
                    }
                    else
                    {
                        _activeTabIndex++;
                    }
                }
                else
                {
                    Snackbar.Add("All steps completed. Moving to list view.", Severity.Info);
                    Navigation.NavigateTo("/store/finished-products");
                }
            }
            else if (wasNew)
            {
                Navigation.NavigateTo($"/store/finished-products/edit/{Id}");
            }
        }
    }

    private async Task<bool> SaveInventoryDetails()
    {
        _details.OpeningQuantity = 0;
        if (_details.MaximumQuantity < 0 || _details.CriticalLevelQuantity < 0 || _details.ReorderLevelQuantity < 0 || _details.ReorderLevelDays < 0)
        {
            Snackbar.Add("Stock-related values cannot be negative.", Severity.Warning);
            return false;
        }

        _savingDetails = true;
        try
        {
            _details.ItemId = Id;
            await ApiClient.SaveFinishedProductDetailAsync(_details);
            Snackbar.Add("Inventory details saved successfully.", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving details: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingDetails = false;
        }
    }

    private async Task<bool> SaveVendor()
    {
        if (_vendorModel.VendorAccountId == 0)
        {
            Snackbar.Add("Please select an account.", Severity.Warning);
            return false;
        }

        if (!_vendorModel.StartDate.HasValue || !_vendorModel.EndDate.HasValue)
        {
            Snackbar.Add("Start Date and End Date are required.", Severity.Warning);
            return false;
        }

        if (_vendorModel.EndDate.Value.Date < DateTime.Today)
        {
            Snackbar.Add("End Date cannot be from the past.", Severity.Warning);
            return false;
        }

        if (_vendorModel.EndDate.Value.Date < _vendorModel.StartDate.Value.Date)
        {
            Snackbar.Add("End Date must always be later than the Start Date.", Severity.Warning);
            return false;
        }

        if (_vendorModel.EndDate.Value.Date == _vendorModel.StartDate.Value.Date)
        {
            Snackbar.Add("Start Date and End Date should not be the same.", Severity.Warning);
            return false;
        }

        _savingVendor = true;
        try
        {
            _vendorModel.ItemId = Id;
            _vendorModel.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            if (_vendorModel.PurchaseUnit == 0) _vendorModel.PurchaseUnit = (decimal)_model.PurchaseUnit;

            await ApiClient.SaveFinishedProductVendorAsync(_vendorModel);
            Snackbar.Add("Pricing saved successfully.", Severity.Success);
            _vendors = (await ApiClient.GetFinishedProductVendorsAsync(Id)).ToList();
            ResetVendorForm();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving price: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingVendor = false;
        }
    }

