@page "/store/preprocessing/view/{Id:long}"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject AdminSecurityApiClient AdminApiClient
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject AppSessionState SessionState
@inject IJSRuntime JS

<PageTitle>View Pre-Processing</PageTitle>

<MudPaper Class="pa-4 mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h5">View Pre-Processing</MudText>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnBack">Back</MudButton>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_header == null)
{
    <MudAlert Severity="Severity.Error">Pre-Processing record not found.</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">@_header.ItemName</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="Processing Date" Value="@FormatDate(_header.ProcessingDate)" ReadOnly="true" />
                <MudTextField T="string" Label="Batch Number Made" Value="@_header.BatchNumberMade" ReadOnly="true" />
                <MudTextField T="string" Label="Process Employees" Value="@_employeeNames" ReadOnly="true" />
                <MudTextField T="string" Label="Warehouse" Value="@_warehouseName" ReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="BOM / Product Name" Value="@_bomName" ReadOnly="true" />
                <MudTextField T="string" Label="Quantity Made" Value="@($"{_header.QuantityMade} {_header.UnitName}")" ReadOnly="true" />
                <MudTextField T="string" Label="Expiry Date" Value="@FormatDate(_header.ExpiryDate)" ReadOnly="true" />
                <MudTextField T="string" Label="Remarks" Value="@_header.Remarks" ReadOnly="true" />
                <MudTextField T="string" Label="Total Ingredient Value" Value="@SessionState.FormatCurrency(_items.Sum(x => x.Amount))" ReadOnly="true" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-4">Ingredients / Stock Used as of @FormatDate(_header.ProcessingDate)</MudText>
        <MudTable Items="_items" Hover="true" Dense="true" Striped="true" Bordered="true">
            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Item Name</MudTh>
                <MudTh>Batch No</MudTh>
                <MudTh>Supplier</MudTh>
                <MudTh Style="text-align: right;">Quantity Used</MudTh>
                <MudTh Style="text-align: right;">Amount (SRD)</MudTh>
                <MudTh>Description</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Date">@(context.TransactionDate?.ToString("MM/dd/yyyy") ?? "N/A")</MudTd>
                <MudTd DataLabel="Item Name">@context.ItemName</MudTd>
                <MudTd DataLabel="Batch No">@context.BatchNo</MudTd>
                <MudTd DataLabel="Supplier">@context.SupplierName</MudTd>
                <MudTd DataLabel="Quantity Used" Style="text-align: right;">@context.Quantity @context.UnitName</MudTd>
                <MudTd DataLabel="Amount" Style="text-align: right;">@context.Amount.ToString("N2")</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="pa-4">No ingredients recorded.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public long Id { get; set; }
    
    private bool _loading = true;
    private PreProcessingDto? _header;
    private List<PreProcessingItemDto> _items = new();
    private string _bomName = string.Empty;
    private string _warehouseName = string.Empty;
    private string _employeeNames = string.Empty;

    private string FormatDate(string? dateString)
    {
        if (string.IsNullOrWhiteSpace(dateString)) return string.Empty;
        if (DateTime.TryParse(dateString, out var dt))
        {
            return dt.ToString("MM/dd/yyyy");
        }
        return dateString;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
            _header = await ApiClient.GetPreProcessingByIdAsync(Id);
            if (_header != null)
            {
                var boms = await ApiClient.GetBomsLookupAsync();
                var whs = await ApiClient.GetWarehousesLookupAsync();
                _bomName = boms.FirstOrDefault(b => b.BomId == _header.BomId)?.BomName ?? "Unknown";
                _warehouseName = whs.FirstOrDefault(w => w.WarehouseId == _header.WarehouseId)?.WarehouseName ?? "Unknown";
                
                try
                {
                    var activeStaff = await AdminApiClient.GetActiveStaffAsync();
                    if (!string.IsNullOrWhiteSpace(_header.ProcessEmployees))
                    {
                        var ids = _header.ProcessEmployees.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim());
                        var names = activeStaff.Where(s => ids.Contains(s.StaffId.ToString())).Select(s => s.StaffName);
                        _employeeNames = names.Any() ? string.Join(", ", names) : _header.ProcessEmployees;
                    }
                }
                catch
                {
                    _employeeNames = _header.ProcessEmployees ?? string.Empty;
                }
                
                var itemsResult = await ApiClient.GetPreProcessingItemsAsync(Id);
                _items = itemsResult.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading pre-processing data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}
