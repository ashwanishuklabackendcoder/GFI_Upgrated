@page "/store/bom/new"
@page "/store/bom/edit/{Id:long}"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject GFI_Upgrated.UI.State.AppSessionState SessionState

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@(Id == 0 ? "New Recipe" : "Edit Recipe")</MudText>
            @* <MudText Typo="Typo.body2" Color="Color.Secondary">Define the recipe and components for your products.</MudText> *@
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnBack">Back</MudButton>
    </MudStack>

    <EditForm Model="_model" OnValidSubmit="SaveBom">
        <DataAnnotationsValidator />
        <MudGrid>
            <!-- Header Section -->
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2">Recipe Configuration</MudText>
                <MudDivider Class="mb-4" />
            </MudItem>



            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.BomName" Label="Recipe Name" Required="true" Variant="Variant.Outlined" For="@(() => _model.BomName)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <SearchableSelect T="MasterItemType?" Label="Recipe Target Type" Value="@((MasterItemType?)_model.ItemTypeId)" ValueChanged="OnBomTypeChanged" Variant="Variant.Outlined" Required="true" AnchorOrigin="Origin.BottomCenter" Items="_bomTypes" />
            </MudItem>
            <MudItem xs="12" md="4">
                <SearchableSelect T="long" Label="Parent Product" 
                                  Value="@_model.ItemId"
                                  ValueChanged="OnParentProductIdChanged"
                                  Variant="Variant.Outlined" Required="true"
                                  Items="@GetParentProductItems()" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField @bind-Value="_model.Quantity" Label="Yield Quantity" Variant="Variant.Outlined" Min="0.0001" Step="0.01" Format="0.##" For="@(() => _model.Quantity)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <SearchableSelect T="long" Label="Yield Unit" 
                                  Value="@_model.UnitId" 
                                  ValueChanged="@((long val) => { _model.UnitId = val; })"
                                  Variant="Variant.Outlined" Required="true"
                                  Items="@GetYieldUnitItems()" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField @bind-Value="_model.ExtraExpensesPerPiece" Label="Extra Expenses" Variant="Variant.Outlined" Format="@($"N{SessionState.DecimalDigits}")" />
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center">
                <MudCheckBox @bind-Value="_model.IsActive" Label="Is Active" Color="Color.Primary" />
            </MudItem>

            <!-- Components Section -->
            <MudItem xs="12" Class="mt-6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">Components (Recipe Items)</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddRow">Add Component</MudButton>
                </MudStack>
                <MudDivider Class="mb-4" />

                <MudTable Items="_model.Items" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0" Context="itemContext">
                    <HeaderContent>
                        <MudTh style="width: 45%;">Component Item</MudTh>
                        <MudTh Style="width: 100px;">Quantity</MudTh>
                        <MudTh Style="width: 280px;">Unit</MudTh>
                        <MudTh Style="text-align: center; width: 80px;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Item">
                            <SearchableSelect T="long" 
                                              Value="@itemContext.ItemID" 
                                              ValueChanged="@((long v) => OnComponentIdChanged(itemContext, v))"
                                              Variant="Variant.Text" 
                                              Items="@GetComponentItems()" />
                        </MudTd>
                        <MudTd DataLabel="Qty">
                            <MudNumericField @bind-Value="itemContext.Quantity" Variant="Variant.Text" Min="0.0001" Step="0.01" Format="0.##" Dense="true" />
                        </MudTd>
                        <MudTd DataLabel="Unit">
                            <SearchableSelect T="long" 
                                              Value="@itemContext.UnitId" 
                                              ValueChanged="@((long val) => { itemContext.UnitId = val; })"
                                              Variant="Variant.Text" 
                                              Items="@GetUnitsForComponent(itemContext.ItemID)" />
                        </MudTd>
                        <MudTd Style="text-align: center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveRow(itemContext))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                @if (!_model.Items.Any())
                {
                    <MudAlert Severity="Severity.Info" Class="mt-2">No components added. Click 'Add Component' to start building the recipe.</MudAlert>
                }
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end mt-6 gap-2">
                
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Loading="_saving">Save</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="OnBack">Cancel</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }

    [SupplyParameterFromQuery(Name = "copyFromId")] public long? CopyFromId { get; set; }
    [SupplyParameterFromQuery(Name = "itemId")] public long? TargetItemId { get; set; }
    [SupplyParameterFromQuery(Name = "itemTypeId")] public long? TargetItemTypeId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private static readonly List<SearchableSelect<MasterItemType?>.SelectItemDto<MasterItemType?>> _bomTypes = new()
    {
        new() { Value = MasterItemType.FinishedProduct, Text = "Finished Product" },
        new() { Value = MasterItemType.SemiFinished, Text = "Semi-Finished" }
    };

    private SaveBomRequest _model = new() { Quantity = 1 };
    private RawMaterialDto? _selectedParent;
    private List<UnitDto> _units = new();
    private List<RawMaterialDto> _allProducts = new();
    private List<RawMaterialDto> _allComponents = new();
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (Id > 0)
        {
            await LoadData();
        }
        else if (CopyFromId.HasValue && CopyFromId.Value > 0)
        {
            await LoadCopyData(CopyFromId.Value);
        }
        else
        {
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            _model.ItemTypeId = TargetItemTypeId ?? (long)MasterItemType.FinishedProduct;
            if (TargetItemId.HasValue && TargetItemId.Value > 0)
            {
                _model.ItemId = TargetItemId.Value;
            }
        }

        await LoadLookups();

        if (_model.ItemId > 0 && _selectedParent == null && _allProducts.Any())
        {
            _selectedParent = _allProducts.FirstOrDefault(p => p.ItemId == _model.ItemId);
        }
    }

    private async Task LoadCopyData(long copyFromId)
    {
        try
        {
            var bom = await ApiClient.GetBomByIdAsync(copyFromId);
            if (bom != null)
            {
                _model = new SaveBomRequest
                {
                    BomId = 0,
                    ItemId = bom.ItemId,
                    BomName = string.IsNullOrWhiteSpace(bom.BomName) ? "Copy Recipe" : $"{bom.BomName} - Copy",
                    Quantity = bom.Quantity,
                    UnitId = bom.UnitId,
                    ExtraExpensesPerPiece = bom.ExtraExpensesPerPiece,
                    IsActive = true,
                    CreatedBy = SessionState.CurrentUserAuditName ?? "System",
                    ItemTypeId = bom.ItemTypeId
                };

                var p1 = await ApiClient.GetItemsForBomLookupAsync(1);
                var p2 = await ApiClient.GetItemsForBomLookupAsync(2);
                var allPotentialParents = p1.Concat(p2).ToList();
                _selectedParent = allPotentialParents.FirstOrDefault(p => p.ItemId == bom.ItemId);

                if (_selectedParent != null)
                {
                    _allProducts = (_model.ItemTypeId == 2 ? p2 : p1).OrderBy(x => x.ItemName).ToList();
                }

                var items = await ApiClient.GetBomComponentsAsync(copyFromId);
                _model.Items = items.Select(i => new BomItemDto
                {
                    BomItemsId = 0,
                    BomId = 0,
                    ItemID = i.ItemID,
                    ItemName = i.ItemName,
                    Quantity = i.Quantity,
                    UnitId = i.UnitId,
                    UnitName = i.UnitName
                }).ToList();

                Snackbar.Add("Recipe details copied. Click 'Save Recipe' to create a new recipe.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error copying Recipe: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadLookups()
    {
        try
        {
            var units = await ApiClient.GetUnitsAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _units = units.Items.Where(x => x.IsActive).ToList();

            // Load parent products based on the selected BOM type
            if (_model.ItemTypeId > 0)
            {
                _allProducts = (await ApiClient.GetItemsForBomLookupAsync((int)_model.ItemTypeId)).OrderBy(x => x.ItemName).ToList();
            }

            if (_model.ItemId > 0)
            {
                _selectedParent = _allProducts.FirstOrDefault(p => p.ItemId == _model.ItemId);
                if (_selectedParent != null && _model.UnitId == 0 && _selectedParent.PurchaseUnit > 0)
                {
                    _model.UnitId = (long)_selectedParent.PurchaseUnit;
                }
            }

            // Components: Raw Materials (3) and Semi-Finished (2)
            var rawMaterials = await ApiClient.GetItemsForBomLookupAsync(3);
            var semiFinished = await ApiClient.GetItemsForBomLookupAsync(2);
            _allComponents = rawMaterials.Concat(semiFinished).OrderBy(x => x.ItemName).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnBomTypeChanged(MasterItemType? newType)
    {
        _model.ItemTypeId = newType.HasValue ? (long)newType.Value : 0;
        _selectedParent = null;
        _model.ItemId = 0;
        if (newType.HasValue)
        {
            try
            {
                _allProducts = (await ApiClient.GetItemsForBomLookupAsync((int)newType.Value)).OrderBy(x => x.ItemName).ToList();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error loading parent items: {ex.Message}", Severity.Error);
            }
        }
        else
        {
            _allProducts.Clear();
        }
    }

    private async Task LoadData()
    {
        try
        {
            var bom = await ApiClient.GetBomByIdAsync(Id);
            if (bom != null)
            {
                _model = new SaveBomRequest
                {
                    BomId = bom.BomId,
                    ItemId = bom.ItemId,
                    BomName = bom.BomName,
                    Quantity = bom.Quantity,
                    UnitId = bom.UnitId,
                    ExtraExpensesPerPiece = bom.ExtraExpensesPerPiece,
                    IsActive = bom.IsActive,
                    CreatedBy = bom.CreatedBy,
                    ItemTypeId = bom.ItemTypeId
                };
                
                var p1 = await ApiClient.GetItemsForBomLookupAsync(1);
                var p2 = await ApiClient.GetItemsForBomLookupAsync(2);
                var allPotentialParents = p1.Concat(p2).ToList();
                _selectedParent = allPotentialParents.FirstOrDefault(p => p.ItemId == bom.ItemId);
                
                if (_selectedParent != null)
                {
                    _allProducts = (_model.ItemTypeId == 2 ? p2 : p1).OrderBy(x => x.ItemName).ToList();
                }
                
                var items = await ApiClient.GetBomComponentsAsync(Id);
                _model.Items = items.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading Recipe: {ex.Message}", Severity.Error);
        }
    }

    private async Task<IEnumerable<RawMaterialDto>> SearchParentProducts(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _allProducts;
        return _allProducts.Where(x => x.ItemName?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
    }

    private async Task<IEnumerable<RawMaterialDto>> SearchComponents(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _allComponents;
        return _allComponents.Where(x => x.ItemName?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
    }

    private RawMaterialDto? GetItemById(long id) => _allComponents.FirstOrDefault(x => x.ItemId == id);

    private void OnComponentChanged(BomItemDto row, RawMaterialDto? item)
    {
        if (item != null)
        {
            row.ItemID = item.ItemId;
            row.ItemName = item.ItemName;
            // Default to base unit of item if possible, but here we just keep existing or default
        }
    }

    private void AddRow()
    {
        _model.Items.Add(new BomItemDto { Quantity = 1, UnitId = _units.FirstOrDefault()?.UnitId ?? 0 });
    }

    private void RemoveRow(BomItemDto row)
    {
        _model.Items.Remove(row);
    }

    private async Task SaveBom()
    {
        if (string.IsNullOrWhiteSpace(_model.BomName))
        {
            Snackbar.Add("Please enter a Recipe Name.", Severity.Warning);
            return;
        }

        if (_selectedParent == null)
        {
            Snackbar.Add("Please select a parent product.", Severity.Warning);
            return;
        }

        if (_model.UnitId <= 0)
        {
            Snackbar.Add("Please select a Yield Unit.", Severity.Warning);
            return;
        }

        // Validate all items have an item selected
        if (_model.Items.Any(i => i.ItemID == 0))
        {
            Snackbar.Add("All components must have an item selected.", Severity.Warning);
            return;
        }

        if (!_model.Items.Any())
        {
            Snackbar.Add("Please add at least one component.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            _model.ItemId = _selectedParent.ItemId;
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            
            var resultId = await ApiClient.SaveBomAsync(_model);
            if (resultId > 0)
            {
                Snackbar.Add("Recipe saved successfully.", Severity.Success);
                if (!string.IsNullOrWhiteSpace(ReturnUrl))
                {
                    Navigation.NavigateTo(ReturnUrl);
                }
                else if (Id == 0)
                {
                    Navigation.NavigateTo($"/store/bom/edit/{resultId}");
                }
                else
                {
                    // Reload data on same page to confirm components
                    await LoadData();
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving Recipe: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(ReturnUrl);
        }
        else
        {
            Navigation.NavigateTo("/store/bom");
        }
    }

    private async Task<IEnumerable<UnitDto>> SearchUnits(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _units;
        return _units.Where(x => x.UnitName?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
    }

    private async Task<IEnumerable<UnitDto>> SearchBaseUnits(string value, CancellationToken token)
    {
        var baseUnits = _units.Where(x => x.BaseUnit == null);
        if (string.IsNullOrEmpty(value)) return baseUnits;
        return baseUnits.Where(x => (x.UnitName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<UnitDto>> SearchUnitsForProduct(long itemId, string value, CancellationToken token)
    {
        var item = _allComponents.FirstOrDefault(x => x.ItemId == itemId);
        if (item == null) return _units;
        var purchaseUnit = item.PurchaseUnit;
        var filtered = _units.Where(x => x.UnitId == purchaseUnit || x.BaseUnit == purchaseUnit);
        if (string.IsNullOrEmpty(value)) return filtered;
        return filtered.Where(x => (x.UnitName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetParentProductItems()
    {
        return _allProducts.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.ItemId,
            Text = x.ItemName ?? ""
        });
    }

    private void OnParentProductIdChanged(long itemId)
    {
        _model.ItemId = itemId;
        _selectedParent = _allProducts.FirstOrDefault(x => x.ItemId == itemId);
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetYieldUnitItems()
    {
        return _units.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.UnitId,
            Text = x.UnitName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetComponentItems()
    {
        return _allComponents.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.ItemId,
            Text = x.ItemName ?? ""
        });
    }

    private void OnComponentIdChanged(BomItemDto row, long itemId)
    {
        row.ItemID = itemId;
        var item = GetItemById(itemId);
        if (item != null)
        {
            row.ItemName = item.ItemName;
        }
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetUnitsForComponent(long itemId)
    {
        var item = _allComponents.FirstOrDefault(x => x.ItemId == itemId);
        if (item == null) 
        {
            return _units.Select(x => new SearchableSelect<long>.SelectItemDto<long> { Value = x.UnitId, Text = x.UnitName ?? "" });
        }
        var purchaseUnit = item.PurchaseUnit;
        var filtered = _units.Where(x => x.UnitId == purchaseUnit || x.BaseUnit == purchaseUnit);
        return filtered.Select(x => new SearchableSelect<long>.SelectItemDto<long> { Value = x.UnitId, Text = x.UnitName ?? "" });
    }
}



