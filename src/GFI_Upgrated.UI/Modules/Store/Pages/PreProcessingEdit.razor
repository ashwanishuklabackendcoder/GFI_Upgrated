@page "/store/preprocessing/new"
@page "/store/preprocessing/edit/{Id:long}"
@page "/admin/preprocessing/new"
@page "/admin/preprocessing/edit/{Id:long}"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject AdminSecurityApiClient SecurityApiClient
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject GFI_Upgrated.UI.State.AppSessionState SessionState

<PageTitle>@(_isEdit ? "Edit Pre-Processing" : "New Pre-Processing")</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@(_isEdit ? "Edit Semi Finished Run" : "New Semi Finished Run")</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="2">
            @if (_isEdit)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.ListAlt" OnClick="@(() => NavigationManager.NavigateTo($"/store/preprocessing/items/{Id}"))">Manage Ingredients</MudButton>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnCancel">Back</MudButton>
        </MudStack>
    </MudStack>

    <EditForm Model="_editor" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <MudGrid>
            <MudItem xs="12" md="6">
                <SearchableSelect T="long" Label="Select BOM" Value="@_editor.BomId" ValueChanged="OnBomIdChanged" Variant="Variant.Outlined" Required="true" Items="@GetBomSelects()" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="double" Value="_editor.BomQty" ValueChanged="@((double val) => OnBomQtyChanged(val))" Label="BOM Quantity" Variant="Variant.Outlined" Min="0" Format="@($"N{SessionState.DecimalDigits}")" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudDatePicker DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Editable="true" Date="_editor.ProcessingDate" DateChanged="OnProcessingDateChanged" Label="@($"Processing Date ({SessionState.DateFormat})")" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_editor.QuantityMade" Label="Actual Quantity Made" Min="0" Variant="Variant.Outlined" Format="@($"N{SessionState.DecimalDigits}")" />
            </MudItem>
            <MudItem xs="12" md="4">
                <SearchableSelect T="long" Label="Unit" Value="@_editor.UnitMade" ValueChanged="@((long val) => { _editor.UnitMade = val; })" Variant="Variant.Outlined" Items="@GetUnitSelects()" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_editor.BatchNumberMade" Label="Batch Number" Variant="Variant.Outlined" HelperText="Leave blank for auto-generation" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Editable="true"                         @bind-Date="_editor.ExpiryDate" Label="@($"Expiry Date ({SessionState.DateFormat})")" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" md="6">
                <SearchableSelect T="long" Label="Storage Warehouse" Value="@_editor.WarehouseId" ValueChanged="@((long val) => { _editor.WarehouseId = val; })" Variant="Variant.Outlined" Required="true" Items="@GetWarehouseSelects()" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SearchableSelect T="string" Label="Process Employees" MultiSelection="true" SelectedValues="@_selectedEmployees" SelectedValuesChanged="@((vals) => { _selectedEmployees = vals; })" MultiSelectionTextFunc="@(x => string.Join(", ", x.Select(idStr => _staffList.FirstOrDefault(s => s.StaffId.ToString() == idStr)?.StaffName ?? idStr)))" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Items="@GetEmployeeSelects()" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="_editor.Remarks" Label="Remarks" Variant="Variant.Outlined" Lines="2" />
            </MudItem>

            <MudItem xs="12" Class="pt-4">
                <MudStack Row="true" Spacing="2">
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="_processing">
                        @(_processing ? "Saving..." : (_isEdit ? "Update Header" : "Create Header & Add Stock"))
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="OnCancel" Disabled="_processing">Cancel</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public long? Id { get; set; }
    private bool _isEdit => Id.HasValue && Id.Value > 0;
    private SavePreProcessingRequest _editor = new() { ProcessingDate = DateTime.Today, ExpiryDate = DateTime.Today.AddYears(1) };
    private List<BomLookupDto> _boms = new();
    private List<WarehouseLookupDto> _warehouses = new();
    private List<UnitLookupDto> _units = new();
    private List<StaffLookupDto> _staffList = new();
    private IReadOnlyCollection<string> _selectedEmployees { get; set; } = new HashSet<string>();
    private bool _processing;
    private double _selectedBomYield = 1.0;



    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadLookupsAsync();

        if (_isEdit)
        {
            var selected = await ApiClient.GetPreProcessingByIdAsync(Id!.Value);
            if (selected is not null)
            {
                _editor.PreProcessingId = selected.PreProcessingId;
                _editor.BomId = selected.BomId;
                _editor.BomQty = selected.BomQty;
                _editor.ProcessingDate = DateTime.TryParse(selected.ProcessingDate, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var pd) ? pd : DateTime.Today;
                _editor.QuantityMade = selected.QuantityMade;
                _editor.UnitMade = selected.UnitMade;
                _editor.BatchNumberMade = selected.BatchNumberMade;
                _editor.ExpiryDate = DateTime.TryParse(selected.ExpiryDate, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var ed) ? ed : DateTime.Today.AddYears(1);
                _editor.ProcessEmployees = selected.ProcessEmployees;
                if (!string.IsNullOrWhiteSpace(selected.ProcessEmployees))
                {
                    _selectedEmployees = selected.ProcessEmployees.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList();
                }
                _editor.Remarks = selected.Remarks;
                _editor.DocumentUpload = selected.DocumentUpload;
                _editor.WarehouseId = selected.WarehouseId;

                var bomDetails = await ApiClient.GetBomByIdAsync(selected.BomId);
                if (bomDetails != null)
                {
                    _selectedBomUnitId = bomDetails.UnitId;
                    _selectedBomYield = bomDetails.Quantity;
                }
            }
        }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var bomsTask = ApiClient.GetBomsLookupAsync();
            var whTask = ApiClient.GetWarehousesLookupAsync();
            var unitsTask = ApiClient.GetUnitsLookupAsync();
            var staffTask = SecurityApiClient.GetActiveStaffAsync();

            await Task.WhenAll(bomsTask, whTask, unitsTask, staffTask);

            _boms = (await bomsTask).ToList();
            if (_editor.BomId > 0)
            {
                var bomDetails = await ApiClient.GetBomByIdAsync(_editor.BomId);
                if (bomDetails != null)
                {
                    _selectedBomUnitId = bomDetails.UnitId;
                }
            }
            _warehouses = (await whTask).ToList();
            _units = (await unitsTask).ToList();
            _staffList = (await staffTask).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveAsync()
    {
        if (_editor.BomId == 0) { Snackbar.Add("Please select a BOM.", Severity.Warning); return; }
        if (_editor.WarehouseId == 0) { Snackbar.Add("Please select a Warehouse.", Severity.Warning); return; }

        if (_editor.ExpiryDate.HasValue && _editor.ExpiryDate.Value.Date < DateTime.Today)
        {
            Snackbar.Add("Expiry date cannot be in the past.", Severity.Warning);
            return;
        }

        _processing = true;
        try
        {
            _editor.ProcessEmployees = string.Join(",", _selectedEmployees);
            _editor.UpdatedBy = SessionState.CurrentUserAuditName ?? "System";
            var result = await ApiClient.SavePreProcessingAsync(_editor);
            if (result > 0)
            {
                Snackbar.Add("Pre-Processing header saved successfully.", Severity.Success);
                if (!_isEdit)
                {
                    // Navigate to Items management if new
                    NavigationManager.NavigateTo($"/store/preprocessing/items/{result}");
                }
                else
                {
                    NavigationManager.NavigateTo("/store/preprocessing");
                }
            }
            else
            {
                Snackbar.Add("Failed to save record.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _processing = false;
        }
    }

    private void OnCancel() => NavigationManager.NavigateTo("/store/preprocessing");

    private async Task<IEnumerable<BomLookupDto>> SearchBoms(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _boms;
        return _boms.Where(x => x.BomName?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
    }

    private long? _selectedBomUnitId;

    private async Task OnBomChanged(BomLookupDto val)
    {
        _editor.BomId = val?.BomId ?? 0;
        if (val != null)
        {
            var bomDetails = await ApiClient.GetBomByIdAsync(val.BomId);
            if (bomDetails != null)
            {
                _selectedBomUnitId = bomDetails.UnitId;
                _editor.UnitMade = bomDetails.UnitId;
                _selectedBomYield = bomDetails.Quantity;
                RecalculateQtyMade();
                if (bomDetails.TentativeExpiryDays > 0)
                {
                    _editor.ExpiryDate = (_editor.ProcessingDate ?? DateTime.Today).AddDays(bomDetails.TentativeExpiryDays);
                }
                else
                {
                    _editor.ExpiryDate = null;
                }
            }
        }
        else
        {
            _selectedBomUnitId = null;
            _editor.UnitMade = 0;
            _editor.ExpiryDate = null;
            _selectedBomYield = 1.0;
        }
    }


    private async Task<IEnumerable<UnitLookupDto>> SearchUnits(string value, CancellationToken token)
    {
        if (_selectedBomUnitId == null || _selectedBomUnitId <= 0) return _units;
        var filtered = _units.Where(x => x.UnitId == _selectedBomUnitId || x.BaseUnit == _selectedBomUnitId);
        if (string.IsNullOrEmpty(value)) return filtered;
        return filtered.Where(x => x.UnitName?.Contains(value, StringComparison.OrdinalIgnoreCase) == true);
    }

    private async Task OnBomIdChanged(long bomId)
    {
        var val = _boms.FirstOrDefault(x => x.BomId == bomId);
        _editor.BomId = bomId;
        if (val != null)
        {
            var bomDetails = await ApiClient.GetBomByIdAsync(val.BomId);
            if (bomDetails != null)
            {
                _selectedBomUnitId = bomDetails.UnitId;
                _editor.UnitMade = bomDetails.UnitId;
                _selectedBomYield = bomDetails.Quantity;
                RecalculateQtyMade();
                if (bomDetails.TentativeExpiryDays > 0)
                {
                    _editor.ExpiryDate = (_editor.ProcessingDate ?? DateTime.Today).AddDays(bomDetails.TentativeExpiryDays);
                }
                else
                {
                    _editor.ExpiryDate = null;
                }
            }
        }
        else
        {
            _selectedBomUnitId = null;
            _editor.UnitMade = 0;
            _editor.ExpiryDate = null;
            _selectedBomYield = 1.0;
        }
    }

    private void OnBomQtyChanged(double val)
    {
        _editor.BomQty = val;
        RecalculateQtyMade();
    }

    private void RecalculateQtyMade()
    {
        _editor.QuantityMade = Math.Round(_editor.BomQty * _selectedBomYield, 1);
    }


    private async Task OnProcessingDateChanged(DateTime? newDate)
    {
        _editor.ProcessingDate = newDate;
        if (_editor.BomId > 0)
        {
            var bomDetails = await ApiClient.GetBomByIdAsync(_editor.BomId);
            if (bomDetails != null && bomDetails.TentativeExpiryDays > 0)
            {
                _editor.ExpiryDate = (newDate ?? DateTime.Today).AddDays(bomDetails.TentativeExpiryDays);
            }
        }
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetBomSelects()
    {
        return _boms.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.BomId,
            Text = x.BomName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetUnitSelects()
    {
        var baseList = _units.AsEnumerable();
        if (_selectedBomUnitId != null && _selectedBomUnitId > 0)
        {
            baseList = _units.Where(x => x.UnitId == _selectedBomUnitId || x.BaseUnit == _selectedBomUnitId);
        }
        return baseList.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.UnitId,
            Text = x.UnitName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long>.SelectItemDto<long>> GetWarehouseSelects()
    {
        return _warehouses.Select(x => new SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.WarehouseId,
            Text = x.WarehouseName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<string>.SelectItemDto<string>> GetEmployeeSelects()
    {
        return _staffList.Select(x => new SearchableSelect<string>.SelectItemDto<string>
        {
            Value = x.StaffId.ToString(),
            Text = x.StaffName ?? ""
        });
    }
}



