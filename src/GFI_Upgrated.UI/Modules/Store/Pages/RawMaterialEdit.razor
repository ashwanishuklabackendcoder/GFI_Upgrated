@page "/store/rawmaterials/new"
@page "/store/rawmaterials/edit/{Id:long}"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppSessionState SessionState
@inject IJSRuntime JS

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@(Id == 0 ? "New Raw Material" : "Edit Raw Material")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Manage master item details and inventory settings.</MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnBack">Back to List</MudButton>
    </MudStack>

    <MudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary" Outlined="true">
        <MudTabPanel Text="General Info" Icon="@Icons.Material.Filled.Info">
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <MudStack Spacing="4">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.ItemName" Label="Item Name" Required="true" Variant="Variant.Outlined" For="@(() => _model.ItemName)" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_model.ItemCode" Label="Item Code" Variant="Variant.Outlined" For="@(() => _model.ItemCode)" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_model.ShortName" Label="Short Name" Variant="Variant.Outlined" For="@(() => _model.ShortName)" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudAutocomplete T="ItemCategoryDto" Label="Category" Value="@(_categories.FirstOrDefault(x => x.ItemCatId == _model.ItemCatId))" ValueChanged="@((ItemCategoryDto val) => _model.ItemCatId = val?.ItemCatId ?? 0)" SearchFunc="@SearchCategories" ToStringFunc="@(x => x?.ItemCatName ?? "")" Variant="Variant.Outlined" Required="true" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="long?" @bind-Value="_model.MasterItemTypeId" Label="Item Type" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="@((long?)null)">Select Type</MudSelectItem>
                            @foreach (var type in _types)
                            {
                                <MudSelectItem Value="@((long?)type.ItemTypeId)">@type.ItemTypeName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="long" @bind-Value="_model.PurchaseUnit" Label="Base Unit" Variant="Variant.Outlined" Required="true" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem Value="0L">Select Unit</MudSelectItem>
                            @foreach (var unit in _units)
                            {
                                <MudSelectItem Value="unit.UnitId">@unit.UnitName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudAutocomplete T="BrandDto" Label="Brand" Value="@(_brands.FirstOrDefault(x => x.BrandId == _model.BrandId))" ValueChanged="@((BrandDto val) => _model.BrandId = val?.BrandId ?? 0)" SearchFunc="@SearchBrands" ToStringFunc="@(x => x?.BrandName ?? "")" Variant="Variant.Outlined" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="int" @bind-Value="_model.StatusId" Label="Status" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                            @foreach (var status in _statuses)
                            {
                                <MudSelectItem Value="(int)status.StatusId">@status.StatusName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="_model.TentativeExpiryDays" Label="Tentative Expiry (Days)" Variant="Variant.Outlined" Min="0" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Description" Label="Description" Variant="Variant.Outlined" Lines="2" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Tags" Label="Tags (Comma separated)" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
                </MudPaper>
                </MudStack>
            </EditForm>
        </MudTabPanel>

        <MudTabPanel Text="Item Details" Icon="@Icons.Material.Filled.Inventory" Disabled="Id == 0">
            <MudStack Spacing="4">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.CurrentQuantity" Label="Current Quantity" Variant="Variant.Outlined" Disabled="true" Min="0" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.MaximumQuantity" Label="Maximum Quantity" Variant="Variant.Outlined" Min="0" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.CriticalLevelQuantity" Label="Critical Level Quantity" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.ReorderLevelQuantity" Label="Reorder Level Quantity" Variant="Variant.Outlined" Min="0" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_details.ReorderLevelDays" Label="Reorder Level (Days)" Variant="Variant.Outlined" Min="0" />
                </MudItem>

                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_details.CriticalLevelAlert" Label="Enable Critical Level Alert" Color="Color.Primary" />
                </MudItem>

            </MudGrid>
            </MudPaper>
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Suppliers" Icon="@Icons.Material.Filled.People" Disabled="Id == 0">
            <MudStack Spacing="4">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Add/Edit Suppliers Price</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudAutocomplete T="AccountLookupDto" Label="Supplier" Value="@(_accounts.FirstOrDefault(x => x.AccountId == _vendorModel.VendorAccountId))" ValueChanged="@((AccountLookupDto val) => _vendorModel.VendorAccountId = (int)(val?.AccountId ?? 0))" SearchFunc="@SearchAccounts" ToStringFunc="@(x => x?.AccountName ?? "")" Variant="Variant.Outlined" Required="true" ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_vendorModel.PurchasePrice" Label="Purchase Price" Variant="Variant.Outlined" Format="N2" Min="0" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="long" @bind-Value="_vendorModel.CurrencyId" Label="Currency" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                @foreach (var curr in _currencies)
                                {
                                    <MudSelectItem Value="curr.CurrencyId">@curr.CurrencyName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_vendorModel.StartDate" Label="Start Date" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_vendorModel.EndDate" Label="End Date" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="int" @bind-Value="_vendorModel.StatusId" Label="Price Status" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                @foreach (var status in _statuses)
                                {
                                    <MudSelectItem Value="(int)status.StatusId">@status.StatusName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" Class="d-flex justify-end gap-2">
                            <MudButton Variant="Variant.Outlined" OnClick="ResetVendorForm">Reset</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveVendor" Loading="_savingVendor">@( _vendorModel.ItemVendorId == 0 ? "Add Vendor" : "Update Vendor")</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudTable Items="_vendors" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Supplier Name</MudTh>
                        <MudTh>Price</MudTh>
                        <MudTh>Currency</MudTh>
                        <MudTh>Date Range</MudTh>
                        <MudTh Style="text-align: center;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Vendor">@context.VendorName</MudTd>
                        <MudTd DataLabel="Price">@context.PurchasePrice.ToString("N2")</MudTd>
                        <MudTd DataLabel="Currency">@(_currencies.FirstOrDefault(c => c.CurrencyId == context.CurrencyId)?.CurrencyName ?? "N/A")</MudTd>
                        <MudTd DataLabel="Dates">@(context.StartDate?.ToShortDateString() ?? "-") to @(context.EndDate?.ToShortDateString() ?? "-")</MudTd>
                        <MudTd Style="text-align: center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditVendor(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="Opening Stock" Icon="@Icons.Material.Filled.Layers" Disabled="Id == 0">
            <MudStack Spacing="4">
                <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_batchModel.BatchNo" Label="Batch Number" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_batchModel.Quantity" Label="Quantity" Variant="Variant.Outlined" Min="0" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="int" @bind-Value="_batchModel.WarehouseId" Label="Warehouse" Variant="Variant.Outlined" Required="true" AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem Value="0">Select Warehouse</MudSelectItem>
                                @foreach (var wh in _warehouses)
                                {
                                    <MudSelectItem Value="(int)wh.WarehouseId">@wh.WarehouseName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_batchModel.ExpiryDate" Label="Expiry Date" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="int" @bind-Value="_batchModel.UnitId" Label="Unit" Variant="Variant.Outlined" Required="true" AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem Value="0">Select Unit</MudSelectItem>
                                @foreach (var unit in _units)
                                {
                                    <MudSelectItem Value="(int)unit.UnitId">@unit.UnitName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4" Class="d-flex align-center justify-end gap-2">
                             <MudButton Variant="Variant.Outlined" OnClick="ResetBatchForm">Reset</MudButton>
                             <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveBatch" Loading="_savingBatch">@( _batchModel.ItemStockByBatchId == 0 ? "Add Batch" : "Update Batch")</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <MudTable Items="_batches" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Batch No</MudTh>
                        <MudTh>Quantity</MudTh>
                        @* <MudTh>Unit</MudTh> *@
                        <MudTh>Warehouse</MudTh>
                        <MudTh>Expiry</MudTh>
                        <MudTh Style="text-align: center;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Batch">@context.BatchNo</MudTd>
                        <MudTd DataLabel="Qty">@context.Quantity @context.UnitName</MudTd>
                        @* <MudTd DataLabel="Unit">@context.UnitName</MudTd> *@
                        <MudTd DataLabel="Warehouse">@context.WarehouseName</MudTd>
                        <MudTd DataLabel="Expiry">@context.ExpiryDate?.ToShortDateString()</MudTd>
                        <MudTd Style="text-align: center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditBatch(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteBatch(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudStack>
        </MudTabPanel>
    </MudTabs>

    <MudPaper Class="pa-4 mt-4" Outlined="true" Elevation="0">
        <div class="d-flex justify-end gap-2 flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => HandleSaveAction("stay"))" Loading="_savingGeneral || _savingDetails || _savingVendor || _savingBatch">Save</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => HandleSaveAction("list"))" Loading="_savingGeneral || _savingDetails || _savingVendor || _savingBatch">Save & Move to List</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@(() => HandleSaveAction("next"))" Loading="_savingGeneral || _savingDetails || _savingVendor || _savingBatch">Save & Move to Next</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="@(() => HandleSaveAction("new"))" Loading="_savingGeneral || _savingDetails || _savingVendor || _savingBatch">Save & Add New</MudButton>
        </div>
    </MudPaper>
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }
    [Parameter] [SupplyParameterFromQuery] public int? Tab { get; set; }

    private int _activeTabIndex;
    private EditContext? _editContext;
    private SaveRawMaterialRequest _model = new();
    private RawMaterialDetailDto _details = new();
    private RawMaterialVendorDto _vendorModel = new() { StatusId = 1, CurrencyId = 1 };
    private RawMaterialBatchDto _batchModel = new();

    private List<ItemCategoryDto> _categories = new();
    private List<ItemTypeDto> _types = new();
    private List<UnitDto> _units = new();
    private List<BrandDto> _brands = new();
    private List<StatusDto> _statuses = new();
    private List<AccountLookupDto> _accounts = new();
    private List<WarehouseLookupDto> _warehouses = new();
    private List<CurrencyLookupDto> _currencies = new();
    private List<RawMaterialVendorDto> _vendors = new();
    private List<RawMaterialBatchDto> _batches = new();

    private bool _savingGeneral;
    private bool _savingDetails;
    private bool _savingVendor;
    private bool _savingBatch;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);

        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (Tab.HasValue)
        {
            _activeTabIndex = Tab.Value;
        }

        await LoadLookups();

        if (Id > 0)
        {
            await LoadData();
        }
        else
        {
            _model.StatusId = 1;
            _model.ItemTypeId = 3; // Raw Material
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
        }
    }

    private async Task LoadLookups()
    {
        try
        {
            var cats = await ApiClient.GetItemCategoriesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _categories = cats.Items.Where(x => x.IsActive).OrderBy(x => x.ItemCatName).ToList();

            var types = await ApiClient.GetItemTypesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _types = types.Items.Where(x => x.IsActive).OrderBy(x => x.ItemTypeName).ToList();

            var units = await ApiClient.GetUnitsAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _units = units.Items.Where(x => x.IsActive).OrderBy(x => x.UnitName).ToList();

            var brands = await ApiClient.GetBrandsAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _brands = brands.Items.Where(x => x.IsActive).OrderBy(x => x.BrandName).ToList();

            var statuses = await ApiClient.GetStatusesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _statuses = statuses.Items.Where(x => x.IsActive).OrderBy(x => x.StatusName).ToList();

            _accounts = (await ApiClient.GetAccountsLookupAsync()).OrderBy(x => x.AccountName).ToList();
            _warehouses = (await ApiClient.GetWarehousesLookupAsync()).OrderBy(x => x.WarehouseName).ToList();
            _currencies = (await ApiClient.GetCurrenciesLookupAsync()).OrderBy(x => x.CurrencyName).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadData()
    {
        try
        {
            var item = await ApiClient.GetRawMaterialByIdAsync(Id);
            if (item != null)
            {
                _model = new SaveRawMaterialRequest
                {
                    ItemId = item.ItemId,
                    ItemName = item.ItemName,
                    ItemCode = item.ItemCode,
                    ShortName = item.ShortName,
                    IsActive = item.IsActive,
                    ItemCatId = item.ItemCatId,
                    ItemTypeId = item.ItemTypeId,
                    StatusId = item.StatusId,
                    Description = item.Description,
                    StorageDetails = item.StorageDetails,
                    Tags = item.Tags,
                    TentativeExpiryDays = item.TentativeExpiryDays,
                    PurchaseUnit = item.PurchaseUnit,
                    BrandId = item.BrandId,
                    CreatedBy = item.CreatedBy
                };
                _editContext = new EditContext(_model);
            }

            var details = await ApiClient.GetRawMaterialDetailAsync(Id);
            if (details != null) _details = details;

            _vendors = (await ApiClient.GetRawMaterialVendorsAsync(Id)).ToList();
            _batches = (await ApiClient.GetRawMaterialBatchesAsync(Id)).ToList();
            ResetBatchForm();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading item data: {ex.Message}", Severity.Error);
        }
    }

    private async Task<bool> SaveGeneralInfo()
    {
        if (_model.TentativeExpiryDays < 0)
        {
            Snackbar.Add("Tentative expiry days cannot be negative.", Severity.Warning);
            return false;
        }

        _savingGeneral = true;
        try
        {
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            var newItemId = await ApiClient.SaveRawMaterialAsync(_model);
            var wasNew = Id == 0;
            if (wasNew)
            {
                Id = newItemId;
            }
            Snackbar.Add(wasNew ? "Item created successfully." : "General info updated successfully.", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving item: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingGeneral = false;
        }
    }

    private async Task HandleSaveAction(string action)
    {
        bool saveSuccess = false;
        var wasNew = Id == 0;
        
        if (_activeTabIndex == 0)
        {
            if (_editContext != null && !_editContext.Validate())
            {
                Snackbar.Add("Please fix the validation errors on the form.", Severity.Warning);
                return;
            }
            saveSuccess = await SaveGeneralInfo();
        }
        else if (_activeTabIndex == 1)
        {
            saveSuccess = await SaveInventoryDetails();
        }
        else if (_activeTabIndex == 2)
        {
            if (_vendorModel.VendorAccountId != 0)
            {
                saveSuccess = await SaveVendor();
            }
            else
            {
                saveSuccess = true;
            }
        }
        else if (_activeTabIndex == 3)
        {
            if (_batchModel.WarehouseId != 0 && _batchModel.UnitId != 0)
            {
                saveSuccess = await SaveBatch();
            }
            else
            {
                saveSuccess = true;
            }
        }

        if (saveSuccess)
        {
            if (action == "list")
            {
                Navigation.NavigateTo("/store/rawmaterials");
            }
            else if (action == "new")
            {
                Navigation.NavigateTo("/store/rawmaterials/new", forceLoad: true);
            }
            else if (action == "next")
            {
                if (_activeTabIndex < 3)
                {
                    if (wasNew)
                    {
                        Navigation.NavigateTo($"/store/rawmaterials/edit/{Id}?tab={_activeTabIndex + 1}", forceLoad: true);
                    }
                    else
                    {
                        _activeTabIndex++;
                    }
                }
                else
                {
                    Snackbar.Add("All steps completed. Moving to list view.", Severity.Info);
                    Navigation.NavigateTo("/store/rawmaterials");
                }
            }
            else if (wasNew)
            {
                Navigation.NavigateTo($"/store/rawmaterials/edit/{Id}");
            }
        }
    }

    private async Task<bool> SaveInventoryDetails()
    {
        _details.OpeningQuantity = 0;
        if (_details.MaximumQuantity < 0 || _details.CriticalLevelQuantity < 0 || _details.ReorderLevelQuantity < 0 || _details.ReorderLevelDays < 0)
        {
            Snackbar.Add("Stock-related values cannot be negative.", Severity.Warning);
            return false;
        }

        _savingDetails = true;
        try
        {
            _details.ItemId = Id;
            await ApiClient.SaveRawMaterialDetailAsync(_details);
            Snackbar.Add("Inventory details saved successfully.", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving details: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingDetails = false;
        }
    }

    private async Task<bool> SaveVendor()
    {
        if (_vendorModel.VendorAccountId == 0)
        {
            Snackbar.Add("Please select a supplier.", Severity.Warning);
            return false;
        }

        if (_vendorModel.PurchasePrice < 0)
        {
            Snackbar.Add("Purchase price cannot be negative.", Severity.Warning);
            return false;
        }

        if (_vendorModel.EndDate.HasValue && _vendorModel.EndDate.Value.Date < DateTime.Today)
        {
            Snackbar.Add("End Date cannot be from the past.", Severity.Warning);
            return false;
        }

        if (_vendorModel.StartDate.HasValue && _vendorModel.EndDate.HasValue)
        {
            if (_vendorModel.EndDate.Value.Date < _vendorModel.StartDate.Value.Date)
            {
                Snackbar.Add("End Date cannot be earlier than the Start Date.", Severity.Warning);
                return false;
            }
            if (_vendorModel.EndDate.Value.Date == _vendorModel.StartDate.Value.Date)
            {
                Snackbar.Add("End Date cannot be the same as the Start Date.", Severity.Warning);
                return false;
            }
        }

        _savingVendor = true;
        try
        {
            _vendorModel.ItemId = Id;
            _vendorModel.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            // Default PurchaseUnit to the item's purchase unit if not set
            if (_vendorModel.PurchaseUnit == 0) _vendorModel.PurchaseUnit = (decimal)_model.PurchaseUnit;

            await ApiClient.SaveRawMaterialVendorAsync(_vendorModel);
            Snackbar.Add("Vendor price saved successfully.", Severity.Success);
            _vendors = (await ApiClient.GetRawMaterialVendorsAsync(Id)).ToList();
            ResetVendorForm();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving vendor price: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingVendor = false;
        }
    }

    private void EditVendor(RawMaterialVendorDto vendor)
    {
        _vendorModel = new RawMaterialVendorDto
        {
            ItemVendorId = vendor.ItemVendorId,
            ItemId = vendor.ItemId,
            VendorAccountId = vendor.VendorAccountId,
            StatusId = vendor.StatusId,
            PurchasePrice = vendor.PurchasePrice,
            PurchaseUnit = vendor.PurchaseUnit,
            StartDate = vendor.StartDate,
            EndDate = vendor.EndDate,
            Remarks = vendor.Remarks,
            BrandId = vendor.BrandId,
            CurrencyId = vendor.CurrencyId,
            PurchaseQuantity = vendor.PurchaseQuantity
        };
    }

    private void ResetVendorForm()
    {
        _vendorModel = new RawMaterialVendorDto { StatusId = 1, CurrencyId = 1 };
    }

    private async Task<bool> SaveBatch()
    {
        if (_batchModel.WarehouseId == 0)
        {
            Snackbar.Add("Please select a warehouse.", Severity.Warning);
            return false;
        }

        if (_batchModel.UnitId == 0)
        {
            Snackbar.Add("Please select a unit.", Severity.Warning);
            return false;
        }

        if (_batchModel.Quantity < 0)
        {
            Snackbar.Add("Quantity cannot be negative.", Severity.Warning);
            return false;
        }

        if (_batchModel.ExpiryDate.HasValue && _batchModel.ExpiryDate.Value.Date < DateTime.Today)
        {
            Snackbar.Add("Expiry date cannot be from the past.", Severity.Warning);
            return false;
        }

        _savingBatch = true;
        try
        {
            _batchModel.ItemId = Id;
            _batchModel.CreatedBy = SessionState.CurrentUserAuditName ?? "System";

            await ApiClient.SaveRawMaterialBatchAsync(_batchModel);
            Snackbar.Add("Batch saved successfully.", Severity.Success);
            _batches = (await ApiClient.GetRawMaterialBatchesAsync(Id)).ToList();
            ResetBatchForm();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving batch: {ex.Message}", Severity.Error);
            return false;
        }
        finally
        {
            _savingBatch = false;
        }
    }

    private void EditBatch(RawMaterialBatchDto batch)
    {
        _batchModel = new RawMaterialBatchDto
        {
            ItemStockByBatchId = batch.ItemStockByBatchId,
            ItemId = batch.ItemId,
            WarehouseId = batch.WarehouseId,
            Quantity = batch.Quantity,
            UnitId = batch.UnitId,
            BatchNo = batch.BatchNo,
            ExpiryDate = batch.ExpiryDate
        };
    }

    private void ResetBatchForm()
    {
        _batchModel = new RawMaterialBatchDto
        {
            UnitId = _model.PurchaseUnit > 0 ? (int)_model.PurchaseUnit : (int)(_units.FirstOrDefault()?.UnitId ?? 0)
        };
    }

    private async Task DeleteBatch(RawMaterialBatchDto batch)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete batch '{batch.BatchNo}' with quantity {batch.Quantity}?");
        if (!confirmed) return;

        _savingBatch = true;
        try
        {
            batch.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            var result = await ApiClient.SaveRawMaterialBatchAsync(batch, batch.ItemStockByBatchId.ToString());
            if (result < 0)
            {
                throw new Exception("REFERENCE constraint conflict occurred during batch deletion.");
            }
            Snackbar.Add("Batch deleted successfully.", Severity.Success);
            _batches = (await ApiClient.GetRawMaterialBatchesAsync(Id)).ToList();
        }
        catch (Exception ex)
        {
            var message = ex.Message;
            if (message.Contains("REFERENCE constraint") || message.Contains("conflict") || message.Contains("FK_Inv_PurchaseChildBatches_Inv_ItemStockByBatch") || message.Contains("Inv_ItemStockUsed"))
            {
                Snackbar.Add("Cannot delete this batch because it has already been used/linked in consumption or purchase transactions.", Severity.Error);
            }
            else
            {
                Snackbar.Add($"Error deleting batch: {ex.Message}", Severity.Error);
            }
        }
        finally
        {
            _savingBatch = false;
        }
    }

    private void OnBack() => Navigation.NavigateTo("/store/rawmaterials");

    private async Task<IEnumerable<ItemCategoryDto>> SearchCategories(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _categories;
        return _categories.Where(x => x.ItemCatName.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<BrandDto>> SearchBrands(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _brands;
        return _brands.Where(x => x.BrandName.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<AccountLookupDto>> SearchAccounts(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _accounts;
        return _accounts.Where(x => x.AccountName.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
