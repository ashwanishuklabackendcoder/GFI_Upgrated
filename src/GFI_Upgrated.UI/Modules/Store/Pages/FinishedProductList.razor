@page "/store/finished-products"
@page "/store/w_masteritemproductlist"
@page "/admin/w_masteritemproductlist"
@page "/admin/finished-products"
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppSessionState SessionState
@inject IJSRuntime JS

<PageTitle>Finished Products</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Finished Products</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OnAddNew" Disabled="!_canInsert">
            Add New Product
        </MudButton>
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4" Style="max-width: 500px;">
        <MudTextField T="string" Value="@_search" ValueChanged="@OnSearchTextChanged" Placeholder="Search by name, code or short name..." Variant="Variant.Outlined" Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" OnClearButtonClick="OnSearch" />
        
    </MudStack>

    <MudTable RowsPerPage="25" T="FinishedProductDto" @ref="_table" ServerData="LoadServerDataAsync" Hover="true" Dense="true" Striped="true" Bordered="true" Loading="_loading">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="ItemCode" T="FinishedProductDto">Code</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="ItemName" T="FinishedProductDto">Product Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="ShortName" T="FinishedProductDto">Short Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="ItemCatId" T="FinishedProductDto">Category</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="TentativeExpiryDays" T="FinishedProductDto">Expiry Days</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortLabel="PurchaseUnit" T="FinishedProductDto">Unit</MudTableSortLabel></MudTh>
            <MudTh Style="text-align: center;">Status</MudTh>
            <MudTh Style="text-align: center; width: 120px;">Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Code">@context.ItemCode</MudTd>
            <MudTd DataLabel="Product Name">@context.ItemName</MudTd>
            <MudTd DataLabel="Short Name">@context.ShortName</MudTd>
            <MudTd DataLabel="Category">@context.ItemCategoryName</MudTd>
            <MudTd DataLabel="Expiry Days">@context.TentativeExpiryDays</MudTd>
            <MudTd DataLabel="Unit">@context.UnitName</MudTd>
            <MudTd DataLabel="Status" Style="text-align: center;">
                @* <MudSwitch T="bool" Value="@context.IsActive" ValueChanged="@((bool val) => ToggleStatusAsync(context, val))" Color="Color.Success" UnCheckedColor="Color.Error" Disabled="!_canUpdate" /> *@
                <MudChip T="string" Color="@(context.StatusId == 1 ? Color.Success : Color.Primary)" Size="Size.Small">
                    @(string.IsNullOrWhiteSpace(context.StatusName) ? (context.IsActive ? "Active" : "Inactive") : context.StatusName)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Action" Style="text-align: center;">
                <MudStack Row="true" Justify="Justify.Center" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OnEdit(context.ItemId))" Disabled="!_canUpdate" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnDelete(context))" Disabled="!_canDelete" />
                </MudStack>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Class="pa-4">No finished products found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<FinishedProductDto>? _cachedItems;

    private async Task OnSearchTextChanged(string text)
    {
        _search = text;
        if (_table is not null) await _table.ReloadServerData();
    }

    private MudTable<FinishedProductDto>? _table;
    private string _search = "";
    private bool _loading;
    private bool _canInsert;
    private bool _canUpdate;
    private bool _canDelete;

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // We use the path that matches the system's hardmapped route for consistent permission lookup
        var path = "store/finished-products";
        var perms = SessionState.GetPermissions(path);
        
        // Priority logic: If Super Admin, allow all. Otherwise, use DB permissions.
        if (SessionState.IsAdmin)
        {
            _canInsert = _canUpdate = _canDelete = true;
        }
        else
        {
            _canInsert = perms.IsInsert;
            _canUpdate = perms.IsUpdate;
            _canDelete = perms.IsDelete;
        }

        // Diagnostic logging for debugging disabled buttons
        Console.WriteLine($"[RBAC] Finished Products Permissions: Path='{path}', IsAdmin={SessionState.IsAdmin}, Insert={_canInsert}, Update={_canUpdate}, Delete={_canDelete}");
    }

    private async Task<TableData<FinishedProductDto>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            if (_cachedItems == null)
            {
                var result = await ApiClient.GetFinishedProductsAsync(new FinishedProductListRequest
                                                                            {
                                                                                SearchTerm = _search,
                                                                                PageNumber = state.Page + 1,
                                                                                PageSize = 100000,
                                                                                SortColumn = state.SortLabel,
                                                                                }, cancellationToken);
                _cachedItems = result.Items.ToList();
            }

            var filtered = _cachedItems.FilterAllColumns(_search);
            var sorted = filtered.SortAllColumns(state.SortLabel ?? "1", state.SortDirection == SortDirection.Ascending ? "ASC" : "DESC");
            var itemsList = sorted.ToList();

            return new TableData<FinishedProductDto>
            {
                TotalItems = itemsList.Count,
                Items = itemsList.Skip(state.Page * state.PageSize).Take(state.PageSize).ToArray()
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading products: {ex.Message}", Severity.Error);
            return new TableData<FinishedProductDto> { Items = Array.Empty<FinishedProductDto>(), TotalItems = 0 };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch()
    {
        if (_table != null) await _table.ReloadServerData();
    }

    private void OnAddNew() => Navigation.NavigateTo("/store/finished-products/new");

    private void OnEdit(long id) => Navigation.NavigateTo($"/store/finished-products/edit/{id}");

    private async Task OnDelete(FinishedProductDto item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete finished product: {item.ItemName}?");
        if (!confirmed) return;

        try
        {
            var success = await ApiClient.DeleteFinishedProductAsync(item.ItemId, SessionState.CurrentUserAuditName ?? "System");
            if (success)
            {
                Snackbar.Add("Finished product deleted successfully.", Severity.Success);
                await OnSearch();
            }
            else
            {
                Snackbar.Add("Cannot delete finished product because it is currently linked to transactions, recipes (BOM), or stock batches. You should deactivate it instead.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task ToggleStatusAsync(FinishedProductDto item, bool val)
    {
        try
        {
            var request = new SaveFinishedProductRequest
            {
                ItemId = item.ItemId,
                ItemName = item.ItemName,
                ItemCode = item.ItemCode,
                ShortName = item.ShortName,
                IsActive = val,
                ItemCatId = item.ItemCatId,
                ItemTypeId = item.ItemTypeId,
                StatusId = 1,
                Description = item.Description,
                StorageDetails = item.StorageDetails,
                Tags = item.Tags,
                TentativeExpiryDays = item.TentativeExpiryDays,
                PurchaseUnit = item.PurchaseUnit,
                BrandId = item.BrandId,
                CreatedBy = SessionState.CurrentUserAuditName ?? "System"
            };
            var result = await ApiClient.SaveFinishedProductAsync(request);
            if (result > 0)
            {
                item.IsActive = val;
                Snackbar.Add("Finished product status updated successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to update finished product status.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating status: {ex.Message}", Severity.Error);
        }
    }
}

