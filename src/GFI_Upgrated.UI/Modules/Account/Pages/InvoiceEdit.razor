@page "/admin/invoice/new"
@page "/admin/invoice/edit/{Id:long}"
@using GFI_Upgrated.SharedDto.Account
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject AccountApiClient ApiClient
@inject StoreApiClient StoreApiClient
@inject ISnackbar Snackbar
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@_title</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@_title</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Enter sales invoice details, exchange rates, and line items below.</MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToList">Back</MudButton>
    </MudStack>

    <EditForm Model="_invoice" OnValidSubmit="SaveInvoice">
        <DataAnnotationsValidator />
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField Disabled="@(_invoice.InvoiceStatus == "Submitted")" @bind-Value="_invoice.InvoiceNumber" Label="Invoice Number" Required="true" Variant="Variant.Outlined" For="@(() => _invoice.InvoiceNumber)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <SearchableSelect T="long?" Disabled="@(_invoice.InvoiceStatus == "Submitted")" Label="Customer" Value="@((long?)_invoice.AccountID)" ValueChanged="@((long? val) => OnCustomerChanged(val ?? 0))" Variant="Variant.Outlined" Required="true" Items="@GetCustomerSelects()" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCheckBox Disabled="@(_invoice.InvoiceStatus == "Submitted")" T="bool?" @bind-Value="_invoice.IsPaid" Label="Mark as Paid" Color="Color.Success" />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudDatePicker Disabled="@(_invoice.InvoiceStatus == "Submitted")" DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Editable="true" @bind-Date="_invoice.InvoiceDate" Label="@($"Invoice Date ({SessionState.DateFormat})")" Variant="Variant.Outlined" For="@(() => _invoice.InvoiceDate)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker Disabled="@(_invoice.InvoiceStatus == "Submitted")" DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Editable="true" @bind-Date="_invoice.DueDate" Label="@($"Due Date ({SessionState.DateFormat})")" Variant="Variant.Outlined" For="@(() => _invoice.DueDate)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <SearchableSelect T="string" Disabled="@(_invoice.InvoiceStatus == "Submitted")" Label="Status" Value="@_invoice.InvoiceStatus" ValueChanged="@((string val) => { _invoice.InvoiceStatus = val; })" Variant="Variant.Outlined" Items="@GetStatusSelects()" />
            </MudItem>

            <MudItem xs="12" md="4">
                <SearchableSelect T="CurrencyDto" Disabled="@(_invoice.InvoiceStatus == "Submitted")" Label="Currency" 
                                  Value="@(_currencies.FirstOrDefault(c => c.CurrencyID == _invoice.CurrencyID))" 
                                  ValueChanged="OnCurrencyChanged" 
                                  Variant="Variant.Outlined" Items="@GetCurrencySelects()" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField Disabled="@(_invoice.InvoiceStatus == "Submitted")" @bind-Value="_invoice.CurrencyConversion" Label="Exchange Rate (to Base)" HideSpinButtons="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center">
                <MudText Typo="Typo.subtitle1" Style="font-weight: bold;">
                    Total Due: @(_selectedCurrencySymbol ?? "$") @SessionState.FormatNumber(CalculateTotalAmount())
                </MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Disabled="@(_invoice.InvoiceStatus == "Submitted")" @bind-Value="_invoice.Remarks" Label="The Narration Will be Printed on Invoice" Variant="Variant.Outlined" Lines="2" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Disabled="@(_invoice.InvoiceStatus == "Submitted")" @bind-Value="_invoice.InvoiceRemark" Label="Remarks" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
            
            <MudItem xs="12" Class="mt-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Invoice Line Items</MudText>
                    @if (_invoice.InvoiceStatus != "Submitted")
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddInvoiceItem" Size="Size.Small">
                            Add Line Item
                        </MudButton>
                    }
                </MudStack>

                <MudTable Items="@_invoice.Items" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0" Class="mb-4">
                    <HeaderContent>
                        <MudTh>Item (SKU)</MudTh>
                        <MudTh>Batch No.</MudTh>
                        <MudTh Style="width: 110px; text-align: center;">Qty</MudTh>
                        <MudTh Style="width: 140px; text-align: right;">Unit Price</MudTh>
                        <MudTh Style="width: 140px; text-align: right;">Amount</MudTh>
                        <MudTh>Related Order</MudTh>
                        <MudTh Style="width: 80px; text-align: center;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd DataLabel="Item (SKU)">
                            <SearchableSelect T="RawMaterialDto" Disabled="@(_invoice.InvoiceStatus == "Submitted")" Value="@(GetItemById(row.ItemId))" ValueChanged="@(async (RawMaterialDto val) => await OnItemChanged(row, val?.ItemId ?? 0))" Variant="Variant.Outlined" Dense="true" Items="@GetItemSelects()" />
                        </MudTd>
                        <MudTd DataLabel="Batch No.">
                            @if (_invoice.InvoiceStatus == "Submitted")
                            {
                                <MudText Typo="Typo.body2">@row.BatchNumber</MudText>
                            }
                            else
                            {
                                <SearchableSelect T="ItemStockByBatchForBOMDto" Value="@(GetBatchById(row.ItemId, row.ItemStockByBatchId))" ValueChanged="@(async (ItemStockByBatchForBOMDto val) => await OnBatchChanged(row, val))" Variant="Variant.Outlined" Dense="true" Items="@GetBatchSelects(row.ItemId)" />
                            }
                            @if(row.CostPrice.HasValue) {
                                <MudText Typo="Typo.caption" Color="Color.Success">Cost: @(_selectedCurrencySymbol ?? "$") @(SessionState.FormatNumber(row.CostPrice.Value))</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Qty" Style="text-align: center;">
                            <MudNumericField Format="@($"N{SessionState.DecimalDigits}")" T="double" Disabled="@(_invoice.InvoiceStatus == "Submitted")" @bind-Value="row.Quantity" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Min="1.0" Max="@(GetMaxQuantity(row) ?? double.MaxValue)" Style="text-align: center;" />
                        </MudTd>
                        <MudTd DataLabel="Unit Price" Style="text-align: right;">
                            <MudNumericField Format="@($"N{SessionState.DecimalDigits}")" Disabled="@(_invoice.InvoiceStatus == "Submitted")" @bind-Value="row.UnitPrice" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Min="0.0" HideSpinButtons="true" Style="text-align: right;" />
                        </MudTd>
                        <MudTd DataLabel="Amount" Style="text-align: right; font-weight: bold;">
                            @SessionState.FormatNumber((row.Quantity * row.UnitPrice))
                        </MudTd>
                        <MudTd DataLabel="Related Order">
                            <SearchableSelect T="long?" Disabled="@(_invoice.InvoiceStatus == "Submitted")" Value="@row.OrderID" ValueChanged="@((long? val) => OnOrderChanged(row, val ?? 0))" Variant="Variant.Outlined" Dense="true" Items="@GetOrderSelects()" />
                        </MudTd>
                        <MudTd DataLabel="Action" Style="text-align: center;">
                            @if (_invoice.InvoiceStatus != "Submitted")
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveInvoiceItem(row))" />
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>

            <MudItem xs="12" Class="pt-4">
                <MudStack Row="true" Spacing="2">
                    @if (_invoice.InvoiceStatus != "Submitted")
                    {
                        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy">Save (Draft)</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="_busy" OnClick="SubmitInvoice">Submit Invoice</MudButton>
                    }
                    @if (Id > 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintInvoice" Disabled="_busy">Print Invoice</MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" OnClick="BackToList" Disabled="_busy">Cancel</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="Severity.Info" Class="mt-4" ContentAlignment="HorizontalAlignment.Center">@_message</MudAlert>
    }
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }

    private InvoiceDto _invoice = new();
    private List<AccountLookupDto> _customers = new();
    private List<CurrencyDto> _currencies = new();
    private List<RawMaterialDto> _items = new();
    private List<CustomerOrderDto> _orders = new();
    private Dictionary<long, List<ItemStockByBatchForBOMDto>> _itemBatches = new();
    private List<long> _deletedItemIds = new();
    private string? _selectedCurrencySymbol = "$";
    private bool _busy;
    private string? _message;
    private string _title = "Add Sales Invoice";

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load lookups
            var custResult = await StoreApiClient.GetAccountsLookupAsync();
            _customers = custResult.Where(x => x.AccountGroupId == 5).ToList();

            var currResult = await ApiClient.GetCurrenciesAsync(pageSize: 1000);
            var allCurrencies = currResult.Items.ToList();

            var itemResult = await StoreApiClient.GetItemsForBomLookupAsync(1);
            _items = itemResult.ToList();

            var orderResult = await ApiClient.GetCustomerOrdersAsync(pageSize: 1000);
            _orders = orderResult.Items.ToList();

            if (Id > 0)
            {
                _customers = custResult.Where(x => x.AccountGroupId == 5).ToList();
                _title = "Edit Sales Invoice";
                var fetched = await ApiClient.GetInvoiceByIdAsync(Id);
                if (fetched != null)
                {
                    _invoice = fetched;
                    _currencies = allCurrencies;
                    if (_invoice.CurrencyID.HasValue)
                    {
                        var matchingCurr = allCurrencies.FirstOrDefault(c => c.CurrencyID == _invoice.CurrencyID);
                        _selectedCurrencySymbol = matchingCurr?.CurrencySymbol ?? "$";
                    }
                    else
                    {
                        _selectedCurrencySymbol = "$";
                    }

                    if (_invoice.InvoiceStatus != "Submitted")
                    {
                        // Preload batches for existing items so the dropdown populates for editable invoices
                        foreach (var item in _invoice.Items)
                        {
                            if (item.ItemId > 0 && !_itemBatches.ContainsKey(item.ItemId))
                            {
                                var batches = await ApiClient.GetItemStockByItemIDBatchListAsync(item.ItemId);
                                _itemBatches[item.ItemId] = batches.ToList();
                            }
                            
                            // Attempt to auto-select the batch if we have a BatchNumber matching
                            if (item.ItemId > 0 && !string.IsNullOrEmpty(item.BatchNumber) && item.ItemStockByBatchId == null)
                            {
                                if (_itemBatches.TryGetValue(item.ItemId, out var batchList))
                                {
                                    var matchingBatch = batchList.FirstOrDefault(b => b.BatchNo == item.BatchNumber);
                                    if (matchingBatch != null)
                                    {
                                        item.ItemStockByBatchId = matchingBatch.ItemStockByBatchID;
                                    }
                                }
                            }
                        }
                    }
                }
                else
                {
                    Snackbar.Add("Invoice not found.", Severity.Error);
                    BackToList();
                }
            }
            else
            {
                // Show all customers instead of filtering by completed orders
                _customers = custResult.Where(x => x.AccountGroupId == 5).ToList();

                _currencies = allCurrencies;
                var defaultCurr = allCurrencies.FirstOrDefault(c => string.Equals(c.CurrencyString, SessionState.DefaultCurrency, StringComparison.OrdinalIgnoreCase)) ?? allCurrencies.FirstOrDefault();

                _invoice = new InvoiceDto
                {
                    InvoiceDate = DateTime.Today,
                    DueDate = DateTime.Today.AddDays(30),
                    CurrencyConversion = 1.0,
                    IsPaid = false,
                    InvoiceStatus = "Draft",
                    CurrencyID = defaultCurr?.CurrencyID
                };
                _selectedCurrencySymbol = defaultCurr?.CurrencySymbol ?? "$";
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
    }

    private void AddInvoiceItem()
    {
        _invoice.Items.Add(new InvoiceItemDto
        {
            Quantity = 1,
            UnitPrice = 0.0,
            Amount = 0.0
        });
    }

    private void RemoveInvoiceItem(InvoiceItemDto item)
    {
        if (item.InvoiceChildID > 0)
        {
            _deletedItemIds.Add(item.InvoiceChildID);
        }
        _invoice.Items.Remove(item);
    }

    private async Task OnItemChanged(InvoiceItemDto row, long val)
    {
        row.ItemId = val;
        var item = _items.FirstOrDefault(i => i.ItemId == val);
        if (item != null)
        {
            row.ItemName = item.ItemName;
            
            // Clear out old batch data when changing items
            row.ItemStockByBatchId = null;
            row.BatchNumber = null;
            row.CostPrice = null;
            
            if (!_itemBatches.ContainsKey(val))
            {
                var batches = await ApiClient.GetItemStockByItemIDBatchListAsync(val);
                _itemBatches[val] = batches.ToList();
            }
            
            if (_itemBatches[val] == null || _itemBatches[val].Count == 0)
            {
                Snackbar.Add("Batch stock not available for the selected item.", Severity.Warning);
            }
        }
    }

    private async Task OnBatchChanged(InvoiceItemDto row, ItemStockByBatchForBOMDto val)
    {
        if (val != null)
        {
            row.ItemStockByBatchId = val.ItemStockByBatchID;
            row.BatchNumber = val.BatchNo;
            
            // Fetch the cost price for this batch
            row.CostPrice = await ApiClient.GetBatchCostPriceAsync(val.ItemStockByBatchID);

            // Automatically adjust quantity if it exceeds the new batch's max
            if (row.Quantity > val.FinalQuantityLeft)
            {
                row.Quantity = val.FinalQuantityLeft;
            }
        }
        else
        {
            row.ItemStockByBatchId = null;
            row.BatchNumber = null;
            row.CostPrice = null;
        }
        StateHasChanged();
    }

    private double? GetMaxQuantity(InvoiceItemDto row)
    {
        if (row.ItemStockByBatchId.HasValue && row.ItemStockByBatchId.Value > 0)
        {
            var batch = GetBatchById(row.ItemId, row.ItemStockByBatchId);
            if (batch != null)
            {
                return batch.FinalQuantityLeft;
            }
        }
        return null; // No limit if no batch is selected
    }

    private void OnOrderChanged(InvoiceItemDto row, long val)
    {
        row.OrderID = val;
        var order = _orders.FirstOrDefault(o => o.OrderID == val);
        if (order != null)
        {
            row.OrderNo = order.OrderNo;
        }
    }

    private void OnCurrencyChanged(CurrencyDto val)
    {
        _invoice.CurrencyID = val?.CurrencyID;
        _selectedCurrencySymbol = val?.CurrencySymbol ?? "$";
    }

    private double CalculateTotalAmount()
    {
        double sum = 0;
        foreach (var item in _invoice.Items)
        {
            item.Amount = item.Quantity * item.UnitPrice;
            sum += item.Amount;
        }
        _invoice.TotalAmount = sum;
        return sum;
    }

    private async Task SaveInvoice()
    {
        if (_invoice.AccountID == 0)
        {
            Snackbar.Add("Please select a customer.", Severity.Warning);
            return;
        }

        if (!_invoice.Items.Any())
        {
            Snackbar.Add("Invoice must contain at least one line item.", Severity.Warning);
            return;
        }

        if (_invoice.Items.Any(i => i.ItemId == 0))
        {
            Snackbar.Add("All selected products must be valid items.", Severity.Warning);
            return;
        }

        foreach (var item in _invoice.Items)
        {
            var maxQty = GetMaxQuantity(item);
            if (maxQty.HasValue && item.Quantity > maxQty.Value)
            {
                Snackbar.Add($"Quantity for item {item.ItemName} exceeds available batch stock ({maxQty.Value}).", Severity.Warning);
                return;
            }
        }

        _busy = true;
        _message = null;
        try
        {
            _invoice.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            _invoice.CreatedDate = DateTime.Now;
            _invoice.TotalAmount = CalculateTotalAmount();

            if (_invoice.IsPaid == true || _invoice.InvoiceStatus == "Paid")
            {
                _invoice.IsPaid = true;
                _invoice.InvoiceStatus = "Paid";
            }
            else
            {
                _invoice.IsPaid = false;
            }

            // 1. Save main invoice
            var invoiceId = await ApiClient.SaveInvoiceAsync(_invoice);
            if (invoiceId > 0)
            {
                // 2. Handle deleted items
                if (_deletedItemIds.Any())
                {
                    var idString = string.Join(",", _deletedItemIds);
                    await ApiClient.DeleteInvoiceItemAsync(idString);
                }

                // 3. Save each item
                foreach (var item in _invoice.Items)
                {
                    item.InvoiceID = invoiceId;
                    item.Amount = item.Quantity * item.UnitPrice;
                    await ApiClient.SaveInvoiceItemAsync(item);
                }

                Snackbar.Add("Invoice saved successfully.", Severity.Success);
                BackToList();
            }
            else
            {
                _message = "Failed to save invoice.";
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitInvoice()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure? After submitting the invoice you cannot edit it.");
        if (confirm)
        {
            _invoice.InvoiceStatus = "Submitted";
            await SaveInvoice();
        }
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/admin/invoice");
    }

    private void PrintInvoice()
    {
        Navigation.NavigateTo($"/admin/invoice/print/{Id}");
    }

    private async Task OnCustomerChanged(long customerId)
    {
        _invoice.AccountID = customerId;
        
        // Remove auto-filling of orders when customer is selected to allow manual batch selection
    }

    private IEnumerable<SearchableSelect<long?>.SelectItemDto<long?>> GetCustomerSelects()
    {
        return _customers.Select(x => new SearchableSelect<long?>.SelectItemDto<long?>
        {
            Value = (long?)x.AccountId,
            Text = x.AccountName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<string>.SelectItemDto<string>> GetStatusSelects()
    {
        return new[] { "Draft", "Sent", "Paid", "Overdue", "Submitted" }.Select(x => new SearchableSelect<string>.SelectItemDto<string>
        {
            Value = x,
            Text = x
        });
    }

    private IEnumerable<SearchableSelect<CurrencyDto>.SelectItemDto<CurrencyDto>> GetCurrencySelects()
    {
        return _currencies.Select(x => new SearchableSelect<CurrencyDto>.SelectItemDto<CurrencyDto>
        {
            Value = x,
            Text = $"{x.CurrencySymbol} ({x.CurrencyString})"
        });
    }

    private IEnumerable<SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>> GetItemSelects()
    {
        return _items.Select(x => new SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>
        {
            Value = x,
            Text = x.ItemName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long?>.SelectItemDto<long?>> GetOrderSelects()
    {
        return _orders.Select(x => new SearchableSelect<long?>.SelectItemDto<long?>
        {
            Value = (long?)x.OrderID,
            Text = x.OrderNo ?? ""
        });
    }

    private IEnumerable<SearchableSelect<ItemStockByBatchForBOMDto>.SelectItemDto<ItemStockByBatchForBOMDto>> GetBatchSelects(long itemId)
    {
        if (_itemBatches.TryGetValue(itemId, out var batches))
        {
            return batches.Select(x => new SearchableSelect<ItemStockByBatchForBOMDto>.SelectItemDto<ItemStockByBatchForBOMDto>
            {
                Value = x,
                Text = $"{x.BatchNo} (Avail: {x.FinalQuantityLeft})"
            });
        }
        return Array.Empty<SearchableSelect<ItemStockByBatchForBOMDto>.SelectItemDto<ItemStockByBatchForBOMDto>>();
    }

    private ItemStockByBatchForBOMDto? GetBatchById(long itemId, long? batchId)
    {
        if (batchId.HasValue && _itemBatches.TryGetValue(itemId, out var batches))
        {
            return batches.FirstOrDefault(x => x.ItemStockByBatchID == batchId.Value);
        }
        return null;
    }

    private RawMaterialDto? GetItemById(long id) => _items.FirstOrDefault(x => x.ItemId == id);
}


