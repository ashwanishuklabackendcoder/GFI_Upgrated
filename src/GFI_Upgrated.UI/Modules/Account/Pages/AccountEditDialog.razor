@using GFI_Upgrated.SharedDto.Account
@using GFI_Upgrated.SharedDto.AdminSecurity
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@using MudBlazor
@inject AccountApiClient ApiClient
@inject AdminSecurityApiClient SecurityApiClient
@inject ISnackbar Snackbar
@inject AppSessionState SessionState

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Model="@Model">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudStack Spacing="4">
                        <MudTextField @bind-Value="Model.AccountName" Label="Account Name" Required="true" RequiredError="Account name is required" Variant="Variant.Outlined" />
                        
                        <MudSelect T="long" Label="Account Group" @bind-Value="Model.AccountGroupID" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Required="true" RequiredError="Account group is required">
                            <MudSelectItem T="long" Value="0">-- Select Group --</MudSelectItem>
                            @foreach (var group in _groups)
                            {
                                <MudSelectItem T="long" Value="@group.AccountGroupID">@group.AccountGroupName</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="long?" Label="Currency" @bind-Value="Model.CurrencyID" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="long?" Value="null">-- Select Currency --</MudSelectItem>
                            @foreach (var curr in _currencies)
                            {
                                <MudSelectItem T="long?" Value="@curr.CurrencyID">@curr.CurrencySymbol (@curr.CurrencyString)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string?" Label="Stakeholder Type" @bind-Value="Model.StakeholderType" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                            <MudSelectItem T="string?" Value="null">-- Select Stakeholder Type --</MudSelectItem>
                            @foreach (var type in _stakeholderTypes)
                            {
                                <MudSelectItem T="string?" Value="@type.Value.ToString()">@type.Text</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="string?" Label="Stakeholder Group" @bind-Value="Model.StakeholderGroup" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                            <MudSelectItem T="string?" Value="null">-- Select Stakeholder Group --</MudSelectItem>
                            @foreach (var sg in _stakeholderGroups)
                            {
                                <MudSelectItem T="string?" Value="@sg.Value.ToString()">@sg.Text</MudSelectItem>
                            }
                        </MudSelect>

                        <MudTextField @bind-Value="Model.Remark" Label="Remark" Variant="Variant.Outlined" Lines="2" />
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudStack Spacing="4">
                        <MudTextField @bind-Value="Model.ContactPerson" Label="Contact Person Name" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="Model.MobileNo" Label="Mobile Number" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="Model.EmailID" Label="Email Address" Variant="Variant.Outlined" InputType="InputType.Email" />
                        <MudTextField @bind-Value="Model.Website" Label="Website" Variant="Variant.Outlined" Placeholder="https://example.com" />
                        <MudSelect T="string?" Label="Country" @bind-Value="Model.MasterCountry" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                            <MudSelectItem T="string?" Value="null">-- Select Country --</MudSelectItem>
                            @foreach (var country in _countries)
                            {
                                <MudSelectItem T="string?" Value="@country.Text">@country.Text</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="Model.Address" Label="Address" Variant="Variant.Outlined" Lines="2" />
                        
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save Account</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public AccountMasterDto Model { get; set; } = new();

    private MudForm _form = default!;
    private IReadOnlyList<AccountGroupLookupDto> _groups = Array.Empty<AccountGroupLookupDto>();
    private List<CurrencyDto> _currencies = new();
    private IReadOnlyList<LookupItemDto> _stakeholderTypes = Array.Empty<LookupItemDto>();
    private IReadOnlyList<LookupItemDto> _stakeholderGroups = Array.Empty<LookupItemDto>();
    private IReadOnlyList<LookupItemDto> _countries = Array.Empty<LookupItemDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _groups = await ApiClient.GetAccountGroupsLookupAsync();
            var currResult = await ApiClient.GetCurrenciesAsync();
            _currencies = currResult.Items.ToList();
            
            _stakeholderTypes = await SecurityApiClient.GetMasterDropdownAsync(6);
            _stakeholderGroups = await SecurityApiClient.GetMasterDropdownAsync(5);
            _countries = await SecurityApiClient.GetCountriesAsync();
            
            if (Model.AccountID == 0 && Model.OpeningBalanceDate == null)
            {
                Model.OpeningBalanceDate = DateTime.Today;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid)
        {
            try
            {
                Model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
                var id = await ApiClient.SaveAccountAsync(Model);
                if (id > 0)
                {
                    Snackbar.Add("Account saved successfully.", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(id));
                }
                else if (id == -1 || id == -2)
                {
                    Snackbar.Add("An account with this name already exists.", Severity.Warning);
                }
                else
                {
                    Snackbar.Add("Failed to save account.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error saving account: {ex.Message}", Severity.Error);
            }
        }
    }
}
