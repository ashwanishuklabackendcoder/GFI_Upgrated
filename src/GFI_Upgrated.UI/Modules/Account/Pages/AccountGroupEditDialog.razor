@using GFI_Upgrated.SharedDto.Account
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@using MudBlazor
@inject AccountApiClient ApiClient
@inject ISnackbar Snackbar
@inject AppSessionState SessionState

<MudDialog>
    <EditForm Model="@Model" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <DialogContent>
            <MudStack Spacing="4">
                <MudTextField @bind-Value="Model.AccountGroupName" For="@(() => Model.AccountGroupName)" Label="Group Name" Variant="Variant.Outlined" />
                
                <MudSwitch @bind-Value="Model.IsMainAccountGroup" Label="Is this a Main Group?" Color="Color.Primary" />

                @if (!Model.IsMainAccountGroup)
                {
                    <SearchableSelect T="long?" Label="Main Account Group" Value="@Model.MainAccountGroupID" ValueChanged="@((long? val) => { Model.MainAccountGroupID = val; })" Variant="Variant.Outlined" Items="@GetMainGroupSelects()" />
                }

                <MudSwitch @bind-Value="Model.IsActive" Label="Active" Color="Color.Success" />
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Model.IsEditable && Model.AccountGroupID > 0)">Save</MudButton>
        </DialogActions>
    </EditForm>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public AccountGroupDto Model { get; set; } = new();

    private IReadOnlyList<AccountGroupLookupDto> _mainGroups = Array.Empty<AccountGroupLookupDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mainGroups = await ApiClient.GetMainAccountGroupsLookupAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading main groups: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        try
        {
            Model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            var id = await ApiClient.SaveAccountGroupAsync(Model);
            if (id > 0)
            {
                Snackbar.Add("Account Group saved successfully.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(id));
            }
            else
            {
                Snackbar.Add("Failed to save account group.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving group: {ex.Message}", Severity.Error);
        }
    }

    private IEnumerable<SearchableSelect<long?>.SelectItemDto<long?>> GetMainGroupSelects()
    {
        return _mainGroups.Select(x => new SearchableSelect<long?>.SelectItemDto<long?>
        {
            Value = (long?)x.AccountGroupID,
            Text = x.AccountGroupName ?? ""
        });
    }
}

