@page "/admin/purchase/new"
@page "/admin/purchase/edit/{Id:long}"
@using GFI_Upgrated.SharedDto.Purchase
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.SharedDto.AdminSecurity
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject AdminSecurityApiClient AdminApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject GFI_Upgrated.UI.State.AppSessionState SessionState

<PageTitle>@(Id == 0 ? "New Goods Receipt" : "Edit Goods Receipt")</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@(Id == 0 ? "Add Purchase" : "Edit Purchase")</MudText>
            @* <MudText Typo="Typo.body2" Color="Color.Secondary">Record incoming goods and update inventory.</MudText> *@
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnBack">Back</MudButton>
    </MudStack>

    <EditForm Model="_model" OnValidSubmit="OnSave">
        <DataAnnotationsValidator />
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_model.VoucherNumber" Label="Voucher Number" Variant="Variant.Outlined" Required="true" For="@(() => _model.VoucherNumber)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <SearchableSelect T="AccountLookupDto" Label="Supplier" Value="@_selectedVendor" ValueChanged="OnVendorChanged" Variant="Variant.Outlined" Required="true" Items="@GetVendorSelects()" />
            </MudItem>
           
            <MudItem xs="12" md="3">
                <MudDatePicker Editable="true" DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat"                      Label="@($"Received Date ({SessionState.DateFormat})")" Date="_model.GoodsRecievedDate" DateChanged="OnGoodsReceivedDateChanged" Variant="Variant.Outlined" For="@(() => _model.GoodsRecievedDate)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Editable="true" DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Label="@($"Invoice Date ({SessionState.DateFormat})")" @bind-Date="_model.InvoiceDate" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_model.InvoiceNo" Label="Invoice Number" Variant="Variant.Outlined" />
            </MudItem>

             <MudItem xs="12" md="3">
                <SearchableSelect T="PurchaseOrderDto" Label="Link PO" Value="@_selectedPO" ValueChanged="OnPoChanged" Variant="Variant.Outlined" Items="@GetPoSelects()" />
            </MudItem>

           
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Narration" Label="Remarks" Variant="Variant.Outlined" />
            </MudItem>

            <!-- Items Section -->
            <MudItem xs="12" Class="mt-6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">Received Items & Batches</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddRow">Add Item</MudButton>
                </MudStack>
                <MudDivider Class="mb-4" />

                <MudTable Items="_model.Items" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0" Context="itemContext">
                    <HeaderContent>
                        <MudTh>Item</MudTh>
                        <MudTh Style="width: 100px;">Qty.</MudTh>
                        <MudTh Style="width: 120px;">Unit</MudTh>
                        <MudTh Style="width: 120px;">Price</MudTh>
                        <MudTh>Batch No.</MudTh>
                        <MudTh>Expiry Date</MudTh>
                        <MudTh>Warehouse</MudTh>
                        <MudTh Style="text-align: center; width: 60px;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Item">
                            <SearchableSelect T="RawMaterialDto" Value="@(GetItemById(itemContext.ItemID))" ValueChanged="@((RawMaterialDto val) => OnItemChanged(itemContext, val))" Variant="Variant.Text" Dense="true" Required="true" Items="@GetItemSelects()" />
                        </MudTd>
                        <MudTd DataLabel="Qty">
                            <MudNumericField @bind-Value="itemContext.Quantity" Variant="Variant.Text" Dense="true" Min="1" />
                        </MudTd>
                        <MudTd DataLabel="Unit">
                            <SearchableSelect T="long?" Value="@itemContext.UnitId" ValueChanged="@((long? val) => { itemContext.UnitId = val; })" Variant="Variant.Text" Dense="true" Required="true" Items="@GetUnitSelects()" />
                        </MudTd>
                        <MudTd DataLabel="Price">
                            <MudNumericField @bind-Value="itemContext.UnitPrice" Variant="Variant.Text" Dense="true" Format="@($"N{SessionState.DecimalDigits}")" />
                        </MudTd>
                        <MudTd DataLabel="Batch #">
                            <MudTextField @bind-Value="itemContext.BatchNo" Variant="Variant.Text" Dense="true" Placeholder="AUTO" />
                        </MudTd>
                        <MudTd DataLabel="Expiry">
                            <MudDatePicker Editable="true" DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat"                      @bind-Date="itemContext.ExpiryDate" Variant="Variant.Text" Dense="true" />
                        </MudTd>
                        <MudTd DataLabel="Warehouse">
                            <SearchableSelect T="long?" Value="@itemContext.WarehouseId" ValueChanged="@((long? val) => { itemContext.WarehouseId = val; })" Variant="Variant.Text" Dense="true" Items="@GetWarehouseSelects()" />
                        </MudTd>
                        <MudTd Style="text-align: center;">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveRow(itemContext))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>

            <!-- Totals Section -->
            <MudItem xs="12" md="8"></MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 mud-background-gray" Elevation="0">
                    <MudStack Spacing="2">
                        <div class="d-flex justify-space-between align-center">
                            <MudText>Taxes:</MudText>
                            <MudNumericField @bind-Value="_model.Taxes" Variant="Variant.Text" Dense="true" Style="width: 100px;" />
                        </div>
                        <div class="d-flex justify-space-between align-center">
                            <MudText>Shipping:</MudText>
                            <MudNumericField @bind-Value="_model.Shipping" Variant="Variant.Text" Dense="true" Style="width: 100px;" />
                        </div>
                        <div class="d-flex justify-space-between align-center">
                            <MudText>Discount:</MudText>
                            <MudNumericField @bind-Value="_model.Discount" Variant="Variant.Text" Dense="true" Style="width: 100px;" />
                        </div>
                        <MudDivider />
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.h6">Total Amount:</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary">@SessionState.FormatNumber(_totalAmount)</MudText>
                        </div>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudValidationSummary />
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end mt-6 gap-2">
                
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Loading="_saving" OnClick="OnSubmitClick">Save</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="OnBack">Cancel</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    private void OnSubmitClick()
    {
        Console.WriteLine("[DEBUG] Record Receipt button clicked");
    }

    [Parameter] public long Id { get; set; }

    private PurchaseDto _model = new() { GoodsRecievedDate = DateTime.Now };
    private AccountLookupDto? _selectedVendor;
    private PurchaseOrderDto? _selectedPO;
    private List<AccountLookupDto> _vendors = new();
    private List<PurchaseOrderDto> _pendingPOs = new();
    private List<WarehouseLookupDto> _warehouses = new();
    private List<RawMaterialDto> _allItems = new();
    private List<UnitLookupDto> _units = new();
    private bool _saving;

    private double _subtotal => _model.Items.Sum(i => i.Quantity * i.UnitPrice);
    private double _totalAmount => _subtotal + (_model.Taxes ?? 0) + (_model.Shipping ?? 0) - (_model.Discount ?? 0);

    private List<PurchaseOrderDto> _allPendingPOs = new();

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadLookups();

        if (Id > 0)
        {
            await LoadData();
        }
        else
        {
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            _model.VoucherNumber = $"GRN-{DateTime.Now:yyyyMMdd-HHmm}";
        }
    }

    private async Task LoadLookups()
    {
        try
        {
            _vendors = (await ApiClient.GetAccountsLookupAsync())
                .Where(x => x.AccountGroupId == 6 || x.AccountGroupId == 3)
                .ToList();
            _warehouses = (await ApiClient.GetWarehousesLookupAsync()).ToList();
            _allItems = (await ApiClient.GetItemsForBomLookupAsync(3)).ToList();
            _units = (await ApiClient.GetUnitsLookupAsync()).ToList();
            
            var pos = await ApiClient.GetPurchaseOrdersAsync(null, null, null, 1, 100);
            _allPendingPOs = pos.Items.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadData()
    {
        try
        {
            var result = await ApiClient.GetPurchasesAsync(Id, null, null, null);
            if (result.Items.Any())
            {
                _model = result.Items.First();
                _model.Items = await ApiClient.GetPurchaseItemsAsync(Id);
                _selectedVendor = _vendors.FirstOrDefault(v => v.AccountId == _model.AccountID);
                
                if (_selectedVendor != null)
                {
                    _pendingPOs = _allPendingPOs.Where(x => x.AccountID == _selectedVendor.AccountId).ToList();
                }

                _selectedPO = _pendingPOs.FirstOrDefault(p => p.PurchaseOrderID == _model.PurchaseOrderID);
                
                foreach (var item in _model.Items)
                {
                    if (item.WarehouseId == null || item.WarehouseId == 0)
                    {
                        item.WarehouseId = _warehouses.FirstOrDefault()?.WarehouseId;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading receipt: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnVendorChanged(AccountLookupDto? val)
    {
        _selectedVendor = val;
        _selectedPO = null;
        _pendingPOs.Clear();

        if (val != null)
        {
            _pendingPOs = _allPendingPOs.Where(x => x.AccountID == val.AccountId).ToList();
        }
    }

    private async Task OnPoChanged(PurchaseOrderDto? val)
    {
        _selectedPO = val;
        
        if (val != null)
        {
            try
            {
                var poItems = await ApiClient.GetPurchaseOrderItemsAsync(val.PurchaseOrderID);
                _model.Items.Clear();
                foreach (var poItem in poItems)
                {
                    var rawMat = _allItems.FirstOrDefault(x => x.ItemId == poItem.ItemID);
                    var expiryDate = rawMat != null && rawMat.TentativeExpiryDays > 0 
                        ? (_model.GoodsRecievedDate ?? DateTime.Today).AddDays(rawMat.TentativeExpiryDays) 
                        : (DateTime?)null;

                    _model.Items.Add(new PurchaseItemDto 
                    {
                        ItemID = poItem.ItemID,
                        ItemName = poItem.ItemName,
                        Quantity = poItem.Quantity,
                        UnitId = poItem.UnitId,
                        UnitPrice = poItem.Price,
                        WarehouseId = _warehouses.FirstOrDefault()?.WarehouseId,
                        ExpiryDate = expiryDate
                    });
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error loading PO items: {ex.Message}", Severity.Error);
            }
        }
    }

    private IEnumerable<SearchableSelect<AccountLookupDto>.SelectItemDto<AccountLookupDto>> GetVendorSelects()
    {
        return _vendors.Select(x => new SearchableSelect<AccountLookupDto>.SelectItemDto<AccountLookupDto>
        {
            Value = x,
            Text = x.AccountName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<PurchaseOrderDto>.SelectItemDto<PurchaseOrderDto>> GetPoSelects()
    {
        return _pendingPOs.Select(x => new SearchableSelect<PurchaseOrderDto>.SelectItemDto<PurchaseOrderDto>
        {
            Value = x,
            Text = x.VoucherNumber ?? ""
        });
    }

    private IEnumerable<SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>> GetItemSelects()
    {
        return _allItems.Select(x => new SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>
        {
            Value = x,
            Text = x.ItemName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long?>.SelectItemDto<long?>> GetUnitSelects()
    {
        return _units.Select(x => new SearchableSelect<long?>.SelectItemDto<long?>
        {
            Value = (long?)x.UnitId,
            Text = x.UnitName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long?>.SelectItemDto<long?>> GetWarehouseSelects()
    {
        return _warehouses.Select(x => new SearchableSelect<long?>.SelectItemDto<long?>
        {
            Value = (long?)x.WarehouseId,
            Text = x.WarehouseName ?? ""
        });
    }

    private RawMaterialDto? GetItemById(long? id) => id.HasValue ? _allItems.FirstOrDefault(x => x.ItemId == id.Value) : null;

    private void OnItemChanged(PurchaseItemDto row, RawMaterialDto? item)
    {
        if (item != null)
        {
            row.ItemID = item.ItemId;
            row.ItemName = item.ItemName;
            row.UnitId = item.PurchaseUnit;
            if (item.TentativeExpiryDays > 0)
            {
                row.ExpiryDate = (_model.GoodsRecievedDate ?? DateTime.Today).AddDays(item.TentativeExpiryDays);
            }
            else
            {
                row.ExpiryDate = null;
            }
        }
    }

    private void AddRow()
    {
        _model.Items.Add(new PurchaseItemDto { Quantity = 1, WarehouseId = _warehouses.FirstOrDefault()?.WarehouseId });
    }

    private void OnGoodsReceivedDateChanged(DateTime? newDate)
    {
        _model.GoodsRecievedDate = newDate;
        foreach (var item in _model.Items)
        {
            if (item.ItemID > 0)
            {
                var rawMaterial = _allItems.FirstOrDefault(x => x.ItemId == item.ItemID);
                if (rawMaterial != null && rawMaterial.TentativeExpiryDays > 0)
                {
                    item.ExpiryDate = (newDate ?? DateTime.Today).AddDays(rawMaterial.TentativeExpiryDays);
                }
            }
        }
    }

    private void RemoveRow(PurchaseItemDto row)
    {
        _model.Items.Remove(row);
    }

    private async Task OnSave()
    {
        Console.WriteLine("[DEBUG] OnSave triggered");
        if (_selectedVendor == null)
        {
            Snackbar.Add("Please select a vendor.", Severity.Warning);
            return;
        }

        if (!_model.Items.Any())
        {
            Snackbar.Add("Please add at least one item.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            _model.AccountID = _selectedVendor.AccountId;
            _model.PurchaseOrderID = _selectedPO?.PurchaseOrderID;
            _model.TotalAmount = _totalAmount;
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            
            // Calculate item Amount before saving to prevent DB errors
            foreach (var item in _model.Items)
            {
                item.Amount = item.Quantity * item.UnitPrice;
            }
            
            var resultId = await ApiClient.SavePurchaseAsync(_model);
            if (resultId > 0)
            {
                Snackbar.Add("Goods Receipt saved successfully.", Severity.Success);
                Navigation.NavigateTo("/admin/purchase");
            }
            else if (resultId == -1)
            {
                Snackbar.Add("Voucher Number already exists. Please use a unique voucher number.", Severity.Error);
            }
            else
            {
                Snackbar.Add("Failed to save Goods Receipt. Please check your input.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnBack() => Navigation.NavigateTo("/admin/purchase");
}



