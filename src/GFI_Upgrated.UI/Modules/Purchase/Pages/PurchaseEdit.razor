@page "/admin/purchase/new"
@page "/admin/purchase/edit/{Id:long}"
@using GFI_Upgrated.SharedDto.Purchase
@using GFI_Upgrated.SharedDto.Store
@using GFI_Upgrated.SharedDto.Account
@using GFI_Upgrated.SharedDto.AdminSecurity
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@inject StoreApiClient ApiClient
@inject AccountApiClient AccountApiClient
@inject AdminSecurityApiClient AdminApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject IJSRuntime JS

<PageTitle>@(Id == 0 ? "New Goods Receipt" : "Edit Goods Receipt")</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h5">@(Id == 0 ? "Add Purchase" : (_isReadOnly ? "View Purchase (Finalized)" : "Edit Purchase"))</MudText>
                @if (Id > 0)
                {
                    @if (_model.IsFinalized)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Lock">Finalized & Credited</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Drafts">Draft (No Stock Credited)</MudChip>
                    }
                }
            </MudStack>
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="OnBack">Back</MudButton>
    </MudStack>

    @if (_isReadOnly)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-4" Icon="@Icons.Material.Filled.Lock">
            <b>Finalized Receipt:</b> This Goods Receipt has been finalized and stock has been credited to inventory. It cannot be edited.
        </MudAlert>
    }

    <EditForm Model="_model">
        <DataAnnotationsValidator />
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_model.VoucherNumber" Label="Voucher Number" Variant="Variant.Outlined" Required="true" Disabled="_isReadOnly" For="@(() => _model.VoucherNumber)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <SearchableSelect T="AccountLookupDto" Label="Supplier" Value="@_selectedVendor" ValueChanged="OnVendorChanged" Variant="Variant.Outlined" Required="true" Disabled="_isReadOnly" Items="@GetVendorSelects()" />
            </MudItem>
           
            <MudItem xs="12" md="3">
                <MudDatePicker Editable="!_isReadOnly" DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Label="@($"Received Date ({SessionState.DateFormat})")" Date="_model.GoodsRecievedDate" DateChanged="OnGoodsReceivedDateChanged" Variant="Variant.Outlined" Disabled="_isReadOnly" For="@(() => _model.GoodsRecievedDate)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Editable="!_isReadOnly" DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" Label="@($"Invoice Date ({SessionState.DateFormat})")" @bind-Date="_model.InvoiceDate" Variant="Variant.Outlined" Disabled="_isReadOnly" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_model.InvoiceNo" Label="Invoice Number" Variant="Variant.Outlined" Disabled="_isReadOnly" />
            </MudItem>

            <MudItem xs="12" md="3">
                <SearchableSelect T="PurchaseOrderDto" Label="Link PO" Value="@_selectedPO" ValueChanged="OnPoChanged" Variant="Variant.Outlined" Disabled="_isReadOnly" Items="@GetPoSelects()" />
            </MudItem>

            <MudItem xs="12" md="3">
                <SearchableSelect T="CurrencyDto" Disabled="_isReadOnly" Label="Currency" 
                                  Value="@(_currencies.FirstOrDefault(c => c.CurrencyID == _model.CurrencyID))" 
                                  ValueChanged="OnCurrencyChanged" 
                                  Variant="Variant.Outlined" Items="@GetCurrencySelects()" />
            </MudItem>

            <MudItem xs="12" md="3">
                <MudNumericField Disabled="_isReadOnly" @bind-Value="_model.CurrencyConversion" Label="Exchange Rate (to Base)" HideSpinButtons="true" Variant="Variant.Outlined" Min="0.000001" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Narration" Label="Remarks" Variant="Variant.Outlined" Disabled="_isReadOnly" />
            </MudItem>

            <!-- Items Section -->
            <MudItem xs="12" Class="mt-6">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">Received Items & Batches</MudText>
                    @if (!_isReadOnly)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddRow">Add Item</MudButton>
                    }
                </MudStack>
                <MudDivider Class="mb-4" />

                <MudTable Items="_model.Items" Hover="true" Dense="true" Striped="true" Bordered="true" Elevation="0" Context="itemContext">
                    <HeaderContent>
                        <MudTh Style="width: 260px;">Item</MudTh>
                        <MudTh Style="width: 100px;">Qty.</MudTh>
                        <MudTh Style="width: 100px;">Unit</MudTh>
                        <MudTh Style="width: 130px;">Unit Price</MudTh>
                        <MudTh Style="width: 130px;">Total Amount</MudTh>
                        <MudTh>Batch No.</MudTh>
                        <MudTh>Expiry Date</MudTh>
                        <MudTh>Warehouse</MudTh>
                        @if (!_isReadOnly)
                        {
                            <MudTh Style="text-align: center; width: 60px;">Action</MudTh>
                        }
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Item">
                            @if (_isReadOnly)
                            {
                                <MudText Typo="Typo.body2">@itemContext.ItemName</MudText>
                            }
                            else
                            {
                                <SearchableSelect T="RawMaterialDto" Value="@(GetItemById(itemContext.ItemID))" ValueChanged="@((RawMaterialDto val) => OnItemChanged(itemContext, val))" Variant="Variant.Text" Dense="true" Required="true" Items="@GetItemSelects()" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Qty">
                            @if (_isReadOnly)
                            {
                                <MudText Typo="Typo.body2">@itemContext.Quantity</MudText>
                            }
                            else
                            {
                                <MudNumericField T="double" Value="itemContext.Quantity" ValueChanged="@((double val) => OnQuantityChanged(itemContext, val))" Variant="Variant.Text" Dense="true" Min="0.0001" HideSpinButtons="true" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Unit">
                            @if (_isReadOnly)
                            {
                                <MudText Typo="Typo.body2">@itemContext.UnitName</MudText>
                            }
                            else
                            {
                                <SearchableSelect T="long?" Value="@itemContext.UnitId" ValueChanged="@((long? val) => { itemContext.UnitId = val; })" Variant="Variant.Text" Dense="true" Required="true" Items="@GetUnitSelects()" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Unit Price">
                            @if (_isReadOnly)
                            {
                                <MudText Typo="Typo.body2">@SessionState.FormatNumber(itemContext.UnitPrice)</MudText>
                            }
                            else
                            {
                                <MudNumericField T="double" Value="itemContext.UnitPrice" ValueChanged="@((double val) => OnUnitPriceChanged(itemContext, val))" Variant="Variant.Text" Dense="true" Format="@($"N{SessionState.DecimalDigits}")" Min="0.0" HideSpinButtons="true" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Total Amount">
                            @if (_isReadOnly)
                            {
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@SessionState.FormatNumber(itemContext.Amount)</MudText>
                            }
                            else
                            {
                                <MudNumericField T="double" Value="itemContext.Amount" ValueChanged="@((double val) => OnAmountChanged(itemContext, val))" Variant="Variant.Text" Dense="true" Format="@($"N{SessionState.DecimalDigits}")" Min="0.0" HideSpinButtons="true" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Batch #">
                            <MudTextField @bind-Value="itemContext.BatchNo" Variant="Variant.Text" Dense="true" Placeholder="AUTO" Disabled="_isReadOnly" />
                        </MudTd>
                        <MudTd DataLabel="Expiry">
                            <MudDatePicker Editable="!_isReadOnly" DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat" @bind-Date="itemContext.ExpiryDate" Variant="Variant.Text" Dense="true" Disabled="_isReadOnly" />
                        </MudTd>
                        <MudTd DataLabel="Warehouse">
                            @if (_isReadOnly)
                            {
                                <MudText Typo="Typo.body2">@(_warehouses.FirstOrDefault(w => w.WarehouseId == itemContext.WarehouseId)?.WarehouseName ?? "-")</MudText>
                            }
                            else
                            {
                                <SearchableSelect T="long?" Value="@itemContext.WarehouseId" ValueChanged="@((long? val) => { itemContext.WarehouseId = val; })" Variant="Variant.Text" Dense="true" Items="@GetWarehouseSelects()" />
                            }
                        </MudTd>
                        @if (!_isReadOnly)
                        {
                            <MudTd Style="text-align: center;">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveRow(itemContext))" />
                            </MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </MudItem>

            <!-- Totals Section -->
            <MudItem xs="12" md="8"></MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 mud-background-gray" Elevation="0">
                    <MudStack Spacing="2">
                        <div class="d-flex justify-space-between align-center">
                            <MudText>Taxes:</MudText>
                            <MudNumericField @bind-Value="_model.Taxes" Variant="Variant.Text" Dense="true" Style="width: 100px;" Disabled="_isReadOnly" />
                        </div>
                        <div class="d-flex justify-space-between align-center">
                            <MudText>Shipping:</MudText>
                            <MudNumericField @bind-Value="_model.Shipping" Variant="Variant.Text" Dense="true" Style="width: 100px;" Disabled="_isReadOnly" />
                        </div>
                        <div class="d-flex justify-space-between align-center">
                            <MudText>Discount:</MudText>
                            <MudNumericField @bind-Value="_model.Discount" Variant="Variant.Text" Dense="true" Style="width: 100px;" Disabled="_isReadOnly" />
                        </div>
                        <MudDivider />
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.h6">Total Amount:</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary">@(_selectedCurrencySymbol ?? SessionState.DefaultCurrency) @SessionState.FormatNumber(_totalAmount)</MudText>
                        </div>
                        @if (_model.CurrencyConversion.HasValue && _model.CurrencyConversion.Value > 0 && Math.Abs(_model.CurrencyConversion.Value - 1.0) > 0.0001)
                        {
                            <div class="d-flex justify-space-between mt-1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Total in Base (@SessionState.DefaultCurrency):</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary"><b>@SessionState.DefaultCurrency @SessionState.FormatNumber(_totalAmount * _model.CurrencyConversion.Value)</b></MudText>
                            </div>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudValidationSummary />
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end mt-6 gap-2">
                @if (!_isReadOnly)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Drafts" Loading="_saving" OnClick="SaveDraftAsync">Save Draft</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" Loading="_saving" OnClick="FinalizeAsync">Finalize & Credit Stock</MudButton>
                }
                <MudButton Variant="Variant.Outlined" OnClick="OnBack">@(_isReadOnly ? "Back" : "Cancel")</MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudPaper>

@code {
    [Parameter] public long Id { get; set; }

    private PurchaseDto _model = new() { GoodsRecievedDate = DateTime.Today, CurrencyConversion = 1.0 };
    private AccountLookupDto? _selectedVendor;
    private PurchaseOrderDto? _selectedPO;
    private List<AccountLookupDto> _vendors = new();
    private List<PurchaseOrderDto> _pendingPOs = new();
    private List<WarehouseLookupDto> _warehouses = new();
    private List<RawMaterialDto> _allItems = new();
    private List<UnitLookupDto> _units = new();
    private List<CurrencyDto> _currencies = new();
    private string? _selectedCurrencySymbol;
    private bool _saving;
    private bool _isReadOnly;

    private double _subtotal => _model.Items.Sum(i => i.Amount > 0 ? i.Amount : (i.Quantity * i.UnitPrice));
    private double _totalAmount => _subtotal + (_model.Taxes ?? 0) + (_model.Shipping ?? 0) - (_model.Discount ?? 0);

    private List<PurchaseOrderDto> _allPendingPOs = new();
    private Dictionary<long, List<RawMaterialVendorDto>> _itemSupplierPrices = new();

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadLookups();

        if (Id > 0)
        {
            await LoadData();
        }
        else
        {
            _model.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            _model.VoucherNumber = $"GRN-{DateTime.UtcNow:yyyyMMdd-HHmm}";
            var def = _currencies.FirstOrDefault(c => string.Equals(c.CurrencySymbol, SessionState.DefaultCurrency, StringComparison.OrdinalIgnoreCase)) ?? _currencies.FirstOrDefault();
            if (def != null)
            {
                _model.CurrencyID = def.CurrencyID;
                _selectedCurrencySymbol = def.CurrencySymbol;
            }
            else
            {
                _selectedCurrencySymbol = SessionState.DefaultCurrency;
            }
        }
    }

    private async Task LoadLookups()
    {
        try
        {
            _vendors = (await ApiClient.GetAccountsLookupAsync())
                .Where(x => x.AccountGroupId == 6 || x.AccountGroupId == 3)
                .ToList();
            _warehouses = (await ApiClient.GetWarehousesLookupAsync()).ToList();
            _allItems = (await ApiClient.GetItemsForBomLookupAsync(3)).ToList();
            _units = (await ApiClient.GetUnitsLookupAsync()).ToList();

            var currResult = await AccountApiClient.GetCurrenciesAsync(pageSize: 1000);
            _currencies = currResult.Items.ToList();
            
            var pos = await ApiClient.GetPurchaseOrdersAsync(null, null, null, 1, 100);
            _allPendingPOs = pos.Items.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading lookups: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadData()
    {
        try
        {
            var result = await ApiClient.GetPurchasesAsync(Id, null, null, null);
            if (result.Items.Any())
            {
                _model = result.Items.First();
                _model.Items = await ApiClient.GetPurchaseItemsAsync(Id);
                _selectedVendor = _vendors.FirstOrDefault(v => v.AccountId == _model.AccountID);
                
                if (_selectedVendor != null)
                {
                    _pendingPOs = _allPendingPOs.Where(x => x.AccountID == _selectedVendor.AccountId).ToList();
                }

                _selectedPO = _pendingPOs.FirstOrDefault(p => p.PurchaseOrderID == _model.PurchaseOrderID);

                if (_model.CurrencyID.HasValue && _model.CurrencyID > 0)
                {
                    var matching = _currencies.FirstOrDefault(c => c.CurrencyID == _model.CurrencyID);
                    _selectedCurrencySymbol = matching?.CurrencySymbol ?? _model.CurrencySymbol ?? SessionState.DefaultCurrency;
                }
                else
                {
                    _selectedCurrencySymbol = _model.CurrencySymbol ?? SessionState.DefaultCurrency;
                }
                
                foreach (var item in _model.Items)
                {
                    if (item.Amount <= 0 && item.Quantity > 0 && item.UnitPrice > 0)
                    {
                        item.Amount = Math.Round(item.Quantity * item.UnitPrice, 2);
                    }
                    if (item.WarehouseId == null || item.WarehouseId == 0)
                    {
                        item.WarehouseId = _warehouses.FirstOrDefault()?.WarehouseId;
                    }
                }

                if (_model.IsFinalized)
                {
                    _isReadOnly = true;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading receipt: {ex.Message}", Severity.Error);
        }
    }

    private void OnCurrencyChanged(CurrencyDto? val)
    {
        _model.CurrencyID = val?.CurrencyID;
        _selectedCurrencySymbol = val?.CurrencySymbol ?? SessionState.DefaultCurrency;
    }

    private IEnumerable<SearchableSelect<CurrencyDto>.SelectItemDto<CurrencyDto>> GetCurrencySelects()
    {
        return (_currencies ?? new List<CurrencyDto>()).Select(x => new SearchableSelect<CurrencyDto>.SelectItemDto<CurrencyDto>
        {
            Value = x,
            Text = $"{x.CurrencySymbol} - {x.CurrencyString}"
        });
    }

    private async Task OnVendorChanged(AccountLookupDto? val)
    {
        if (_isReadOnly) return;
        _selectedVendor = val;
        _selectedPO = null;
        _pendingPOs.Clear();

        if (val != null)
        {
            _model.AccountID = val.AccountId;
            _pendingPOs = _allPendingPOs.Where(x => x.AccountID == val.AccountId).ToList();

            if (_model.Items != null)
            {
                foreach (var item in _model.Items)
                {
                    if (item.ItemID > 0)
                    {
                        var customPrice = await GetSupplierUnitPriceAsync(item.ItemID, val.AccountId);
                        if (customPrice.HasValue)
                        {
                            item.UnitPrice = customPrice.Value;
                        }
                    }
                }
            }
        }
    }

    private async Task OnPoChanged(PurchaseOrderDto? val)
    {
        if (_isReadOnly) return;
        _selectedPO = val;
        
        if (val != null)
        {
            try
            {
                var poItems = await ApiClient.GetPurchaseOrderItemsAsync(val.PurchaseOrderID);
                _model.Items.Clear();
                foreach (var poItem in poItems)
                {
                    var rawMat = _allItems.FirstOrDefault(x => x.ItemId == poItem.ItemID);
                    var expiryDate = rawMat != null && rawMat.TentativeExpiryDays > 0 
                        ? (_model.GoodsRecievedDate ?? DateTime.Today).AddDays(rawMat.TentativeExpiryDays) 
                        : (DateTime?)null;

                    _model.Items.Add(new PurchaseItemDto 
                    {
                        ItemID = poItem.ItemID,
                        ItemName = poItem.ItemName,
                        Quantity = poItem.Quantity,
                        UnitId = poItem.UnitId,
                        UnitPrice = poItem.Price,
                        WarehouseId = _warehouses.FirstOrDefault()?.WarehouseId,
                        ExpiryDate = expiryDate
                    });
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error loading PO items: {ex.Message}", Severity.Error);
            }
        }
    }

    private IEnumerable<SearchableSelect<AccountLookupDto>.SelectItemDto<AccountLookupDto>> GetVendorSelects()
    {
        return _vendors.Select(x => new SearchableSelect<AccountLookupDto>.SelectItemDto<AccountLookupDto>
        {
            Value = x,
            Text = x.AccountName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<PurchaseOrderDto>.SelectItemDto<PurchaseOrderDto>> GetPoSelects()
    {
        return _pendingPOs.Select(x => new SearchableSelect<PurchaseOrderDto>.SelectItemDto<PurchaseOrderDto>
        {
            Value = x,
            Text = x.VoucherNumber ?? ""
        });
    }

    private IEnumerable<SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>> GetItemSelects()
    {
        return _allItems.Select(x => new SearchableSelect<RawMaterialDto>.SelectItemDto<RawMaterialDto>
        {
            Value = x,
            Text = x.ItemName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long?>.SelectItemDto<long?>> GetUnitSelects()
    {
        return _units.Select(x => new SearchableSelect<long?>.SelectItemDto<long?>
        {
            Value = (long?)x.UnitId,
            Text = x.UnitName ?? ""
        });
    }

    private IEnumerable<SearchableSelect<long?>.SelectItemDto<long?>> GetWarehouseSelects()
    {
        return _warehouses.Select(x => new SearchableSelect<long?>.SelectItemDto<long?>
        {
            Value = (long?)x.WarehouseId,
            Text = x.WarehouseName ?? ""
        });
    }

    private RawMaterialDto? GetItemById(long? id) => id.HasValue ? _allItems.FirstOrDefault(x => x.ItemId == id.Value) : null;

    private async Task<double?> GetSupplierUnitPriceAsync(long itemId, long supplierId)
    {
        if (itemId <= 0 || supplierId <= 0) return null;

        try
        {
            if (!_itemSupplierPrices.TryGetValue(itemId, out var vendors))
            {
                var result = await ApiClient.GetRawMaterialVendorsAsync(itemId);
                vendors = result.ToList();
                _itemSupplierPrices[itemId] = vendors;
            }

            if (vendors == null || !vendors.Any()) return null;

            var recDate = _model.GoodsRecievedDate ?? DateTime.Today;

            var matchingVendor = vendors.FirstOrDefault(v => v.VendorAccountId == supplierId
                && (!v.StartDate.HasValue || v.StartDate.Value <= recDate)
                && (!v.EndDate.HasValue || v.EndDate.Value >= recDate));

            if (matchingVendor == null)
            {
                matchingVendor = vendors.FirstOrDefault(v => v.VendorAccountId == supplierId);
            }

            if (matchingVendor != null && matchingVendor.PurchasePrice > 0)
            {
                return matchingVendor.PurchasePrice;
            }
        }
        catch
        {
            // Ignore pricing fetch error
        }

        return null;
    }

    private async Task OnItemChanged(PurchaseItemDto row, RawMaterialDto? item)
    {
        if (_isReadOnly) return;
        if (item != null)
        {
            row.ItemID = item.ItemId;
            row.ItemName = item.ItemName;
            row.UnitId = item.PurchaseUnit;
            if (item.TentativeExpiryDays > 0)
            {
                row.ExpiryDate = (_model.GoodsRecievedDate ?? DateTime.Today).AddDays(item.TentativeExpiryDays);
            }
            else
            {
                row.ExpiryDate = null;
            }

            var supplierId = _selectedVendor?.AccountId ?? _model.AccountID;
            if (supplierId > 0)
            {
                var customPrice = await GetSupplierUnitPriceAsync(item.ItemId, supplierId);
                if (customPrice.HasValue)
                {
                    row.UnitPrice = customPrice.Value;
                    row.Amount = Math.Round(row.Quantity * row.UnitPrice, 2);
                }
            }
        }
    }

    private void OnQuantityChanged(PurchaseItemDto row, double newQty)
    {
        if (_isReadOnly) return;
        row.Quantity = newQty;
        if (row.UnitPrice > 0)
        {
            row.Amount = Math.Round(row.Quantity * row.UnitPrice, 2);
        }
        else if (row.Amount > 0 && row.Quantity > 0)
        {
            row.UnitPrice = Math.Round(row.Amount / row.Quantity, 4);
        }
        StateHasChanged();
    }

    private void OnUnitPriceChanged(PurchaseItemDto row, double newPrice)
    {
        if (_isReadOnly) return;
        row.UnitPrice = newPrice;
        row.Amount = Math.Round(row.Quantity * row.UnitPrice, 2);
        StateHasChanged();
    }

    private void OnAmountChanged(PurchaseItemDto row, double newAmount)
    {
        if (_isReadOnly) return;
        row.Amount = newAmount;
        if (row.Quantity > 0)
        {
            row.UnitPrice = Math.Round(row.Amount / row.Quantity, 4);
        }
        StateHasChanged();
    }

    private void AddRow()
    {
        if (_isReadOnly) return;
        _model.Items.Add(new PurchaseItemDto 
        { 
            Quantity = 1, 
            WarehouseId = _warehouses.FirstOrDefault()?.WarehouseId,
            UnitPrice = 0,
            Amount = 0
        });
    }

    private void OnGoodsReceivedDateChanged(DateTime? newDate)
    {
        if (_isReadOnly) return;
        _model.GoodsRecievedDate = newDate;
        foreach (var item in _model.Items)
        {
            if (item.ItemID > 0)
            {
                var rawMaterial = _allItems.FirstOrDefault(x => x.ItemId == item.ItemID);
                if (rawMaterial != null && rawMaterial.TentativeExpiryDays > 0)
                {
                    item.ExpiryDate = (newDate ?? DateTime.Today).AddDays(rawMaterial.TentativeExpiryDays);
                }
            }
        }
    }

    private void RemoveRow(PurchaseItemDto row)
    {
        if (_isReadOnly) return;
        _model.Items.Remove(row);
    }

    private async Task SaveDraftAsync()
    {
        _model.IsFinalized = false;
        _model.Status = "Draft";
        await ExecuteSaveAsync();
    }

    private async Task FinalizeAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to finalize this Goods Receipt? Once finalized, stock will be credited to inventory and this receipt CANNOT be edited.");
        if (!confirmed) return;

        _model.IsFinalized = true;
        _model.Status = "Finalized";
        await ExecuteSaveAsync();
    }

    private async Task ExecuteSaveAsync()
    {
        if (_selectedVendor == null)
        {
            Snackbar.Add("Please select a vendor.", Severity.Warning);
            return;
        }

        if (!_model.Items.Any())
        {
            Snackbar.Add("Please add at least one item.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var auditUser = SessionState.CurrentUserAuditName ?? "System";
            _model.AccountID = _selectedVendor.AccountId;
            _model.PurchaseOrderID = _selectedPO?.PurchaseOrderID;
            _model.TotalAmount = _totalAmount;
            
            if (Id == 0)
            {
                _model.CreatedBy = auditUser;
            }
            else
            {
                _model.UpdatedBy = auditUser;
            }
            
            // Ensure item Amount and UnitPrice are consistent before saving
            foreach (var item in _model.Items)
            {
                if (item.Amount <= 0 && item.Quantity > 0 && item.UnitPrice > 0)
                {
                    item.Amount = Math.Round(item.Quantity * item.UnitPrice, 2);
                }
                else if (item.UnitPrice <= 0 && item.Quantity > 0 && item.Amount > 0)
                {
                    item.UnitPrice = Math.Round(item.Amount / item.Quantity, 4);
                }
                if (item.PurchaseItemID == 0)
                {
                    item.CreatedBy = auditUser;
                }
                else
                {
                    item.UpdatedBy = auditUser;
                }
            }
            
            var resultId = await ApiClient.SavePurchaseAsync(_model);
            if (resultId > 0)
            {
                var msg = _model.IsFinalized ? "Goods Receipt finalized and stock credited to inventory." : "Goods Receipt draft saved successfully.";
                Snackbar.Add(msg, Severity.Success);
                Navigation.NavigateTo("/admin/purchase");
            }
            else if (resultId == -1)
            {
                Snackbar.Add("Voucher Number already exists. Please use a unique voucher number.", Severity.Error);
            }
            else
            {
                Snackbar.Add("Failed to save Goods Receipt. Please check your input.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnBack() => Navigation.NavigateTo("/admin/purchase");
}
