@page "/admin/staff/new"
@page "/admin/staff/edit/{StaffId:long}"
@inject AppSessionState SessionState
@inject LocalizationState LocalizationState
@inject NavigationManager Navigation
@inject AdminSecurityApiClient ApiClient
@inject StoreApiClient StoreApiClient
@using GFI_Upgrated.SharedDto.Store

<PageTitle>@_title</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@_title</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@LocalizationState.Text("Admin.Staff.Edit.Subtitle", "add / edit staff details")</MudText>
        </MudStack>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Cancel">@LocalizationState.Text("Common.Actions.BackToList", "Back to List")</MudButton>
    </MudStack>

    <style>
        .validation-summary-errors-red,
        .validation-summary-errors-red ul,
        .validation-summary-errors-red li,
        .validation-summary-errors-red .validation-message,
        ul.validation-errors,
        ul.validation-errors li,
        li.validation-message,
        .validation-errors {
            color: #f44336 !important;
            font-weight: 500 !important;
        }
    </style>

    <EditForm EditContext="_editContext" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <div class="validation-summary-errors-red mb-3">
            <ValidationSummary />
        </div>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudAutocomplete Clearable="true"        MaxItems="1000" T="LookupItemDto" Label="@LocalizationState.Text("Admin.Staff.Edit.Salutation", "Salutation")" Variant="Variant.Outlined"
                                 Value="@(_salutations.FirstOrDefault(x => x.Value.ToString() == _editor.StaffSalutation))"
                                 ValueChanged="@(async (LookupItemDto val) => await OnSalutationChanged(val))"
                                 SearchFunc="@SearchSalutations"
                                 ToStringFunc="@(x => x?.Text ?? "")"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                <ValidationMessage For="@(() => _editor.StaffSalutation)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_editor.StaffFirstName" For="@(() => _editor.StaffFirstName)" Label="@LocalizationState.Text("Admin.Staff.Edit.FirstName", "First Name")" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_editor.StaffLastName" For="@(() => _editor.StaffLastName)" Label="@LocalizationState.Text("Admin.Staff.Edit.LastName", "Last Name")" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudAutocomplete MaxItems="1000" T="LookupItemDto" Label="@LocalizationState.Text("Admin.Staff.Edit.Gender", "Gender")" Variant="Variant.Outlined"
                                 Value="@(_genders.FirstOrDefault(x => x.Value.ToString() == _editor.Gender.ToString()))"
                                 ValueChanged="@((LookupItemDto val) => { _editor.Gender = long.TryParse(val?.Value.ToString(), out var g) ? g : 0; })"
                                 SearchFunc="@SearchGenders"
                                 ToStringFunc="@(x => x?.Text ?? "")"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                <ValidationMessage For="@(() => _editor.Gender)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_editor.StaffNumber" For="@(() => _editor.StaffNumber)" Label="@LocalizationState.Text("Admin.Staff.Edit.StaffNumber", "Staff Number")" Variant="Variant.Outlined" />
            </MudItem>
          
            <MudItem xs="12" md="4">
                <MudDatePicker Editable="true" DateFormat="@SessionState.DatePickerFormat" Placeholder="@SessionState.DatePickerFormat"       @bind-Date="_editor.DOB" For="@(() => _editor.DOB)" Label="@(LocalizationState.Text("Admin.Staff.Edit.Dob", "D.O.B") + $" ({SessionState.DateFormat})")" Variant="Variant.Outlined"  />
            </MudItem>

            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_editor.MobileNo" For="@(() => _editor.MobileNo)" Label="@LocalizationState.Text("Admin.Staff.Edit.MobileNo", "Mobile No.")" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_editor.EmailIDOfficial" For="@(() => _editor.EmailIDOfficial)" Label="@LocalizationState.Text("Admin.Staff.Edit.Email", "Email")" Variant="Variant.Outlined" />
            </MudItem>

            
            <MudItem xs="12" md="4" Style="display:none;">
                <label class="form-label">@LocalizationState.Text("Admin.Staff.Edit.Photo", "Photo")</label>
                <InputFile OnChange="OnPhotoChanged" class="form-control" />
                @if (!string.IsNullOrWhiteSpace(_selectedPhotoName))
                {
                    <MudText Typo="Typo.caption" Class="mt-1">@_selectedPhotoName</MudText>
                }
            </MudItem>
            <MudItem xs="12" md="4">
                <MudAutocomplete MaxItems="1000" T="StatusDto" Label="@LocalizationState.Text("Admin.Staff.Edit.Status", "Status")" Variant="Variant.Outlined"
                                 Value="@(_statuses.FirstOrDefault(x => x.StatusId == _editor.Status))"
                                 ValueChanged="@((StatusDto val) => { _editor.Status = (int)(val?.StatusId ?? 0); })"
                                 SearchFunc="@SearchStatuses"
                                 ToStringFunc="@(x => x?.StatusName ?? "")"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                <ValidationMessage For="@(() => _editor.Status)" />
            </MudItem>

            <MudItem xs="12" Class="pt-2">
                <MudCheckBox T="bool" @bind-Value="_editor.HasLogin" For="@(() => _editor.HasLogin)" Label="@LocalizationState.Text("Admin.Staff.Edit.HasLogin", "Has Login")" />
            </MudItem>

            <MudItem xs="12" Class="pt-2">
                <MudStack Row="true" Spacing="2">
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy">@LocalizationState.Text("Common.Actions.Submit", "Submit")</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="Cancel" Disabled="_busy">@LocalizationState.Text("Common.Actions.Cancel", "Cancel")</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">@_message</MudAlert>
    }
</MudPaper>

@code {
    [Parameter]
    public long StaffId { get; set; }

    private readonly SaveStaffRequest _editor = new()
    {
        Status = 0
    };
    private IReadOnlyList<LookupItemDto> _salutations = Array.Empty<LookupItemDto>();
    private IReadOnlyList<LookupItemDto> _genders = Array.Empty<LookupItemDto>();
    private IReadOnlyList<StatusDto> _statuses = Array.Empty<StatusDto>();
    private bool _busy;
    private string? _message;
    private string? _selectedPhotoName;
    private string _title = string.Empty;

    private async Task<IEnumerable<LookupItemDto>> SearchSalutations(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _salutations.Any(x => (x.Text ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _salutations;
        return _salutations.Where(x => (x.Text ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<LookupItemDto>> SearchGenders(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _genders.Any(x => (x.Text ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _genders;
        return _genders.Where(x => (x.Text ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<StatusDto>> SearchStatuses(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _statuses;
        return _statuses.Where(x => x.StatusName != null && x.StatusName.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

        private EditContext _editContext => _lazyEditContext ??= new EditContext(_editor);
    private EditContext? _lazyEditContext;

    private async Task OnSalutationChanged(LookupItemDto val)
    {
        _editor.StaffSalutation = val?.Value.ToString() ?? string.Empty;
        if (_editContext != null)
        {
            _editContext.NotifyFieldChanged(_editContext.Field(nameof(_editor.StaffSalutation)));
        }
        await Task.CompletedTask;
    }

    private async Task OnGenderChanged(LookupItemDto val)
    {
        _editor.Gender = val?.Value ?? 0;
        if (_editContext != null)
        {
            _editContext.NotifyFieldChanged(_editContext.Field(nameof(_editor.Gender)));
        }
        await Task.CompletedTask;
    }

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _title = LocalizationState.Text("Admin.Staff.Edit.PageTitle.Add", "Add Staff");
        _salutations = await ApiClient.GetMasterDropdownAsync(1);
        _genders = await ApiClient.GetMasterDropdownAsync(2);
        try
        {
            var pagedStatuses = await StoreApiClient.GetStatusesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _statuses = pagedStatuses.Items.Where(x => x.IsActive && x.StatusOf == 4).OrderBy(x => x.StatusName).ToList();
            if (!_statuses.Any())
            {
                _statuses = new List<StatusDto>
                {
                    new StatusDto { StatusId = 1, StatusName = "Active" },
                    new StatusDto { StatusId = 2, StatusName = "Inactive" }
                };
            }
        }
        catch
        {
            _statuses = new List<StatusDto>
            {
                new StatusDto { StatusId = 1, StatusName = "Active" },
                new StatusDto { StatusId = 2, StatusName = "Inactive" }
            };
        }

        if (StaffId > 0)
        {
            _title = LocalizationState.Text("Admin.Staff.Edit.PageTitle.Edit", "Edit Staff");
            var selected = await ApiClient.GetStaffByIdAsync(StaffId);
            if (selected is not null)
            {
                _editor.StaffId = selected.StaffId;
                _editor.Status = selected.Status;
                _editor.StaffSalutation = selected.StaffSalutation;
                _editor.StaffFirstName = selected.StaffFirstName;
                _editor.StaffLastName = selected.StaffLastName;
                _editor.StaffNumber = selected.StaffNumber;
                _editor.NIN = selected.NIN;
                _editor.DOB = selected.DOB;
                _editor.Gender = selected.Gender;
                _editor.MobileNo = selected.MobileNo;
                _editor.EmailIDPersonal = string.IsNullOrWhiteSpace(selected.EmailIDPersonal) ? null : selected.EmailIDPersonal.Trim();
                _editor.EmailIDOfficial = string.IsNullOrWhiteSpace(selected.EmailIDOfficial) ? string.Empty : selected.EmailIDOfficial.Trim();
                _editor.Photo = selected.Photo;
                _editor.HasLogin = selected.HasLogin;
                _selectedPhotoName = selected.Photo;
            }
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            _editor.EmailIDPersonal = string.IsNullOrWhiteSpace(_editor.EmailIDPersonal) ? null : _editor.EmailIDPersonal.Trim();
            _editor.EmailIDOfficial = string.IsNullOrWhiteSpace(_editor.EmailIDOfficial) ? string.Empty : _editor.EmailIDOfficial.Trim();
            _editor.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            _editor.UpdatedBy = SessionState.CurrentUserAuditName ?? "System";
            if (!string.IsNullOrWhiteSpace(_selectedPhotoName))
            {
                _editor.Photo = _selectedPhotoName;
            }

            var id = await ApiClient.SaveStaffAsync(_editor);
            if (id > 0)
            {
                Navigation.NavigateTo("/admin/staff");
                return;
            }
            else if (id == -1)
            {
                _message = "This name is already registered. Please try with another name.";
            }

            _message = LocalizationState.Text("Admin.Staff.Edit.SaveFailed", "Staff save failed.");
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/admin/staff");
    }

    private void OnPhotoChanged(InputFileChangeEventArgs args)
    {
        var file = args.File;
        _selectedPhotoName = file.Name;
        _editor.Photo = file.Name;
    }
}


