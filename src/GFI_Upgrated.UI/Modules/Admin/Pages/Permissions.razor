@page "/admin/rolepermission"
@using GFI_Upgrated.SharedDto.AdminSecurity
@using GFI_Upgrated.SharedDto.Common
@inject AppSessionState SessionState
@inject NavigationManager Navigation
@inject AdminSecurityApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Permissions</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h5">Role Permissions</MudText>
        <AuthorizeAction Action="update">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" 
                       Disabled="@(_selectedRoleId == 0 || _isSaving)">
                @(_isSaving ? "Saving..." : "Save Permissions")
            </MudButton>
        </AuthorizeAction>
    </MudStack>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudAutocomplete Clearable="true"         MaxItems="1000" T="RoleDto" Label="Role" Variant="Variant.Outlined" 
                             Value="@(_roles.FirstOrDefault(x => x.RoleId == _selectedRoleId))" 
                             ValueChanged="@(async (RoleDto val) => await OnRoleChanged(val?.RoleId ?? 0))" 
                             Dense="true"
                             SearchFunc="@SearchRoles" 
                             ToStringFunc="@(x => x?.RoleName ?? "")"
                             ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
        </MudItem>
    </MudGrid>

    @if (_isLoading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_permissions.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Select a Role to manage permissions.</MudAlert>
    }
    else
    {
        <div class="d-flex gap-2 mb-2">
            <MudButton Variant="Variant.Outlined" OnClick="CollapseAll" StartIcon="@Icons.Material.Filled.UnfoldLess" Size="Size.Small">Collapse All</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ExpandAll" StartIcon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small">Expand All</MudButton>
        </div>
        <MudTable Items="GetVisiblePermissions()" Dense="true" Hover="true" FixedHeader="true" Height="600px" Elevation="0" Class="border">
            <HeaderContent>
                <MudTh Style="width: 40%">
                    <div class="d-flex align-center">
                        <MudCheckBox T="bool" Value="@IsAllEverythingChecked()" ValueChanged="@(v => OnMasterEverythingToggle(v))" Color="Color.Default" Dense="true" Class="mr-2" />
                        Menu / Page
                    </div>
                </MudTh>
                <MudTh Style="text-align: center">
                    View
                    <div class="d-flex justify-center">
                        <MudCheckBox T="bool" Value="@IsAllChecked("View")" ValueChanged="@(v => OnHeaderToggle("View", v))" Color="Color.Primary" Dense="true" />
                    </div>
                </MudTh>
                <MudTh Style="text-align: center">
                    Insert
                    <div class="d-flex justify-center">
                        <MudCheckBox T="bool" Value="@IsAllChecked("Insert")" ValueChanged="@(v => OnHeaderToggle("Insert", v))" Color="Color.Success" Dense="true" />
                    </div>
                </MudTh>
                <MudTh Style="text-align: center">
                    Update
                    <div class="d-flex justify-center">
                        <MudCheckBox T="bool" Value="@IsAllChecked("Update")" ValueChanged="@(v => OnHeaderToggle("Update", v))" Color="Color.Warning" Dense="true" />
                    </div>
                </MudTh>
                <MudTh Style="text-align: center">
                    Delete
                    <div class="d-flex justify-center">
                        <MudCheckBox T="bool" Value="@IsAllChecked("Delete")" ValueChanged="@(v => OnHeaderToggle("Delete", v))" Color="Color.Error" Dense="true" />
                    </div>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <div style="padding-left: @(context.ParentID == 0 ? "0" : "24px")" class="d-flex align-center">
                        @if (context.ParentID == 0)
                        {
                            <MudIconButton Icon="@(_collapsedParents.Contains(context.LinkID) ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)"
                                           Size="Size.Small" OnClick="@(() => ToggleParentCollapse(context.LinkID))" Class="mr-1" />
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-2" Color="Color.Primary" />
                            <strong>@FormatPageHeading(context.PageHeading)</strong>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2" />
                            @FormatPageHeading(context.PageHeading)
                        }
                    </div>
                </MudTd>
                <MudTd>
                    <div class="d-flex justify-center">
                        <MudCheckBox T="bool" Value="@context.ViewPer" ValueChanged="@(v => OnPermissionChanged(context, "View", v))" Color="Color.Primary" Dense="true" />
                    </div>
                </MudTd>
                <MudTd>
                    <div class="d-flex justify-center">
                        <MudCheckBox T="bool" Value="@context.InsertPer" ValueChanged="@(v => OnPermissionChanged(context, "Insert", v))" Color="Color.Success" Dense="true" />
                    </div>
                </MudTd>
                <MudTd>
                    <div class="d-flex justify-center">
                        <MudCheckBox T="bool" Value="@context.UpdatePer" ValueChanged="@(v => OnPermissionChanged(context, "Update", v))" Color="Color.Warning" Dense="true" />
                    </div>
                </MudTd>
                <MudTd>
                    <div class="d-flex justify-center">
                        <MudCheckBox T="bool" Value="@context.DeletePer" ValueChanged="@(v => OnPermissionChanged(context, "Delete", v))" Color="Color.Error" Dense="true" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
        private HashSet<long> _collapsedParents = new();

    private IEnumerable<RolePermissionDto> GetVisiblePermissions()
    {
        return _permissions.Where(p => p.ParentID == 0 || !_collapsedParents.Contains(p.ParentID));
    }

    private void ToggleParentCollapse(long parentId)
    {
        if (_collapsedParents.Contains(parentId))
            _collapsedParents.Remove(parentId);
        else
            _collapsedParents.Add(parentId);
    }

    private void CollapseAll()
    {
        foreach (var item in _permissions.Where(x => x.ParentID == 0))
        {
            _collapsedParents.Add(item.LinkID);
        }
    }

    private void ExpandAll()
    {
        _collapsedParents.Clear();
    }

    private string FormatPageHeading(string? heading)
    {
        if (string.IsNullOrEmpty(heading)) return string.Empty;
        var clean = heading.Replace("_", " ").Replace("-", " ");
        return System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(clean.ToLower());
    }

    private bool IsAllChecked(string type)
    {
        if (_permissions.Count == 0) return false;
        switch (type)
        {
            case "View": return _permissions.All(x => x.ViewPer);
            case "Insert": return _permissions.All(x => x.InsertPer);
            case "Update": return _permissions.All(x => x.UpdatePer);
            case "Delete": return _permissions.All(x => x.DeletePer);
            default: return false;
        }
    }

    private void OnHeaderToggle(string type, bool value)
    {
        foreach (var item in _permissions)
        {
            switch (type)
            {
                case "View": item.ViewPer = value; break;
                case "Insert": item.InsertPer = value; break;
                case "Update": item.UpdatePer = value; break;
                case "Delete": item.DeletePer = value; break;
            }
        }
    }

    private bool IsAllEverythingChecked()
    {
        if (_permissions.Count == 0) return false;
        return _permissions.All(x => x.ViewPer && x.InsertPer && x.UpdatePer && x.DeletePer);
    }

    private void OnMasterEverythingToggle(bool value)
    {
        foreach (var item in _permissions)
        {
            item.ViewPer = value;
            item.InsertPer = value;
            item.UpdatePer = value;
            item.DeletePer = value;
        }
    }

    private List<RoleDto> _roles = new();
    private List<ModuleDto> _modules = new();
    private List<MenuDto> _dashboards = new();
    private List<RolePermissionDto> _permissions = new();
    
    private long _selectedRoleId;
    private long _selectedModuleId;
    private string? _selectedDashboard;
    
    private bool _isLoading;
    private bool _isSaving;

    private async Task<IEnumerable<RoleDto>> SearchRoles(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _roles.Any(x => (x.RoleName ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _roles;
        return _roles.Where(x => (x.RoleName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<ModuleDto>> SearchModules(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _modules.Any(x => (x.ModuleName ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _modules;
        return _modules.Where(x => (x.ModuleName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var rolesTask = ApiClient.GetRolesAsync(new PagedRequest { RecordPerPage = 1000 });
            var modulesTask = ApiClient.GetModulesAsync();
            var dashboardsTask = ApiClient.GetDashboardsAsync();

            await Task.WhenAll(rolesTask, modulesTask, dashboardsTask);

            _roles = rolesTask.Result.Items.ToList();
            _modules = modulesTask.Result.ToList();
            _dashboards = dashboardsTask.Result.ToList();
            _selectedModuleId = _modules.FirstOrDefault()?.ModuleId ?? 1;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnRoleChanged(long roleId)
    {
        _selectedRoleId = roleId;
        if (_selectedModuleId == 0)
        {
            _selectedModuleId = _modules.FirstOrDefault()?.ModuleId ?? 1;
        }
        await LoadPermissionsAsync();
    }

    private async Task OnModuleChanged(long moduleId)
    {
        _selectedModuleId = moduleId;
        await LoadPermissionsAsync();
    }

    private async Task LoadPermissionsAsync()
    {
        if (_selectedRoleId == 0 || _selectedModuleId == 0)
        {
            _permissions.Clear();
            return;
        }

        try
        {
            _isLoading = true;
            var existing = await ApiClient.GetRolePermissionsAsync(_selectedRoleId, _selectedModuleId);
            
            var allMenus = await ApiClient.GetMenusAsync();
            var moduleMenus = allMenus.Where(x => x.ModuleId == _selectedModuleId).ToList();

            var parentMenus = moduleMenus.Where(x => x.ParentId == 0).OrderBy(x => x.SequenceNo).ToList();
            var orderedMenus = new List<MenuDto>();

            foreach (var parent in parentMenus)
            {
                orderedMenus.Add(parent);
                var children = moduleMenus.Where(x => x.ParentId == parent.LinkId).OrderBy(x => x.SequenceNo).ToList();
                orderedMenus.AddRange(children);
            }

            var addedIds = orderedMenus.Select(x => x.LinkId).ToHashSet();
            var remaining = moduleMenus.Where(x => !addedIds.Contains(x.LinkId)).OrderBy(x => x.SequenceNo);
            orderedMenus.AddRange(remaining);

            _permissions = orderedMenus.Select(menu => 
            {
                var perm = existing.FirstOrDefault(e => e.LinkID == menu.LinkId);
                return new RolePermissionDto
                {
                    RoleFormID = perm?.RoleFormID ?? 0,
                    RoleID = _selectedRoleId,
                    ModuleID = _selectedModuleId,
                    LinkID = menu.LinkId,
                    PageHeading = menu.PageHeading,
                    PagePath = menu.PagePath,
                    ParentID = menu.ParentId,
                    SequenceNo = menu.SequenceNo,
                    ViewPer = perm?.ViewPer ?? false,
                    InsertPer = perm?.InsertPer ?? false,
                    UpdatePer = perm?.UpdatePer ?? false,
                    DeletePer = perm?.DeletePer ?? false
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading permissions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnPermissionChanged(RolePermissionDto item, string type, bool value)
    {
        switch (type)
        {
            case "View": item.ViewPer = value; break;
            case "Insert": item.InsertPer = value; break;
            case "Update": item.UpdatePer = value; break;
            case "Delete": item.DeletePer = value; break;
        }

        if (item.ParentID == 0)
        {
            var children = _permissions.Where(x => x.ParentID == item.LinkID).ToList();
            foreach (var child in children)
            {
                switch (type)
                {
                    case "View": child.ViewPer = value; break;
                    case "Insert": child.InsertPer = value; break;
                    case "Update": child.UpdatePer = value; break;
                    case "Delete": child.DeletePer = value; break;
                }
            }
        }
    }

    private async Task SaveAsync()
    {
        if (_selectedRoleId == 0 || _selectedModuleId == 0) return;

        try
        {
            _isSaving = true;
            var request = new SaveRolePermissionsRequest
            {
                RoleID = _selectedRoleId,
                ModuleID = _selectedModuleId,
                DashboardPage = _selectedDashboard,
                Permissions = _permissions.ToList()
            };

            await ApiClient.SaveRolePermissionsAsync(_selectedRoleId, _selectedModuleId, request);
            Snackbar.Add("Permissions saved successfully!", Severity.Success);

            // If the updated role belongs to the current user, refresh the sidebar immediately
            if (SessionState.CurrentUser?.RoleId == _selectedRoleId)
            {
                var result = await ApiClient.RefreshSessionAsync(SessionState.CurrentUser.LoginId, _selectedRoleId);

                if (result != null)
                {
                    await SessionState.UpdateUserAsync(JS, result);
                }
            }

            await LoadPermissionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving permissions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}

