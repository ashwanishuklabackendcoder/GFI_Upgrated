@page "/admin/staff"
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject NavigationManager Navigation
@inject AdminSecurityApiClient ApiClient
@inject StoreApiClient StoreApiClient
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using GFI_Upgrated.SharedDto.Store

<PageTitle>Staff</PageTitle>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">Staff</MudText>
            @* <MudText Typo="Typo.body2" Color="Color.Secondary">Staff List</MudText> *@
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewStaff">
            Add New
        </MudButton>
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mb-4" Style="max-width: 500px;">
        <MudTextField T="string" Value="@_search" ValueChanged="@OnSearchTextChanged" Label="Search" Variant="Variant.Outlined" Immediate="true" Class="flex-grow-1" />
        
    </MudStack>

    <MudTable RowsPerPage="25" T="StaffDto" @ref="_table" ServerData="LoadServerDataAsync" Hover="true" Dense="true" Striped="true" Bordered="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="StaffDto" SortLabel="StaffFirstName">Staff Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="StaffDto" SortLabel="StaffNumber">Staff Number</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="StaffDto" SortLabel="DOB">D.O.B</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="StaffDto" SortLabel="MobileNo">Mobile No</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="StaffDto" SortLabel="EmailIDOfficial">EmailID Official</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="StaffDto" SortLabel="GenderName">Gender</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="StaffDto" SortLabel="Status">Status</MudTableSortLabel></MudTh>
            <MudTh>Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Staff Name">@context.StaffName</MudTd>
            <MudTd DataLabel="Staff Number">@context.StaffNumber</MudTd>
            <MudTd DataLabel="D.O.B">@SessionState.FormatDate(context.DOB)</MudTd>
            <MudTd DataLabel="Mobile No">@context.MobileNo</MudTd>
            <MudTd DataLabel="EmailID Official">@context.EmailIDOfficial</MudTd>
            <MudTd DataLabel="Gender">@context.GenderName</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">
                    @GetStatusName(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Action">
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Email" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenSendMailDialogAsync(context))" Title="Send Mail" />
                    <MudIconButton Icon="@Icons.Material.Filled.Key" Color="Color.Success" Size="Size.Small" OnClick="@(() => ResendLoginCredentialsAsync(context))" Title="Resend Login Credentials" />
                    <MudIconButton Icon="@Icons.Material.Filled.History" Color="Color.Warning" Size="Size.Small" OnClick="@(() => OpenMailHistoryDialogAsync(context))" Title="View Mail Status" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditStaffAsync(context.StaffId))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteStaffAsync(context.StaffId))" />
                </MudStack>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Class="pa-4">No staff records found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<StaffDto>? _cachedItems;

    private async Task OnSearchTextChanged(string text)
    {
        _search = text;
        if (_table is not null) await _table.ReloadServerData();
    }

    private MudTable<StaffDto>? _table;
    private string? _search;
    private IReadOnlyList<StatusDto> _statuses = Array.Empty<StatusDto>();

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pagedStatuses = await StoreApiClient.GetStatusesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
            _statuses = pagedStatuses.Items.ToList();
        }
        catch
        {
            _statuses = new List<StatusDto>();
        }
    }

    private string GetStatusName(int statusId)
    {
        var match = _statuses.FirstOrDefault(x => x.StatusId == statusId);
        if (match != null && !string.IsNullOrWhiteSpace(match.StatusName))
        {
            return match.StatusName;
        }
        return statusId switch
        {
            1 => "Active",
            0 => "Inactive",
            _ => statusId.ToString()
        };
    }

    private Color GetStatusColor(int statusId)
    {
        var name = GetStatusName(statusId);
        if (name.Contains("Active", StringComparison.OrdinalIgnoreCase) || statusId == 1)
        {
            return Color.Success;
        }
        return Color.Secondary;
    }

    private async Task<TableData<StaffDto>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        var result = await ApiClient.GetStaffsAsync(new PagedRequest
        {
            CurrentPage = state.Page + 1,
            RecordPerPage = state.PageSize,
            SortColumn = string.IsNullOrWhiteSpace(state.SortLabel) ? "StaffId" : state.SortLabel,
            SortType = state.SortDirection == SortDirection.Ascending ? "ASC" : "DESC"
        }, _search, cancellationToken);

        return new TableData<StaffDto>
        {
            TotalItems = result.TotalRecord,
            Items = result.Items
        };
    }

    private async Task SearchAsync()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private void NewStaff()
    {
        Navigation.NavigateTo("/admin/staff/new");
    }

    private void EditStaffAsync(long staffId)
    {
        Navigation.NavigateTo($"/admin/staff/edit/{staffId}");
    }

    private async Task DeleteStaffAsync(long staffId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete staff record {staffId}?");
        if (!confirmed)
        {
            return;
        }

        await ApiClient.DeleteStaffAsync(staffId, SessionState.CurrentUserAuditName ?? "System");

        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenSendMailDialogAsync(StaffDto staff)
    {
        var parameters = new DialogParameters<SendMailDialog>
        {
            { x => x.StaffId, staff.StaffId },
            { x => x.StaffName, staff.StaffName },
            { x => x.InitialEmail, !string.IsNullOrWhiteSpace(staff.EmailIDOfficial) ? staff.EmailIDOfficial : staff.EmailIDPersonal ?? "" }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<SendMailDialog>("Send Email to Staff", parameters, options);
        await dialog.Result;
    }

    private async Task OpenMailHistoryDialogAsync(StaffDto staff)
    {
        var parameters = new DialogParameters<MailHistoryDialog>
        {
            { x => x.StaffId, staff.StaffId },
            { x => x.StaffName, staff.StaffName }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<MailHistoryDialog>("Mail Send History", parameters, options);
        await dialog.Result;
    }

    private async Task ResendLoginCredentialsAsync(StaffDto staff)
    {
        var email = !string.IsNullOrWhiteSpace(staff.EmailIDOfficial) ? staff.EmailIDOfficial : staff.EmailIDPersonal;
        if (string.IsNullOrWhiteSpace(email))
        {
            Snackbar.Add("This staff member does not have a registered email address.", Severity.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Resend login credentials to {staff.StaffName} at {email}?");
        if (!confirmed) return;

        try
        {
            var success = await ApiClient.ResendStaffLoginAsync(staff.StaffId);
            if (success)
            {
                Snackbar.Add($"Login credentials resent successfully to {email}.", Severity.Success);
            }
            else
            {
                Snackbar.Add("No active user login account exists for this staff member.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}

