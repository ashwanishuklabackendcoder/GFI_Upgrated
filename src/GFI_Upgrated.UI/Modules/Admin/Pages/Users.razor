@page "/admin/users"
@page "/admin/logins"
@inject AppSessionState SessionState
@inject NavigationManager Navigation
@inject AdminSecurityApiClient ApiClient
@inject ISnackbar Snackbar

<PageTitle>Users</PageTitle>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                <MudText Typo="Typo.h5">Users</MudText>
                <AuthorizeAction Action="insert">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NewUser">New User</MudButton>
                </AuthorizeAction>
            </MudStack>
            <MudTextField @bind-Value="_search" Placeholder="Search login name" Variant="Variant.Outlined" Immediate="true" />
            <MudTable Items="_users" Dense="true" Hover="true" Class="mt-4">
                <HeaderContent>
                    <MudTh>Login</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Active</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Login">@context.LoginName</MudTd>
                    <MudTd DataLabel="Name">@context.FirstName @context.LastName</MudTd>
                    <MudTd DataLabel="Active">@context.IsActive</MudTd>
                    <MudTd>
                        <AuthorizeAction Action="update">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => LoadUserAsync(context.LoginId))">Edit</MudButton>
                        </AuthorizeAction>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary" Href="@($"/admin/user-roles?loginId={context.LoginId}")">Roles</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4">
            <EditForm Model="_editor" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <MudText Typo="Typo.h5" Class="mb-4">User Details</MudText>
                <MudTextField @bind-Value="_editor.LoginName" For="@(() => _editor.LoginName)" Label="Login name" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_editor.Password" For="@(() => _editor.Password)" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-3" />
                <MudAutocomplete Clearable="true"        MaxItems="1000" T="StaffLookupDto" Label="Staff" Variant="Variant.Outlined" 
                                 Value="@(_activeStaff.FirstOrDefault(x => x.StaffId == _editor.StaffId))" 
                                 ValueChanged="@((StaffLookupDto val) => OnStaffSelected(val))" 
                                 Class="mb-3"
                                 SearchFunc="@SearchStaff" 
                                 ToStringFunc="@(x => x == null ? "" : FormatStaff(x))"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                <ValidationMessage For="@(() => _editor.StaffId)" />
                <MudAutocomplete Clearable="true"        MaxItems="1000" T="RoleDto" Label="Primary Role" Variant="Variant.Outlined" 
                                 Value="@(_roles.FirstOrDefault(x => x.RoleId == _editor.RoleId))" 
                                 ValueChanged="@((RoleDto val) => { _editor.RoleId = val?.RoleId ?? 0; })" 
                                 Class="mb-3"
                                 SearchFunc="@SearchRoles" 
                                 ToStringFunc="@(x => x?.RoleName ?? "")"
                                 ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true" />
                <ValidationMessage For="@(() => _editor.RoleId)" />
                <MudCheckBox T="bool" @bind-Value="_editor.IsActive" For="@(() => _editor.IsActive)" Label="Is Active" />
                <MudStack Row="true" Spacing="2" Class="mt-4">
                    <AuthorizeAction Action="@(_editor.LoginId > 0 ? "update" : "insert")">
                        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
                    </AuthorizeAction>
                    <MudButton Variant="Variant.Outlined" OnClick="NewUser">Reset</MudButton>
                </MudStack>
            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<UserDto> _users = new();
    private List<StaffLookupDto> _activeStaff = new();
    private List<RoleDto> _roles = new();
    private string? _search;
    private SaveUserRequest _editor = new();

    private async Task<IEnumerable<StaffLookupDto>> SearchStaff(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value)) return _activeStaff;
        return _activeStaff.Where(x => FormatStaff(x).Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<IEnumerable<RoleDto>> SearchRoles(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value) || _roles.Any(x => (x.RoleName ?? "").Equals(value, StringComparison.OrdinalIgnoreCase))) return _roles;
        return _roles.Where(x => (x.RoleName ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadActiveStaffAsync();
        await LoadRolesAsync();
    }

    private async Task LoadAsync()
    {
        var result = await ApiClient.GetUsersAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 100 }, _search);
        _users = result.Items.ToList();
    }

    private async Task LoadActiveStaffAsync()
    {
        _activeStaff = (await ApiClient.GetActiveStaffAsync()).ToList();
    }

    private async Task LoadRolesAsync()
    {
        var result = await ApiClient.GetRolesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
        _roles = result.Items.ToList();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editor.LoginName))
        {
            Snackbar.Add("Login name is required.", Severity.Warning);
            return;
        }

        try
        {
            _editor.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            _editor.UpdatedBy = SessionState.CurrentUserAuditName ?? "System";
            var res = await ApiClient.SaveUserAsync(_editor);
            if (res == -1)
            {
                Snackbar.Add("This username is already registered. Please try with another username.", Severity.Error);
            }
            else if (res == -2)
            {
                Snackbar.Add("This staff member is already assigned to a login account.", Severity.Error);
            }
            else if (res > 0)
            {
                Snackbar.Add("User saved successfully.", Severity.Success);
                await LoadAsync();
                NewUser();
            }
            else
            {
                Snackbar.Add("Error saving user.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving user: {ex.Message}", Severity.Error);
        }
    }

    private void OnStaffSelected(StaffLookupDto? val)
    {
        _editor.StaffId = val?.StaffId ?? 0;
        if (val != null)
        {
            if (string.IsNullOrWhiteSpace(_editor.LoginName) && !string.IsNullOrWhiteSpace(val.Email))
            {
                _editor.LoginName = val.Email;
            }
            if (string.IsNullOrWhiteSpace(_editor.ForgotEmail) && !string.IsNullOrWhiteSpace(val.Email))
            {
                _editor.ForgotEmail = val.Email;
            }
        }
    }

    private void NewUser()
    {
        _editor = new SaveUserRequest
        {
            IsActive = true
        };
    }

    private async Task LoadUserAsync(long loginId)
    {
        var selected = await ApiClient.GetUserByIdAsync(loginId);
        if (selected is null)
        {
            return;
        }

        _editor = new SaveUserRequest
        {
            LoginId = selected.LoginId,
            LoginName = selected.LoginName,
            Password = selected.Password ?? string.Empty,
            ForgotEmail = selected.ForgotEmail,
            StaffId = selected.StaffId,
            IsActive = selected.IsActive,
            RoleId = selected.RoleId
        };

        await EnsureStaffVisibleAsync(selected.StaffId);
    }

    private async Task EnsureStaffVisibleAsync(long staffId)
    {
        if (staffId == 0 || _activeStaff.Any(staff => staff.StaffId == staffId))
        {
            return;
        }

        var staff = await ApiClient.GetStaffByIdAsync(staffId);
        if (staff is null)
        {
            return;
        }

        _activeStaff.Add(new StaffLookupDto
        {
            StaffId = staff.StaffId,
            StaffName = staff.StaffName,
            Email = staff.EmailIDOfficial,
            Status = staff.Status,
            IsActive = staff.Status == 1
        });
    }

    private static string FormatStaff(StaffLookupDto staff)
    {
        if (!string.IsNullOrWhiteSpace(staff.Email))
        {
            return $"{staff.StaffName} ({staff.Email})";
        }

        return staff.StaffName;
    }
}

