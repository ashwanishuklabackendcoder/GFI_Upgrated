@page "/admin/users"
@page "/admin/logins"
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject NavigationManager Navigation
@inject AdminSecurityApiClient ApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Users</PageTitle>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
                <MudText Typo="Typo.h5">Users</MudText>
                <AuthorizeAction Action="insert">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="NewUser">New User</MudButton>
                </AuthorizeAction>
            </MudStack>
            <MudTextField @bind-Value="_search" Placeholder="Search" Variant="Variant.Outlined" Immediate="true" />
            <MudTable Items="_users" Dense="true" Hover="true" Class="mt-4" Filter="new Func<UserDto,bool>(FilterFunc1)">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortLabel="LoginName" T="UserDto">Login</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="FirstName" T="UserDto">Name</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="IsActive" T="UserDto">Active</MudTableSortLabel></MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Login">@context.LoginName</MudTd>
                    <MudTd DataLabel="Name">@context.FirstName @context.LastName</MudTd>
                    <MudTd DataLabel="Active">@context.IsActive</MudTd>
                    <MudTd>
                        <AuthorizeAction Action="update">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="@(() => LoadUserAsync(context.LoginId))" Title="Edit" />
                        </AuthorizeAction>
                        <AuthorizeAction Action="delete">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteUserAsync(context.LoginId))" Title="Delete" />
                        </AuthorizeAction>
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Security" Color="Color.Secondary" Href="@($"/admin/user-roles?loginId={context.LoginId}")" Title="Roles" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4">
            <EditForm Model="_editor" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <MudText Typo="Typo.h5" Class="mb-4">Add New Login</MudText>
                <div class="mb-3">
                    <GFI_Upgrated.UI.Modules.Admin.Components.SearchableSelect T="long" Label="Staff" Clearable="true" Variant="Variant.Outlined"
                                     Value="_editor.StaffId"
                                     ValueChanged="@((long val) => OnStaffSelected(val))"
                                     Items="GetStaffSelects()"
                                     EmptyMessage="All staff users already have a login assigned. You can edit existing users by selecting them from the grid." />
                </div>
                <MudTextField @bind-Value="_editor.LoginName" For="@(() => _editor.LoginName)" Label="User ID" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_editor.Password" For="@(() => _editor.Password)" Label="Password" Variant="Variant.Outlined" InputType="@_passwordInputType" Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="TogglePasswordVisibility" Class="mb-3" />
               
                <ValidationMessage For="@(() => _editor.StaffId)" />
                <div class="mb-3">
                    <GFI_Upgrated.UI.Modules.Admin.Components.SearchableSelect T="long" Label="Primary Role" Clearable="true" Variant="Variant.Outlined"
                                     Value="_editor.RoleId"
                                     ValueChanged="@((long val) => { _editor.RoleId = val; })"
                                     Items="GetRoleSelects()" />
                </div>
                <ValidationMessage For="@(() => _editor.RoleId)" />
                <MudCheckBox T="bool" @bind-Value="_editor.IsActive" For="@(() => _editor.IsActive)" Label="Is Active" />
                <MudStack Row="true" Spacing="2" Class="mt-4">
                    <AuthorizeAction Action="@(_editor.LoginId > 0 ? "update" : "insert")">
                        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
                    </AuthorizeAction>
                    <MudButton Variant="Variant.Outlined" OnClick="NewUser">Reset</MudButton>
                </MudStack>
            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<UserDto> _users = new();
    private List<StaffLookupDto> _activeStaff = new();
    private List<RoleDto> _roles = new();
    private string? _search;
    private SaveUserRequest _editor = new();
    private bool _isShowPassword = false;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private bool FilterFunc1(UserDto user)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;
        if (user.LoginName?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if ($"{user.FirstName} {user.LastName}".Contains(_search, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        return false;
    }

    private void TogglePasswordVisibility()
    {
        if (_isShowPassword)
        {
            _isShowPassword = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInputType = InputType.Password;
        }
        else
        {
            _isShowPassword = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInputType = InputType.Text;
        }
    }

    private IEnumerable<GFI_Upgrated.UI.Modules.Admin.Components.SearchableSelect<long>.SelectItemDto<long>> GetStaffSelects()
    {
        return _activeStaff.Select(x => new GFI_Upgrated.UI.Modules.Admin.Components.SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.StaffId,
            Text = FormatStaff(x)
        });
    }

    private IEnumerable<GFI_Upgrated.UI.Modules.Admin.Components.SearchableSelect<long>.SelectItemDto<long>> GetRoleSelects()
    {
        return _roles.Select(x => new GFI_Upgrated.UI.Modules.Admin.Components.SearchableSelect<long>.SelectItemDto<long>
        {
            Value = x.RoleId,
            Text = x.RoleName ?? ""
        });
    }

    protected override void OnInitialized()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadActiveStaffAsync();
        await LoadRolesAsync();
    }

    private async Task LoadAsync()
    {
        var result = await ApiClient.GetUsersAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 100 }, _search);
        _users = result.Items.ToList();
    }

    private async Task LoadActiveStaffAsync()
    {
        _activeStaff = (await ApiClient.GetUnassignedStaffAsync()).ToList();
    }

    private async Task LoadRolesAsync()
    {
        var result = await ApiClient.GetRolesAsync(new PagedRequest { CurrentPage = 1, RecordPerPage = 1000 });
        _roles = result.Items.ToList();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editor.LoginName))
        {
            Snackbar.Add("Login name is required.", Severity.Warning);
            return;
        }

        try
        {
            _editor.CreatedBy = SessionState.CurrentUserAuditName ?? "System";
            _editor.UpdatedBy = SessionState.CurrentUserAuditName ?? "System";
            var res = await ApiClient.SaveUserAsync(_editor);
            if (res == -1)
            {
                Snackbar.Add("This username is already registered. Please try with another username.", Severity.Error);
            }
            else if (res == -2)
            {
                Snackbar.Add("This staff member is already assigned to a login account.", Severity.Error);
            }
            else if (res > 0)
            {
                Snackbar.Add("User saved successfully.", Severity.Success);
                await LoadAsync();
                NewUser();
            }
            else
            {
                Snackbar.Add("Error saving user.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving user: {ex.Message}", Severity.Error);
        }
    }

    private void OnStaffSelected(long val)
    {
        _editor.StaffId = val;
        var staff = _activeStaff.FirstOrDefault(x => x.StaffId == val);
        if (staff != null)
        {
            if (string.IsNullOrWhiteSpace(_editor.LoginName) && !string.IsNullOrWhiteSpace(staff.Email))
            {
                _editor.LoginName = staff.Email;
            }
            if (string.IsNullOrWhiteSpace(_editor.ForgotEmail) && !string.IsNullOrWhiteSpace(staff.Email))
            {
                _editor.ForgotEmail = staff.Email;
            }
        }
    }

    private void NewUser()
    {
        _editor = new SaveUserRequest
        {
            IsActive = true
        };
    }

    private async Task LoadUserAsync(long loginId)
    {
        var selected = await ApiClient.GetUserByIdAsync(loginId);
        if (selected is null)
        {
            return;
        }

        var roles = await ApiClient.GetUserRolesAsync(loginId);
        var defaultRole = roles.FirstOrDefault(x => x.IsDefault) ?? roles.FirstOrDefault();
        long roleId = defaultRole?.RoleId ?? selected.RoleId;

        _editor = new SaveUserRequest
        {
            LoginId = selected.LoginId,
            LoginName = selected.LoginName,
            Password = selected.Password ?? string.Empty,
            ForgotEmail = selected.ForgotEmail,
            StaffId = selected.StaffId,
            IsActive = selected.IsActive,
            RoleId = roleId
        };

        await EnsureStaffVisibleAsync(selected.StaffId);
    }

    private async Task EnsureStaffVisibleAsync(long staffId)
    {
        if (staffId == 0 || _activeStaff.Any(staff => staff.StaffId == staffId))
        {
            return;
        }

        var staff = await ApiClient.GetStaffByIdAsync(staffId);
        if (staff is null)
        {
            return;
        }

        _activeStaff.Add(new StaffLookupDto
        {
            StaffId = staff.StaffId,
            StaffName = staff.StaffName,
            Email = staff.EmailIDOfficial,
            Status = staff.Status,
            IsActive = staff.Status == 1
        });
    }

    private static string FormatStaff(StaffLookupDto staff)
    {
        if (!string.IsNullOrWhiteSpace(staff.Email))
        {
            return $"{staff.StaffName} ({staff.Email})";
        }

        return staff.StaffName;
    }
    private async Task DeleteUserAsync(long loginId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this user login?");
        
        if (confirmed)
        {
            try
            {
                var response = await ApiClient.DeleteUserAsync(loginId);
                if (response > 0)
                {
                    Snackbar.Add("User deleted successfully.", Severity.Success);
                    await LoadAsync();
                }
                else
                {
                    Snackbar.Add("Failed to delete user.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }
}

