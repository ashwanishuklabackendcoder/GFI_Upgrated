@page "/admin"
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject NavigationManager Navigation
@inject GFI_Upgrated.UI.Services.AdminSecurityApiClient ApiClient
@inject GFI_Upgrated.UI.Services.StoreApiClient StoreApiClient

<PageTitle>System Dashboard</PageTitle>

<div class="dashboard-page">
    <section class="dashboard-hero">
        <h1 class="dashboard-hero-title">Dashboard</h1>
        <p class="dashboard-hero-subtitle">A professional workspace for managing users, roles, menus, and permissions.</p>
    </section>

    <section class="dashboard-kpi-grid">
        @if (_loading)
        {
            <div class="p-4"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="p-4">
                <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
            </div>
        }
        else if (_dashboardData != null)
        {
            <article class="dashboard-kpi-card">
                <div class="kpi-badge violet">
                    <i class="ti ti-users"></i>
                </div>
                <div class="kpi-label">Total Users</div>
                <p class="mb-1 mt-3 text-secondary">Active users</p>
                <div class="kpi-value mb-3">@_dashboardData.TotalUsers.Value.ToString("N0")</div>
                <span class="badge rounded-pill" style="background:#e2f7e9;color:#16a34a;">+Active</span>
            </article>

            <article class="dashboard-kpi-card">
                <div class="kpi-badge green">
                    <i class="ti ti-login"></i>
                </div>
                <div class="kpi-label">Active Logins</div>
                <p class="mb-1 mt-3 text-secondary">Last 7 days</p>
                <div class="kpi-value mb-3">@_dashboardData.ActiveLogins.Value.ToString("N0")</div>
                <span class="badge rounded-pill" style="@(_dashboardData.ActiveLogins.IsPositive ? "background:#e2f7e9;color:#16a34a;" : "background:#ffe7ea;color:#ff5b78;")">@_dashboardData.ActiveLogins.GrowthPercentage.ToString("0.0")%</span>
            </article>

            <article class="dashboard-kpi-card">
                <div class="kpi-badge pink">
                    <i class="ti ti-shield-lock"></i>
                </div>
                <div class="kpi-label">Total Roles</div>
                <p class="mb-1 mt-3 text-secondary">System config</p>
                <div class="kpi-value mb-3">@_dashboardData.TotalRoles.Value.ToString("N0")</div>
                <span class="badge rounded-pill" style="background:#e2f7e9;color:#16a34a;">+Active</span>
            </article>

            <article class="dashboard-kpi-card">
                <div class="kpi-badge blue">
                    <i class="ti ti-activity"></i>
                </div>
                <div class="kpi-label">Activity Logs</div>
                <p class="mb-1 mt-3 text-secondary">Last 7 days</p>
                <div class="kpi-value mb-3">@_dashboardData.ActivityLogs.Value.ToString("N0")</div>
                <span class="badge rounded-pill" style="@(_dashboardData.ActivityLogs.IsPositive ? "background:#e2f7e9;color:#16a34a;" : "background:#ffe7ea;color:#ff5b78;")">@_dashboardData.ActivityLogs.GrowthPercentage.ToString("0.0")%</span>
            </article>
        }
    </section>

    <section class="dashboard-panels mt-4">
        @if (_dashboardData != null && !_loading)
        {
            <article class="dashboard-panel">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">System Activity</h2>
                        <div class="panel-subtitle">Logins in the past 7 days</div>
                    </div>
                </div>

                <div class="report-chart mt-4">
                    @if (_dashboardData.LoginsByDay != null && _dashboardData.LoginsByDay.Any())
                    {
                        var maxVal = _dashboardData.LoginsByDay.Max(x => x.Value);
                        if (maxVal == 0) maxVal = 1;
                        foreach (var day in _dashboardData.LoginsByDay)
                        {
                            var height = (day.Value / (decimal)maxVal) * 100;
                            <div class="report-bar">
                                <span>@day.Value</span>
                                <div class="bar @(height == 100 ? "highlight" : "")" style="height:@((int)height)%"></div>
                                <small class="text-secondary">@day.Label</small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-secondary">No recent login data.</p>
                    }
                </div>
            </article>
        }

        @if (_salesData != null && !_loading)
        {
            <article class="dashboard-panel">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Sales by Year</h2>
                        <div class="panel-subtitle">Total sales overview</div>
                    </div>
                </div>
                <div class="report-chart mt-4">
                    @if (_salesData.SalesPerYear != null && _salesData.SalesPerYear.Any())
                    {
                        var maxVal = _salesData.SalesPerYear.Max(x => x.SalesAmount);
                        if (maxVal == 0) maxVal = 1m;
                        foreach (var yearData in _salesData.SalesPerYear)
                        {
                            var height = (yearData.SalesAmount / maxVal) * 100;
                            <div class="report-bar">
                                <span>@yearData.SalesAmount.ToString("C0")</span>
                                <div class="bar @(height == 100 ? "highlight" : "")" style="height:@((int)height)%"></div>
                                <small class="text-secondary">@yearData.Year</small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-secondary">No sales data available.</p>
                    }
                </div>
            </article>

            <article class="dashboard-panel">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Top Items Sold</h2>
                    </div>
                </div>
                <div class="mt-4">
                    @if (_salesData.TotalSales != null && _salesData.TotalSales.Any())
                    {
                        <MudTable Items="@_salesData.TotalSales.Take(5)" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0">
                            <HeaderContent>
                                <MudTh>Item</MudTh>
                                <MudTh Style="text-align:right">Qty</MudTh>
                                <MudTh Style="text-align:right">Amount</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Item">@context.ItemName</MudTd>
                                <MudTd DataLabel="Quantity" Style="text-align:right">@context.Quantity.ToString("N0")</MudTd>
                                <MudTd DataLabel="Amount" Style="text-align:right">@context.TotalAmount.ToString("C0")</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <p class="text-secondary">No items data available.</p>
                    }
                </div>
            </article>
        }
    </section>

</div>

@code {
    private GFI_Upgrated.SharedDto.AdminSecurity.AdminDashboardDto? _dashboardData;
    private GFI_Upgrated.SharedDto.Store.SalesDashboardDto? _salesData;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var adminTask = ApiClient.GetAdminDashboardMetricsAsync();
            var salesTask = StoreApiClient.GetSalesDashboardAsync();
            
            await Task.WhenAll(adminTask, salesTask);
            
            _dashboardData = await adminTask;
            _salesData = await salesTask;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load dashboard metrics: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}

