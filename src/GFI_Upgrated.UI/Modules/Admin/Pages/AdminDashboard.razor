@page "/admin"
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject NavigationManager Navigation
@inject GFI_Upgrated.UI.Services.AdminSecurityApiClient ApiClient
@inject GFI_Upgrated.UI.Services.StoreApiClient StoreApiClient

<PageTitle>System Dashboard</PageTitle>

<div class="row">
    @if (_loading)
    {
        <div class="col-12 p-4 text-center"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="col-12 p-4">
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        </div>
    }
    else if (_dashboardData != null)
    {
        <!-- Total Users -->
        <div class="col-sm-6 col-lg-3 mb-4">
            <div class="card card-border-shadow-primary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-primary"><i class="ti ti-users ti-md"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@_dashboardData.TotalUsers.Value.ToString("N0")</h4>
                    </div>
                    <p class="mb-1 fw-medium">Total Users</p>
                    <p class="mb-0">
                        <span class="fw-medium me-1 text-success">+Active</span>
                        <small class="text-muted">Active users</small>
                    </p>
                </div>
            </div>
        </div>

        <!-- Active Logins -->
        <div class="col-sm-6 col-lg-3 mb-4">
            <div class="card card-border-shadow-success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-success"><i class="ti ti-login ti-md"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@_dashboardData.ActiveLogins.Value.ToString("N0")</h4>
                    </div>
                    <p class="mb-1 fw-medium">Active Logins</p>
                    <p class="mb-0">
                        <span class="fw-medium me-1 @(_dashboardData.ActiveLogins.IsPositive ? "text-success" : "text-danger")">@_dashboardData.ActiveLogins.GrowthPercentage.ToString("0.0")%</span>
                        <small class="text-muted">Last 7 days</small>
                    </p>
                </div>
            </div>
        </div>

        <!-- Total Roles -->
        <div class="col-sm-6 col-lg-3 mb-4">
            <div class="card card-border-shadow-warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-warning"><i class="ti ti-shield-lock ti-md"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@_dashboardData.TotalRoles.Value.ToString("N0")</h4>
                    </div>
                    <p class="mb-1 fw-medium">Total Roles</p>
                    <p class="mb-0">
                        <span class="fw-medium me-1 text-success">+Active</span>
                        <small class="text-muted">System config</small>
                    </p>
                </div>
            </div>
        </div>

        <!-- Activity Logs -->
        <div class="col-sm-6 col-lg-3 mb-4">
            <div class="card card-border-shadow-info h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2 pb-1">
                        <div class="avatar me-2">
                            <span class="avatar-initial rounded bg-label-info"><i class="ti ti-activity ti-md"></i></span>
                        </div>
                        <h4 class="ms-1 mb-0">@_dashboardData.ActivityLogs.Value.ToString("N0")</h4>
                    </div>
                    <p class="mb-1 fw-medium">Activity Logs</p>
                    <p class="mb-0">
                        <span class="fw-medium me-1 @(_dashboardData.ActivityLogs.IsPositive ? "text-success" : "text-danger")">@_dashboardData.ActivityLogs.GrowthPercentage.ToString("0.0")%</span>
                        <small class="text-muted">Last 7 days</small>
                    </p>
                </div>
            </div>
        </div>
    }
</div>

<div class="row">
    @if (_dashboardData != null && !_loading)
    {
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">System Activity</h5>
                    <small class="text-muted">Logins in the past 7 days</small>
                </div>
                <div class="card-body pb-0">
                    <ul class="p-0 m-0">
                        @if (_dashboardData.LoginsByDay != null && _dashboardData.LoginsByDay.Any())
                        {
                            var maxVal = _dashboardData.LoginsByDay.Max(x => x.Value);
                            if (maxVal == 0) maxVal = 1;
                            foreach (var day in _dashboardData.LoginsByDay)
                            {
                                var height = (day.Value / (decimal)maxVal) * 100;
                                <li class="d-flex mb-3 align-items-center">
                                    <div class="w-100 me-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <h6 class="mb-0">@day.Label</h6>
                                            <span class="text-muted">@day.Value</span>
                                        </div>
                                        <div class="progress" style="height: 8px;">
                                            <div class="progress-bar @(height == 100 ? "bg-primary" : "bg-label-primary")" role="progressbar" style="width: @((int)height)%" aria-valuenow="@((int)height)" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <p class="text-secondary">No recent login data.</p>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    @if (_salesData != null && !_loading)
    {
        <div class="col-lg-6 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between">
                    <h5 class="card-title mb-0">Top Items Sold</h5>
                </div>
                <div class="card-body">
                    @if (_salesData.TotalSales != null && _salesData.TotalSales.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-borderless table-sm">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th class="text-end">Qty</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach(var item in _salesData.TotalSales.Take(5))
                                    {
                                        <tr>
                                            <td>@item.ItemName</td>
                                            <td class="text-end">@item.Quantity.ToString("N0")</td>
                                            <td class="text-end fw-medium text-success">@item.TotalAmount.ToString("C0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary">No items data available.</p>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private GFI_Upgrated.SharedDto.AdminSecurity.AdminDashboardDto? _dashboardData;
    private GFI_Upgrated.SharedDto.Store.SalesDashboardDto? _salesData;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!SessionState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            var adminTask = ApiClient.GetAdminDashboardMetricsAsync();
            var salesTask = StoreApiClient.GetSalesDashboardAsync();
            
            await Task.WhenAll(adminTask, salesTask);
            
            _dashboardData = await adminTask;
            _salesData = await salesTask;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load dashboard metrics: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}

