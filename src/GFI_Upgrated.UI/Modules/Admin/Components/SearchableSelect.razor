@typeparam T

<div style="position: relative; width: 100%; display: block;" class="w-full">
    <MudTextField @ref="_textField"
                  T="string"
                  Label="@Label"
                  Value="@(_isFocused ? _searchString : GetSelectedText())"
                  ValueChanged="OnSearchChanged"
                  Immediate="true"
                  Variant="@Variant"
                  ReadOnly="false"
                  Disabled="@Disabled"
                  Required="@Required"
                  Clearable="@Clearable"
                  OnClearButtonClick="OnClear"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.ArrowDropDown"
                  Margin="@(Dense ? Margin.Dense : Margin.None)"
                  Class="w-full"
                  @onfocus="OnFocus"
                  @onblur="OnBlur" />

    <MudPopover Open="@_isFocused" AnchorOrigin="@AnchorOrigin" TransformOrigin="Origin.TopCenter" MaxHeight="450">
        <div style="width: 300px; display: flex; flex-direction: column; background: white; border-radius: 4px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);">
            <div style="overflow-y: auto; max-height: 350px;">
                @if (MultiSelection)
                {
                    @foreach (var item in GetFilteredItems())
                    {
                        <div class="px-4 py-2 hover:bg-gray-100 d-flex align-center cursor-pointer" @onmousedown="@(() => ToggleMultiSelect(item.Value))">
                            <MudCheckBox T="bool"
                                         Value="@IsItemSelected(item.Value)"
                                         ValueChanged="@((bool val) => ToggleMultiSelect(item.Value))"
                                         Label="@item.Text"
                                         Color="Color.Primary"
                                         Class="m-0 pointer-events-none" />
                        </div>
                    }
                }
                else
                {
                    @foreach (var item in GetFilteredItems())
                    {
                        <div class="px-4 py-3 hover:bg-gray-100 cursor-pointer" style="transition: background-color 0.2s;" @onmousedown="@(() => SelectItem(item))">
                            @item.Text
                        </div>
                    }
                }
            </div>
        </div>
    </MudPopover>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public T? Value { get; set; }
    [Parameter] public EventCallback<T> ValueChanged { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Origin AnchorOrigin { get; set; } = Origin.BottomCenter;
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Dense { get; set; }
    [Parameter] public bool MultiSelection { get; set; }
    [Parameter] public IReadOnlyCollection<T>? SelectedValues { get; set; }
    [Parameter] public EventCallback<IReadOnlyCollection<T>> SelectedValuesChanged { get; set; }
    [Parameter] public Func<System.Collections.Generic.IEnumerable<string>, string>? MultiSelectionTextFunc { get; set; }
    [Parameter] public bool Clearable { get; set; }

    [Parameter] public IEnumerable<SelectItemDto<T>> Items { get; set; } = Array.Empty<SelectItemDto<T>>();

    private MudTextField<string>? _textField;
    private string _searchString = "";
    private bool _isFocused = false;

    private void OnSearchChanged(string search)
    {
        _searchString = search;
        StateHasChanged();
    }

    private void OnFocus()
    {
        _isFocused = true;
        _searchString = ""; // Start fresh search when focused
        StateHasChanged();
    }

    private async Task OnBlur()
    {
        // Delay slightly to allow click events on menu items to process before we lose focus and change the text back
        await Task.Delay(200);
        _isFocused = false;
        _searchString = "";
        StateHasChanged();
    }

    private IEnumerable<SelectItemDto<T>> GetFilteredItems()
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return Items;
        return Items.Where(x => (x.Text ?? "").Contains(_searchString, StringComparison.OrdinalIgnoreCase));
    }

    private string GetSelectedText()
    {
        if (MultiSelection)
        {
            if (SelectedValues == null || !SelectedValues.Any()) return "";
            var texts = Items.Where(x => SelectedValues.Contains(x.Value)).Select(x => x.Text);
            if (MultiSelectionTextFunc != null)
            {
                return MultiSelectionTextFunc(texts);
            }
            return string.Join(", ", texts);
        }

        var selectedItem = Items.FirstOrDefault(x => EqualityComparer<T>.Default.Equals(x.Value, Value));
        return selectedItem?.Text ?? "";
    }

    private async Task SelectItem(SelectItemDto<T> item)
    {
        Value = item.Value;
        _isFocused = false;
        _searchString = "";
        await ValueChanged.InvokeAsync(item.Value);
        
        if (_textField != null)
        {
            await _textField.BlurAsync();
        }
        
        StateHasChanged();
    }

    private bool IsItemSelected(T? val)
    {
        if (SelectedValues == null) return false;
        return SelectedValues.Contains(val);
    }

    private async Task ToggleMultiSelect(T? val)
    {
        var current = SelectedValues != null ? new List<T>(SelectedValues) : new List<T>();
        if (current.Contains(val!))
        {
            current.Remove(val!);
        }
        else
        {
            current.Add(val!);
        }
        SelectedValues = current.AsReadOnly();
        await SelectedValuesChanged.InvokeAsync(SelectedValues);
        StateHasChanged();
    }

    private async Task OnClear()
    {
        if (MultiSelection)
        {
            SelectedValues = Array.Empty<T>();
            await SelectedValuesChanged.InvokeAsync(SelectedValues);
        }
        else
        {
            Value = default;
            await ValueChanged.InvokeAsync(default);
        }
        _isFocused = false;
        _searchString = "";
    }

    public class SelectItemDto<TItem>
    {
        public TItem? Value { get; set; }
        public string Text { get; set; } = string.Empty;
    }
}
