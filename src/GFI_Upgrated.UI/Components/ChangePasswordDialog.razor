@using GFI_Upgrated.SharedDto.AdminSecurity
@using GFI_Upgrated.UI.Services
@using GFI_Upgrated.UI.State
@using MudBlazor
@inject AdminSecurityApiClient ApiClient
@inject AppSessionState SessionState
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" IsValid="@_isValid">
            <MudTextField @bind-Value="_model.CurrentPassword" For="@(() => _model.CurrentPassword)" Label="Current Password" InputType="InputType.Password" Required="true" RequiredError="Current password is required!" Class="mb-3" />
            <MudTextField @bind-Value="_model.NewPassword" For="@(() => _model.NewPassword)" Label="New Password" InputType="InputType.Password" Required="true" RequiredError="New password is required!" Class="mb-3" />
            <MudTextField @bind-Value="_confirmPassword" Label="Confirm New Password" InputType="InputType.Password" Required="true" RequiredError="Please confirm new password!" Validation="@(new Func<string, string?>(MatchPasswords))" Class="mb-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@_isSubmitting">Change Password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private bool _isValid;
    private bool _isSubmitting;
    private ChangePasswordRequest _model = new();
    private string _confirmPassword = string.Empty;

    private string? MatchPasswords(string arg)
    {
        if (_model.NewPassword != arg)
            return "Passwords don't match";
        return null;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Submit()
    {
        await _form.Validate();
        if (_form.IsValid)
        {
            _isSubmitting = true;
            try
            {
                _model.LoginId = SessionState.CurrentUser?.LoginId ?? 0;
                var result = await ApiClient.ChangePasswordAsync(_model);
                if (result)
                {
                    Snackbar.Add("Password changed successfully!", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    Snackbar.Add("Current password is incorrect or update failed.", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
            finally
            {
                _isSubmitting = false;
            }
        }
    }
}
