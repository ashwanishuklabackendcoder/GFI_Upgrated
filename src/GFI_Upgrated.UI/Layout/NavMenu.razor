@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject LocalizationState LocalizationState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="container-xxl d-flex h-100">
    <ul class="menu-inner">
        @if (SessionState.IsLoggedIn)
        {
            var dashPath = !string.IsNullOrWhiteSpace(SessionState.CurrentUser?.DashboardPath) ? SessionState.CurrentUser.DashboardPath : "/blank";
            var dashMatch = Navigation.Uri.EndsWith(dashPath, StringComparison.OrdinalIgnoreCase) || Navigation.Uri.EndsWith("/admin", StringComparison.OrdinalIgnoreCase);
            
            <li class="menu-item @(dashMatch ? "active" : "")">
                <a href="@dashPath" class="menu-link">
                    <i class="menu-icon tf-icons icon-base ti ti-dashboard"></i>
                    <div data-i18n="Dashboard">@LocalizationState.Text("Menu.Dashboard", "Dashboard")</div>
                </a>
            </li>
        }

        @if (SessionState.CurrentUser?.Menus != null)
        {
            @foreach (var group in SessionState.CurrentUser.Menus.Where(m => m.ShowInMenu).OrderBy(m => m.SequenceNo))
            {
                var validChildren = (group.SubMenus ?? Enumerable.Empty<GFI_Upgrated.SharedDto.AdminSecurity.MenuDto>())
                    .Where(s => s.IsView && s.ShowInMenu && !string.IsNullOrWhiteSpace(s.PagePath))
                    .OrderBy(s => s.SequenceNo)
                    .ToList();

                if (group.IsView && !string.IsNullOrWhiteSpace(group.PagePath) && group.PagePath != "#")
                {
                    var parentPath = SessionState.GetHardmappedRoute(group.PagePath, group.PageHeading ?? string.Empty);
                    if (!validChildren.Any(c => SessionState.GetHardmappedRoute(c.PagePath, c.PageHeading ?? string.Empty) == parentPath))
                    {
                        validChildren.Insert(0, new GFI_Upgrated.SharedDto.AdminSecurity.MenuDto 
                        { 
                            PageHeading = group.PageHeading, 
                            DisplayName = group.DisplayName,
                            IconClass = group.IconClass,
                            PagePath = group.PagePath, 
                            IsView = true 
                        });
                    }
                }

                if (validChildren.Count == 0) continue;

                var groupTitle = GetMenuText(group);
                var groupIcon = !string.IsNullOrEmpty(group.IconClass) ? group.IconClass : "icon-base ti ti-folder";

                <li class="menu-item @(IsActive(group) ? "active" : "")">
                    <a href="javascript:void(0)" class="menu-link menu-toggle">
                        <i class="menu-icon tf-icons @groupIcon"></i>
                        <div data-i18n="@groupTitle">@groupTitle</div>
                    </a>
                    <ul class="menu-sub">
                        @foreach (var item in validChildren)
                        {
                            var itemTitle = GetMenuText(item);
                            var itemIcon = !string.IsNullOrEmpty(item.IconClass) ? item.IconClass : "icon-base ti ti-point";
                            var itemHref = SessionState.GetHardmappedRoute(item.PagePath, item.PageHeading ?? string.Empty);
                            var match = itemHref == "/admin" ? NavLinkMatch.All : NavLinkMatch.Prefix;

                            <li class="menu-item @(IsItemActive(itemHref, match) ? "active" : "")">
                                <a href="@itemHref" class="menu-link">
                                    <i class="menu-icon tf-icons @itemIcon"></i>
                                    <div data-i18n="@itemTitle">@itemTitle</div>
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
        }
    </ul>
</div>

@code {
    private int _menuCount = 0;

    protected override void OnInitialized()
    {
        SessionState.OnChange += StateHasChanged;
        LocalizationState.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var currentCount = SessionState.CurrentUser?.Menus?.Count ?? 0;
        if (currentCount > 0 && _menuCount != currentCount)
        {
            _menuCount = currentCount;
            try {
                await JSRuntime.InvokeVoidAsync("reinitVuexyMenu");
            } catch { }
        }
        else if (firstRender && currentCount > 0)
        {
            try {
                await JSRuntime.InvokeVoidAsync("reinitVuexyMenu");
            } catch { }
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    private bool IsItemActive(string itemHref, NavLinkMatch match)
    {
        var currentPath = "/"+ Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLower();
        var targetPath = itemHref.Trim('/').ToLower();
        
        if (targetPath == "/") targetPath = "";
        if (currentPath == "/") currentPath = "";

        if (match == NavLinkMatch.All)
        {
            return currentPath == targetPath || (string.IsNullOrEmpty(currentPath) && targetPath == "/admin");
        }
        
        if (string.IsNullOrEmpty(targetPath)) return false;
        
        return currentPath.StartsWith(targetPath);
    }

    private bool IsActive(GFI_Upgrated.SharedDto.AdminSecurity.MenuDto group)
    {
        try 
        {
            if (SessionState.CurrentUser?.Menus == null) return false;
            
            var currentPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLower();
            var groupHref = SessionState.GetHardmappedRoute(group.PagePath, group.PageHeading ?? string.Empty).Trim('/').ToLower();
            
            if (groupHref == currentPath || (currentPath == "/" && groupHref == "/admin")) return true;

            if (group.SubMenus != null)
            {
                if (group.SubMenus.Any(s => {
                    var sHref = SessionState.GetHardmappedRoute(s.PagePath, s.PageHeading ?? string.Empty).Trim('/').ToLower();
                    return currentPath.StartsWith(sHref) && sHref != "";
                }))
                {
                    return true;
                }
            }
        } 
        catch 
        {
            // Ignore if routing check fails
        }
        
        return false;
    }

    private string CleanLabel(string? label)
    {
        if (string.IsNullOrWhiteSpace(label)) return "";
        var clean = label.TrimStart('_').Trim();
        // Add spaces before capital letters if not already spaced
        return System.Text.RegularExpressions.Regex.Replace(clean, "([a-z])([A-Z])", "$1 $2");
    }

    private string GetMenuText(GFI_Upgrated.SharedDto.AdminSecurity.MenuDto menu)
    {
        var fallback = !string.IsNullOrWhiteSpace(menu.DisplayName) ? menu.DisplayName! : CleanLabel(menu.PageHeading);
        return string.IsNullOrWhiteSpace(menu.PageHeading)
            ? fallback
            : LocalizationState.Text(menu.PageHeading, fallback);
    }

    public void Dispose()
    {
        SessionState.OnChange -= StateHasChanged;
        LocalizationState.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
