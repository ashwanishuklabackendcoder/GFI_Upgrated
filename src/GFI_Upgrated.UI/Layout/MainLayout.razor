@inherits LayoutComponentBase
@implements IDisposable
@inject GFI_Upgrated.UI.State.AppSessionState SessionState
@inject LocalizationState LocalizationState
@inject AdminSecurityApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService

<div class="layout-wrapper layout-navbar-full layout-horizontal @(_sidebarMobileOpen ? "layout-menu-expanded" : "")">
  <div class="layout-container">
    <!-- Navbar -->
    <nav class="layout-navbar navbar navbar-expand-xl align-items-center bg-navbar-theme" id="layout-navbar">
      <div class="container-xxl">
        <div class="navbar-brand app-brand demo d-flex py-0 me-4 ms-0">
          <a href="/" class="app-brand-link">
            <span class="app-brand-logo demo">
              <img src="assets/img/branding/nuvotrace-custom-logo.png" alt="Logo" style="max-height: 32px; width: auto;" />
            </span>
            <span class="app-brand-text demo menu-text fw-bold text-heading ms-2">NUVOTRACE</span>
          </a>
          <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto d-xl-none" @onclick="ToggleMobileSidebar">
            <i class="icon-base ti tabler-x icon-sm d-flex align-items-center justify-content-center"></i>
          </a>
        </div>

        <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
          <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)" @onclick="ToggleMobileSidebar">
            <i class="icon-base ti tabler-menu-2 icon-md"></i>
          </a>
        </div>

        <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
          <ul class="navbar-nav flex-row align-items-center ms-md-auto">
            
            <!-- Style Switcher -->
            <li class="nav-item me-2 me-xl-0">
              <a class="nav-link btn btn-icon btn-text-secondary rounded-pill" href="javascript:void(0);" @onclick="ToggleTheme" aria-label="@LocalizationState.Text("Layout.Theme", "Theme")">
                <i class="icon-base icon-22px @(SessionState.IsDarkMode ? "ti tabler-moon" : "ti tabler-sun") text-heading"></i>
              </a>
            </li>
            <!-- / Style Switcher-->

            <!-- Role Switcher -->
            @if (SessionState.IsLoggedIn && _userRoles.Count > 1)
            {
              <li class="nav-item me-2 me-xl-0 d-flex align-items-center">
                <MudSelect T="long" Value="@SessionState.CurrentUser.RoleId" ValueChanged="OnRoleChangedAsync" Margin="Margin.Dense" Variant="Variant.Outlined" Style="min-width:150px;" Dense="true">
                    @foreach(var r in _userRoles)
                    {
                        <MudSelectItem Value="@r.RoleId">@r.RoleName</MudSelectItem>
                    }
                </MudSelect>
              </li>
            }
            <!--/ Role Switcher -->

            <!-- User -->
            <li class="nav-item navbar-dropdown dropdown-user dropdown">
              <a class="nav-link dropdown-toggle hide-arrow p-0" href="javascript:void(0);" data-bs-toggle="dropdown">
                <div class="avatar avatar-online">
                    <span class="avatar-initial rounded-circle bg-primary text-white">@(GetInitials())</span>
                </div>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <li>
                  <a class="dropdown-item mt-0" href="javascript:void(0);">
                    <div class="d-flex align-items-center">
                      <div class="flex-shrink-0 me-2">
                        <div class="avatar avatar-online">
                          <span class="avatar-initial rounded-circle bg-primary text-white">@(GetInitials())</span>
                        </div>
                      </div>
                      <div class="flex-grow-1">
                        <h6 class="mb-0">@(SessionState.CurrentUser?.FullName ?? LocalizationState.Text("Common.Guest", "Guest"))</h6>
                        <small class="text-body-secondary">@(SessionState.CurrentUser?.RoleName ?? LocalizationState.Text("Common.User", "User"))</small>
                      </div>
                    </div>
                  </a>
                </li>
                @if (SessionState.IsLoggedIn)
                {
                    <li>
                      <div class="dropdown-divider my-1 mx-n2"></div>
                    </li>
                    <li>
                      <div class="d-grid px-2 pt-2 pb-1">
                        <a class="btn btn-sm btn-outline-secondary d-flex mb-2" href="javascript:void(0);" @onclick="OpenChangePasswordDialog">
                          <small class="align-middle">Change Password</small>
                          <i class="icon-base ti tabler-lock ms-2 icon-14px"></i>
                        </a>
                        <a class="btn btn-sm btn-danger d-flex" href="javascript:void(0);" @onclick="Logout">
                          <small class="align-middle">@LocalizationState.Text("Layout.Logout", "Logout")</small>
                          <i class="icon-base ti tabler-logout ms-2 icon-14px"></i>
                        </a>
                      </div>
                    </li>
                }
              </ul>
            </li>
            <!--/ User -->
          </ul>
        </div>
      </div>
    </nav>
    <!-- / Navbar -->

    <!-- Layout container -->
    <div class="layout-page">
      <!-- Content wrapper -->
      <div class="content-wrapper">
        <!-- Menu -->
        <aside id="layout-menu" class="layout-menu-horizontal menu-horizontal menu bg-menu-theme flex-grow-0">
            <NavMenu />
        </aside>
        
        <!-- Content -->
        <div class="container-xxl flex-grow-1 container-p-y" id="divContentPlaceHolder">
            @Body
        </div>
      </div>
    </div>
  </div>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool _sidebarCollapsed;
    private bool _sidebarMobileOpen;
    private List<UserRoleAssignmentDto> _userRoles = new();

    private void ToggleDesktopSidebar()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
    }

    private void ToggleMobileSidebar()
    {
        _sidebarMobileOpen = !_sidebarMobileOpen;
    }

    private long SelectedLanguageId => LocalizationState.CurrentLanguageId > 0
        ? LocalizationState.CurrentLanguageId
        : SessionState.CurrentUser?.LanguageId ?? 0;

    private string GetInitials()
    {
        var name = SessionState.CurrentUser?.FullName;
        if (string.IsNullOrWhiteSpace(name))
        {
            return "GI";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 1)
        {
            return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant();
    }

    private async Task ToggleTheme()
    {
        await SessionState.ToggleThemeAsync(JSRuntime);
    }

    private Task OpenChangePasswordDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        return DialogService.ShowAsync<GFI_Upgrated.UI.Components.ChangePasswordDialog>("Change Password", options);
    }

    private async Task Logout()
    {
        await LocalizationState.ClearAsync(JSRuntime);
        await SessionState.UpdateUserAsync(JSRuntime, null);
        Navigation.NavigateTo("/login");
    }

    private async Task OnLanguageChangedAsync(long languageId)
    {
        await LocalizationState.SetLanguageAsync(SessionState, ApiClient, JSRuntime, languageId);
    }

    private void CheckAccess(string url)
    {
        if (SessionState.CurrentUser == null)
        {
            if (!url.Contains("/login", StringComparison.OrdinalIgnoreCase))
            {
                Navigation.NavigateTo("/login");
            }
            return;
        }

        var uri = new Uri(url);
        var path = uri.AbsolutePath.ToLower();

        if (path == "/" || path.Equals("/admin", StringComparison.OrdinalIgnoreCase) || path.Contains("/login", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (!SessionState.HasPermission(path, "view"))
        {
            Navigation.NavigateTo("/access-denied");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (SessionState.IsLoggedIn)
        {
            _userRoles = (await ApiClient.GetUserRolesAsync(SessionState.CurrentUser.LoginId)).ToList();
        }
    }

    private async void OnSessionStateChanged()
    {
        if (SessionState.IsLoggedIn && _userRoles.Count == 0)
        {
            _userRoles = (await ApiClient.GetUserRolesAsync(SessionState.CurrentUser.LoginId)).ToList();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRoleChangedAsync(long newRoleId)
    {
        if (newRoleId == SessionState.CurrentUser.RoleId) return;
        var refreshResult = await ApiClient.RefreshSessionAsync(SessionState.CurrentUser.LoginId, newRoleId);
        if (refreshResult != null)
        {
            await SessionState.UpdateUserAsync(JSRuntime, refreshResult);
            Navigation.NavigateTo(refreshResult.DashboardPath ?? "/admin", true);
        }
    }

    protected override void OnInitialized()
    {
        SessionState.OnChange += OnSessionStateChanged;
        SessionState.OnSessionExpired += HandleSessionExpired;
        LocalizationState.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
        CheckAccess(Navigation.Uri);
    }

    private void HandleSessionExpired()
    {
        InvokeAsync(async () =>
        {
            await Logout();
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _sidebarMobileOpen = false;
        CheckAccess(e.Location);
    }

    public void Dispose()
    {
        SessionState.OnChange -= OnSessionStateChanged;
        SessionState.OnSessionExpired -= HandleSessionExpired;
        LocalizationState.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
